{"html":"<style>\n  /* Home page: bold family, brand #1c825d */\n  .hm-root {\n    background: hsl(var(--background));\n    color: hsl(var(--foreground));\n    overflow-x: clip;\n  }\n\n  /* Top bar: name left, links, two buttons */\n  .hm-top { display: flex; align-items: center; gap: calc(24px * var(--space-scale, 1)); padding: calc(12px * var(--space-scale, 1)) 0; }\n  .hm-brand { display: inline-flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 800; font-size: 22px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; white-space: nowrap; }\n  .hm-mark { width: 34px; height: 34px; border-radius: 999px; background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); display: inline-flex; align-items: center; justify-content: center; flex: none; }\n  .hm-links { display: flex; gap: calc(24px * var(--space-scale, 1)); font-size: 15px; }\n  .hm-links a { color: hsl(var(--muted-foreground)); text-decoration: none; font-weight: 600; }\n  .hm-links a:hover { color: hsl(var(--primary-text)); }\n  .hm-top-actions { display: flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); }\n\n  /* Hero: main move, huge type against a framed product panel */\n  .hm-hero { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: calc(48px * var(--space-scale, 1)); align-items: center; padding: calc(48px * var(--space-scale, 1)) 0 calc(64px * var(--space-scale, 1)); position: relative; }\n  .hm-hero-copy { position: relative; }\n  .hm-display { font-family: var(--font-heading); font-size: clamp(44px, 7.3vw, 88px); line-height: 0.95; letter-spacing: -0.045em; margin: calc(16px * var(--space-scale, 1)) 0 0; font-weight: 800; }\n  .hm-display em { font-style: normal; color: hsl(var(--primary-text)); position: relative; }\n  .hm-intro { margin: calc(24px * var(--space-scale, 1)) 0 calc(32px * var(--space-scale, 1)); max-width: 30em; font-size: 18px; line-height: 1.6; color: hsl(var(--muted-foreground)); }\n\n  /* Hero product panel */\n  .hm-panel { position: relative; }\n  .hm-card { border-radius: calc(var(--radius) + 10px); box-shadow: var(--shadow); background: hsl(var(--card)); padding: calc(24px * var(--space-scale, 1)); border: 1px solid hsl(var(--border)); }\n  .hm-shot { border-radius: calc(var(--radius) + 2px); overflow: hidden; aspect-ratio: 4 / 3; }\n  .hm-shot .ds-img { width: 100%; height: 100%; }\n  .hm-card-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: calc(16px * var(--space-scale, 1)); margin-top: calc(16px * var(--space-scale, 1)); }\n  .hm-price { font-family: var(--font-heading); font-size: 34px; letter-spacing: -0.03em; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }\n\n  /* Band: strong colour, the promise and the midpoint Sign up */\n  .hm-band { background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); border-radius: 0; }\n  .hm-band-inner { padding: calc(48px * var(--space-scale, 1)) 0; }\n  .hm-band-grid { display: grid; grid-template-columns: auto 1fr auto; gap: calc(32px * var(--space-scale, 1)); align-items: center; }\n  .hm-band .ds-eyebrow { color: hsl(var(--primary-foreground) / 0.75); }\n  .hm-band h2 { color: hsl(var(--primary-foreground)); }\n  .hm-band .ds-muted { color: hsl(var(--primary-foreground) / 0.82); }\n  .hm-band .hm-badge { display: flex; flex-direction: column; justify-content: center; align-items: center; width: 132px; height: 132px; border-radius: 999px; background: hsl(var(--primary-foreground) / 0.12); border: 1.5px dashed hsl(var(--primary-foreground) / 0.4); flex: none; }\n  .hm-band .hm-badge b { font-family: var(--font-heading); font-size: 40px; letter-spacing: -0.04em; line-height: 1; }\n  .hm-band .hm-badge small { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.8; margin-top: 6px; }\n  .hm-band .ds-btn-solid-white { background: hsl(var(--primary-foreground)); color: hsl(var(--primary-text)); border: 1.5px solid hsl(var(--primary-foreground)); }\n  .hm-band .ds-btn-solid-white:hover { background: transparent; color: hsl(var(--primary-foreground)); }\n\n  /* What shoppers can do */\n  .hm-tasks { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: calc(32px * var(--space-scale, 1)); padding: calc(48px * var(--space-scale, 1)) 0; align-items: start; }\n  .hm-task { display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1)); }\n  .hm-task .hm-num { font-family: var(--font-heading); font-size: 13px; font-weight: 800; letter-spacing: 0.1em; color: hsl(var(--primary-text)); padding-top: calc(4px * var(--space-scale, 1)); }\n  .hm-task h3 { margin: 0; }\n  .hm-task p { margin: 0; font-size: 15px; line-height: 1.55; color: hsl(var(--muted-foreground)); }\n\n  /* Closing call */\n  .hm-close { padding: calc(16px * var(--space-scale, 1)) 0 calc(64px * var(--space-scale, 1)); }\n  .hm-close-inner { background: hsl(var(--main-50)); border-radius: calc(var(--radius) + 10px); padding: calc(48px * var(--space-scale, 1)); display: grid; grid-template-columns: 1fr auto; gap: calc(32px * var(--space-scale, 1)); align-items: center; position: relative; overflow: hidden; }\n  .dark .hm-close-inner { background: hsl(var(--main-950) / 0.35); }\n  .hm-close h2 { max-width: 20em; margin: calc(8px * var(--space-scale, 1)) 0 0; }\n  .hm-deco-ring { position: absolute; right: -60px; bottom: -80px; width: 260px; height: 260px; border-radius: 999px; border: 22px solid hsl(var(--primary) / 0.18); pointer-events: none; }\n  .hm-deco-ring2 { position: absolute; right: 60px; top: -50px; width: 120px; height: 120px; border-radius: 999px; background: hsl(var(--accent) / 0.35); pointer-events: none; }\n\n  /* Footer part already carries contact; keep it clean */\n  .hm-fineprint { padding: calc(24px * var(--space-scale, 1)) 0; font-size: 13px; color: hsl(var(--muted-foreground)); }\n\n  @media (max-width: 900px) {\n    .hm-hero { grid-template-columns: 1fr; gap: calc(32px * var(--space-scale, 1)); padding-top: calc(24px * var(--space-scale, 1)); }\n    .hm-links { display: none; }\n    .hm-band-grid { grid-template-columns: 1fr; gap: calc(24px * var(--space-scale, 1)); }\n    .hm-band .hm-badge { width: 100%; height: auto; border-radius: calc(var(--radius) + 4px); flex-direction: row; gap: calc(12px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)); justify-content: flex-start; }\n    .hm-band .hm-badge b { font-size: 32px; }\n    .hm-band .hm-badge small { margin-top: 0; }\n    .hm-tasks { grid-template-columns: 1fr; gap: calc(24px * var(--space-scale, 1)); }\n    .hm-close-inner { grid-template-columns: 1fr; padding: calc(32px * var(--space-scale, 1)) calc(24px * var(--space-scale, 1)); }\n  }\n  @media (max-width: 520px) {\n    .hm-top { gap: calc(8px * var(--space-scale, 1)); justify-content: space-between; }\n    .hm-brand { font-size: 20px; }\n    .hm-top-actions .hm-signin { display: none; }\n    .hm-display { font-size: clamp(40px, 12vw, 60px); }\n  }\n</style><main data-screen=\"home\" class=\"hm-root\" data-eid=\"e1\">\n  <div data-part=\"header\" data-eid=\"e2\"></div>\n\n  <div class=\"ds-page\" data-eid=\"e3\">\n    <section class=\"hm-hero\" data-eid=\"e4\">\n      <div class=\"hm-hero-copy\" data-eid=\"e5\">\n        <span class=\"ds-eyebrow\" data-sample=\"PageWording#home.intro\" data-eid=\"e6\">Everyday things, made well</span>\n        <h1 class=\"hm-display\" data-sample=\"PageWording#home.heading\" data-eid=\"e7\">Good things,<br>at honest prices.</h1>\n        <p class=\"hm-intro\" data-sample=\"PageWording#home.intro\" data-eid=\"e8\">Donkey sells useful things for home and kitchen: simple, sturdy, and priced so you don't have to think twice.</p>\n        <div class=\"ds-row\" data-eid=\"e9\">\n          <a class=\"ds-btn ds-btn-lg\" data-goto=\"products\" data-eid=\"e10\">See the products</a>\n          <a class=\"ds-btn ds-btn-secondary ds-btn-lg\" data-goto=\"how-it-works\" data-eid=\"e11\">How it works</a>\n        </div>\n      </div>\n      <div class=\"hm-panel\" data-eid=\"e12\">\n        <div class=\"hm-card\" data-eid=\"e13\">\n          <div class=\"hm-shot\" data-eid=\"e14\"><div class=\"ds-img\" data-sample=\"\" data-eid=\"e15\"></div></div>\n          <div class=\"hm-card-foot\" data-eid=\"e16\">\n            <div data-eid=\"e17\">\n              <span class=\"ds-label-caps\" data-eid=\"e18\">The enamel pot</span>\n              <div class=\"ds-muted\" style=\"font-size: 14px; margin-top: 4px\" data-eid=\"e19\">Holds four litres. Works on every hob.</div>\n            </div>\n            <div class=\"hm-price\" data-sample=\"Product#1.pricePence\" data-eid=\"e20\">£38.00</div>\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <section class=\"ds-band hm-band\" data-eid=\"e21\">\n    <div class=\"ds-page hm-band-inner\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e22\">\n      <div class=\"hm-band-grid\" data-eid=\"e23\">\n        <div class=\"hm-badge\" data-eid=\"e24\"><b data-sample=\"\">£</b><small data-eid=\"e25\">pounds</small></div>\n        <div data-eid=\"e26\">\n          <span class=\"ds-eyebrow\" data-eid=\"e27\">What shoppers do here</span>\n          <h2 class=\"ds-h2\" style=\"margin-top: 8px\" data-eid=\"e28\">Browse the shelf, then step into the shop.</h2>\n          <p class=\"ds-muted\" style=\"margin-top: 10px; max-width: 34em\" data-eid=\"e29\">See every product and its price in pounds, the bare price only. When one catches your eye, sign up and buy it in Donkey app.</p>\n        </div>\n        <div data-eid=\"e30\">\n          <a class=\"ds-btn ds-btn-lg ds-btn-solid-white\" data-goto=\"products\" data-eid=\"e31\">Sign up</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"ds-page\" data-eid=\"e32\">\n    <section class=\"hm-tasks\" data-eid=\"e33\">\n      <div class=\"hm-task\" data-eid=\"e34\">\n        <span class=\"hm-num\" data-eid=\"e35\">01</span>\n        <h3 class=\"ds-h3\" data-eid=\"e36\">Look around</h3>\n        <p data-eid=\"e37\">Every product the team keeps on the shelf, with a short description and its price.</p>\n      </div>\n      <div class=\"hm-task\" data-eid=\"e38\">\n        <span class=\"hm-num\" data-eid=\"e39\">02</span>\n        <h3 class=\"ds-h3\" data-eid=\"e40\">Know the score</h3>\n        <p data-eid=\"e41\">Read the delivery and returns details before you commit to anything.</p>\n      </div>\n      <div class=\"hm-task\" data-eid=\"e42\">\n        <span class=\"hm-num\" data-eid=\"e43\">03</span>\n        <h3 class=\"ds-h3\" data-eid=\"e44\">Sign up and buy</h3>\n        <p data-eid=\"e45\">The Sign up button opens Donkey app, where the buying happens.</p>\n      </div>\n    </section>\n  </div>\n\n  <div class=\"ds-page hm-close\" data-eid=\"e46\">\n    <div class=\"hm-close-inner\" data-eid=\"e47\">\n      <div data-eid=\"e48\">\n        <span class=\"ds-eyebrow\" data-eid=\"e49\">Ready when you are</span>\n        <h2 class=\"ds-h1\" data-eid=\"e50\">Take the shop with you.</h2>\n        <p class=\"ds-muted\" style=\"margin-top: 12px; max-width: 32em\" data-eid=\"e51\">Sign up once and every product and price is a tap away.</p>\n      </div>\n      <div data-eid=\"e52\">\n        <a class=\"ds-btn ds-btn-lg\" data-goto=\"products\" data-eid=\"e53\">Sign up</a>\n      </div>\n    </div>\n  </div>\n\n  <div data-part=\"footer\" data-eid=\"e54\"></div>\n</main>","changes":[{"fix":"main-text","what":"the rule for \".hm-band .ds-btn-solid-white\": words in the main colour take --primary-text"}]}