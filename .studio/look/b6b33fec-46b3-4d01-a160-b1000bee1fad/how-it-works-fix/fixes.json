{"html":"<style>\n  .hiw-top { display: flex; align-items: center; gap: calc(16px * var(--space-scale, 1)); padding: calc(12px * var(--space-scale, 1)) 0; }\n  .hiw-brand { display: inline-flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 800; font-size: 20px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; }\n  .hiw-mark { width: 32px; height: 32px; border-radius: var(--radius); background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); display: inline-flex; align-items: center; justify-content: center; }\n  .hiw-mark svg { width: 20px; height: 20px; }\n  .hiw-links { display: flex; gap: calc(24px * var(--space-scale, 1)); font-size: 15px; }\n  .hiw-links a { color: hsl(var(--muted-foreground)); text-decoration: none; padding: calc(8px * var(--space-scale, 1)) 0; }\n  .hiw-links a:hover { color: hsl(var(--foreground)); }\n  .hiw-links a.is-here { color: hsl(var(--foreground)); font-weight: 600; }\n\n  .hiw-hero { position: relative; padding: calc(48px * var(--space-scale, 1)) 0 calc(32px * var(--space-scale, 1)); }\n  .hiw-hero h1 { margin: calc(12px * var(--space-scale, 1)) 0 0; max-width: 15em; }\n  .hiw-hero h1 em { font-style: normal; color: hsl(var(--primary-text)); }\n  .hiw-lead { margin: calc(20px * var(--space-scale, 1)) 0 0; max-width: 34em; font-size: 18px; line-height: 1.6; color: hsl(var(--muted-foreground)); }\n\n  .hiw-steps { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(24px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) 0 calc(64px * var(--space-scale, 1)); counter-reset: step; }\n  .hiw-step { position: relative; border-radius: calc(var(--card-radius) * 1.5); background: hsl(var(--card)); border: 1px solid hsl(var(--border)); box-shadow: var(--shadow); padding: calc(24px * var(--space-scale, 1)); display: flex; flex-direction: column; gap: calc(12px * var(--space-scale, 1)); overflow: hidden; }\n  .hiw-step::before { counter-increment: step; content: \"0\" counter(step); font-family: var(--font-heading); font-weight: 800; font-size: 44px; line-height: 1; letter-spacing: -0.04em; color: hsl(var(--primary-text)); }\n  .hiw-step h2 { margin: 0; font-family: var(--font-heading); font-size: 22px; letter-spacing: -0.02em; }\n  .hiw-step p { margin: 0; font-size: 15px; line-height: 1.55; color: hsl(var(--muted-foreground)); }\n  .hiw-step-icon { width: 40px; height: 40px; border-radius: 999px; background: hsl(var(--primary) / 0.14); color: hsl(var(--primary-text)); display: inline-flex; align-items: center; justify-content: center; }\n  .hiw-step-icon svg { width: 20px; height: 20px; }\n  .hiw-shape { width: 220px; height: 220px; right: -70px; bottom: -100px; opacity: 0.5; color: hsl(var(--primary) / 0.18); }\n\n  .hiw-band { position: relative; padding: calc(48px * var(--space-scale, 1)) 0; }\n  .hiw-band .ds-page { padding-top: 0; padding-bottom: 0; }\n  .hiw-cols { display: grid; grid-template-columns: 1fr 1fr; gap: calc(32px * var(--space-scale, 1)); }\n  .hiw-col { border-radius: calc(var(--card-radius) * 1.5); background: hsl(var(--card)); border: 1px solid hsl(var(--border)); box-shadow: var(--shadow); padding: calc(24px * var(--space-scale, 1)); }\n  .hiw-col-head { display: flex; align-items: center; gap: calc(12px * var(--space-scale, 1)); margin-bottom: calc(16px * var(--space-scale, 1)); }\n  .hiw-col-icon { width: 44px; height: 44px; border-radius: var(--radius); background: hsl(var(--primary) / 0.14); color: hsl(var(--primary-text)); display: inline-flex; align-items: center; justify-content: center; flex: none; }\n  .hiw-col-icon svg { width: 22px; height: 22px; }\n  .hiw-col h2 { margin: 0; font-family: var(--font-heading); font-size: 24px; letter-spacing: -0.02em; }\n  .hiw-col p { margin: 0; font-size: 15px; line-height: 1.65; color: hsl(var(--foreground)); white-space: pre-line; }\n  .hiw-col p.is-empty { color: hsl(var(--muted-foreground)); font-style: italic; }\n\n  .hiw-close { position: relative; padding: calc(32px * var(--space-scale, 1)) 0 calc(48px * var(--space-scale, 1)); }\n  .hiw-close-inner { position: relative; overflow: hidden; border-radius: calc(var(--card-radius) * 1.75); padding: calc(40px * var(--space-scale, 1)); background: hsl(var(--band)); color: hsl(var(--band-foreground)); display: flex; flex-wrap: wrap; align-items: center; gap: calc(24px * var(--space-scale, 1)); }\n  .hiw-close-text { flex: 1 1 260px; }\n  .hiw-close .ds-label-caps { color: hsl(var(--band-foreground) / 0.8); }\n  .hiw-close h2 { margin: calc(8px * var(--space-scale, 1)) 0 0; font-family: var(--font-heading); font-size: clamp(28px, 4vw, 40px); letter-spacing: -0.03em; line-height: 1.05; color: hsl(var(--band-foreground)); }\n  .hiw-close p { margin: calc(12px * var(--space-scale, 1)) 0 0; max-width: 30em; font-size: 15px; line-height: 1.6; color: hsl(var(--band-foreground) / 0.85); }\n  .hiw-close .ds-btn { background: hsl(var(--band-foreground)); color: hsl(var(--band)); }\n  .hiw-close-shape { width: 260px; height: 260px; right: -80px; top: -90px; color: hsl(var(--band-foreground) / 0.14); }\n\n  @media (max-width: 860px) {\n    .hiw-links { display: none; }\n    .hiw-steps { grid-template-columns: 1fr; gap: calc(16px * var(--space-scale, 1)); }\n    .hiw-cols { grid-template-columns: 1fr; }\n    .hiw-step::before { font-size: 36px; }\n  }\n</style><main data-screen=\"how-it-works\" data-eid=\"e1\">\n  <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e2\">\n    <header class=\"hiw-top\" data-eid=\"e3\">\n      <a class=\"hiw-brand\" data-goto=\"home\" data-eid=\"e4\">\n        <span class=\"hiw-mark\" aria-hidden=\"true\" data-eid=\"e5\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M7 15a5 5 0 1 1 0-6\"></path><path d=\"M7 9v6\"></path><path d=\"M17 9a5 5 0 0 1 0 6\"></path><path d=\"M17 9v6\"></path></svg>\n        </span>\n        Donkey\n      </a>\n      <nav class=\"hiw-links ds-only-wide\" aria-label=\"Site\" data-eid=\"e6\">\n        <a data-goto=\"home\" data-eid=\"e7\">Home</a>\n        <a data-goto=\"how-it-works\" class=\"is-here\" aria-current=\"page\" data-eid=\"e8\">How it works</a>\n        <a data-goto=\"about\" data-eid=\"e9\">About</a>\n        <a href=\"#\" data-goto=\"contact\" data-eid=\"e10\">Contact</a>\n      </nav>\n      <span class=\"ds-spacer\" data-eid=\"e11\"></span>\n      <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e12\">\n        <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e13\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n        <button aria-label=\"Dark\" data-eid=\"e14\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n        <button aria-label=\"Auto\" data-eid=\"e15\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n      </div>\n      <a class=\"ds-btn ds-btn-sm ds-only-wide\" href=\"#\" data-eid=\"e16\">Sign up</a>\n      <details class=\"ds-menu ds-only-narrow\">\n        <summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary>\n        <div class=\"ds-menu-list\" data-eid=\"e17\">\n          <a data-goto=\"home\" data-eid=\"e18\">Home</a>\n          <a data-goto=\"how-it-works\" data-eid=\"e19\">How it works</a>\n          <a data-goto=\"about\" data-eid=\"e20\">About</a>\n          <a data-goto=\"contact\" data-eid=\"e21\">Contact</a>\n          <a href=\"#\" data-eid=\"e22\">Sign up</a>\n          <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e23\">\n            <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e24\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n            <button aria-label=\"Dark\" data-eid=\"e25\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n            <button aria-label=\"Auto\" data-eid=\"e26\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n          </div>\n        </div>\n      </details>\n    </header>\n\n    <section class=\"hiw-hero\" data-eid=\"e27\">\n      <span class=\"ds-eyebrow\" data-eid=\"e28\">How it works</span>\n      <h1 class=\"ds-display\" data-eid=\"e29\">From <em data-eid=\"e30\">picked</em> to <em data-eid=\"e31\">delivered</em>, in three steps.</h1>\n      <p class=\"hiw-lead\" data-sample=\"PageWording#how-it-works.intro\" data-eid=\"e32\">Here is the whole of it: choose what you want, pay for it in the shop, and we send it to your door. Delivery and returns details sit further down the page.</p>\n    </section>\n\n    <section class=\"hiw-steps\" aria-label=\"Three steps\" data-eid=\"e33\">\n      <div class=\"hiw-step\" data-eid=\"e34\">\n        <span class=\"hiw-step-icon\" aria-hidden=\"true\" data-eid=\"e35\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16l-1.5 12h-13L4 7Z\"></path><path d=\"M8.5 7a3.5 3.5 0 0 1 7 0\"></path></svg></span>\n        <h2 data-eid=\"e36\">Pick what you want</h2>\n        <p data-eid=\"e37\">Look through the products and prices on the site, then sign up to open the shop.</p>\n      </div>\n      <div class=\"hiw-step\" data-eid=\"e38\">\n        <span class=\"hiw-step-icon\" aria-hidden=\"true\" data-eid=\"e39\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><rect x=\"2.5\" y=\"5.5\" width=\"19\" height=\"13\" rx=\"2.5\"></rect><path d=\"M2.5 10h19\"></path><path d=\"M6.5 14.5h3\"></path></svg></span>\n        <h2 data-eid=\"e40\">Pay at the checkout</h2>\n        <p data-eid=\"e41\">Prices are in pounds. Pay in the shop and you are done; no steps you don't need.</p>\n      </div>\n      <div class=\"hiw-step\" data-eid=\"e42\">\n        <span class=\"hiw-step-icon\" aria-hidden=\"true\" data-eid=\"e43\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M2.5 7.5h11v9h-11z\"></path><path d=\"M13.5 11h4l3 3v2.5h-7z\"></path><circle cx=\"6.5\" cy=\"18.5\" r=\"1.75\"></circle><circle cx=\"17\" cy=\"18.5\" r=\"1.75\"></circle></svg></span>\n        <h2 data-eid=\"e44\">Get it delivered</h2>\n        <p data-eid=\"e45\">We pack it, post it, and it turns up at your door. The times are under Delivery.</p>\n      </div>\n    </section>\n  </div>\n\n  <section class=\"ds-band hiw-band\" data-eid=\"e46\">\n    <div class=\"ds-page\" data-eid=\"e47\">\n      <div class=\"hiw-cols\" data-eid=\"e48\">\n        <div class=\"hiw-col\" data-eid=\"e49\">\n          <div class=\"hiw-col-head\" data-eid=\"e50\">\n            <span class=\"hiw-col-icon\" aria-hidden=\"true\" data-eid=\"e51\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M2.5 7.5h11v9h-11z\"></path><path d=\"M13.5 11h4l3 3v2.5h-7z\"></path><circle cx=\"6.5\" cy=\"18.5\" r=\"1.75\"></circle><circle cx=\"17\" cy=\"18.5\" r=\"1.75\"></circle></svg></span>\n            <h2 data-eid=\"e52\">Delivery</h2>\n          </div>\n          <p data-sample=\"PageWording#how-it-works.deliveryText\" data-eid=\"e53\">Orders arrive in 3 to 5 days. We post to mainland UK addresses with a tracked service, and you will get the tracking number by email the day your parcel leaves us. Postage is £3.95 on orders under £30, and free above that.</p>\n        </div>\n        <div class=\"hiw-col\" data-eid=\"e54\">\n          <div class=\"hiw-col-head\" data-eid=\"e55\">\n            <span class=\"hiw-col-icon\" aria-hidden=\"true\" data-eid=\"e56\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 12a9 9 0 1 0 3-6.7\"></path><path d=\"M3 4.5V9h4.5\"></path></svg></span>\n            <h2 data-eid=\"e57\">Returns</h2>\n          </div>\n          <p data-sample=\"PageWording#how-it-works.returnsText\" data-eid=\"e58\">Changed your mind? Send anything back within 30 days, as long as it is unused and still in its packaging. Email us with your order number and we will send a returns label. Refunds go back to the card you paid with within 5 working days of the parcel reaching us.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e59\">\n    <section class=\"hiw-close\" data-eid=\"e60\">\n      <div class=\"hiw-close-inner\" data-eid=\"e61\">\n        <svg class=\"ds-deco hiw-close-shape\" viewBox=\"0 0 200 200\" aria-hidden=\"true\"><circle cx=\"100\" cy=\"100\" r=\"92\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"></circle><circle cx=\"100\" cy=\"100\" r=\"64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"></circle><circle cx=\"100\" cy=\"100\" r=\"34\" fill=\"currentColor\"></circle></svg>\n        <div class=\"hiw-close-text\" data-eid=\"e62\">\n          <span class=\"ds-label-caps\" data-eid=\"e63\">Ready when you are</span>\n          <h2 data-eid=\"e64\">Now you know how it works.</h2>\n          <p data-eid=\"e65\">Sign up once and the shop opens for you. Browse the products first if you would rather see the prices.</p>\n        </div>\n        <div class=\"ds-row\" data-eid=\"e66\">\n          <a class=\"ds-btn ds-btn-lg\" href=\"#\" data-eid=\"e67\">Sign up</a>\n          <a class=\"ds-btn ds-btn-secondary ds-btn-lg\" data-goto=\"products\" style=\"border-color: hsl(var(--band-foreground)); color: hsl(var(--band-foreground)); background: transparent\" data-eid=\"e68\">See the products</a>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <div data-part=\"footer\" data-eid=\"e69\"></div>\n\n  <section data-state=\"empty\" hidden=\"\" data-eid=\"e70\">\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e71\">\n      <header class=\"hiw-top\" data-eid=\"e72\">\n        <a class=\"hiw-brand\" data-goto=\"home\" data-eid=\"e73\">\n          <span class=\"hiw-mark\" aria-hidden=\"true\" data-eid=\"e74\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M7 15a5 5 0 1 1 0-6\"></path><path d=\"M7 9v6\"></path><path d=\"M17 9a5 5 0 0 1 0 6\"></path><path d=\"M17 9v6\"></path></svg>\n          </span>\n          Donkey\n        </a>\n        <nav class=\"hiw-links ds-only-wide\" aria-label=\"Site\" data-eid=\"e75\">\n          <a data-goto=\"home\" data-eid=\"e76\">Home</a>\n          <a data-goto=\"how-it-works\" class=\"is-here\" aria-current=\"page\" data-eid=\"e77\">How it works</a>\n          <a data-goto=\"about\" data-eid=\"e78\">About</a>\n          <a data-goto=\"contact\" data-eid=\"e79\">Contact</a>\n        </nav>\n        <span class=\"ds-spacer\" data-eid=\"e80\"></span>\n        <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e81\">\n          <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e82\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n          <button aria-label=\"Dark\" data-eid=\"e83\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n          <button aria-label=\"Auto\" data-eid=\"e84\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n        </div>\n        <a class=\"ds-btn ds-btn-sm ds-only-wide\" href=\"#\" data-eid=\"e85\">Sign up</a>\n        <details class=\"ds-menu ds-only-narrow\">\n          <summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary>\n          <div class=\"ds-menu-list\" data-eid=\"e86\">\n            <a data-goto=\"home\" data-eid=\"e87\">Home</a>\n            <a data-goto=\"how-it-works\" data-eid=\"e88\">How it works</a>\n            <a data-goto=\"about\" data-eid=\"e89\">About</a>\n            <a data-goto=\"contact\" data-eid=\"e90\">Contact</a>\n            <a href=\"#\" data-eid=\"e91\">Sign up</a>\n            <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e92\">\n              <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e93\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n              <button aria-label=\"Dark\" data-eid=\"e94\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n              <button aria-label=\"Auto\" data-eid=\"e95\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n            </div>\n          </div>\n        </details>\n      </header>\n\n      <section class=\"hiw-hero\" data-eid=\"e96\">\n        <span class=\"ds-eyebrow\" data-eid=\"e97\">How it works</span>\n        <h1 class=\"ds-display\" data-eid=\"e98\">From <em data-eid=\"e99\">picked</em> to <em data-eid=\"e100\">delivered</em>, in three steps.</h1>\n        <p class=\"hiw-lead\" data-eid=\"e101\">Here is the whole of it: choose what you want, pay for it in the shop, and we send it to your door. Delivery and returns details sit further down the page.</p>\n      </section>\n\n      <section class=\"hiw-steps\" aria-label=\"Three steps\" data-eid=\"e102\">\n        <div class=\"hiw-step\" data-eid=\"e103\">\n          <span class=\"hiw-step-icon\" aria-hidden=\"true\" data-eid=\"e104\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16l-1.5 12h-13L4 7Z\"></path><path d=\"M8.5 7a3.5 3.5 0 0 1 7 0\"></path></svg></span>\n          <h2 data-eid=\"e105\">Pick what you want</h2>\n          <p data-eid=\"e106\">Look through the products and prices on the site, then sign up to open the shop.</p>\n        </div>\n        <div class=\"hiw-step\" data-eid=\"e107\">\n          <span class=\"hiw-step-icon\" aria-hidden=\"true\" data-eid=\"e108\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><rect x=\"2.5\" y=\"5.5\" width=\"19\" height=\"13\" rx=\"2.5\"></rect><path d=\"M2.5 10h19\"></path><path d=\"M6.5 14.5h3\"></path></svg></span>\n          <h2 data-eid=\"e109\">Pay at the checkout</h2>\n          <p data-eid=\"e110\">Prices are in pounds. Pay in the shop and you are done; no steps you don't need.</p>\n        </div>\n        <div class=\"hiw-step\" data-eid=\"e111\">\n          <span class=\"hiw-step-icon\" aria-hidden=\"true\" data-eid=\"e112\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M2.5 7.5h11v9h-11z\"></path><path d=\"M13.5 11h4l3 3v2.5h-7z\"></path><circle cx=\"6.5\" cy=\"18.5\" r=\"1.75\"></circle><circle cx=\"17\" cy=\"18.5\" r=\"1.75\"></circle></svg></span>\n          <h2 data-eid=\"e113\">Get it delivered</h2>\n          <p data-eid=\"e114\">We pack it, post it, and it turns up at your door. The times are under Delivery.</p>\n        </div>\n      </section>\n    </div>\n\n    <section class=\"ds-band hiw-band\" data-eid=\"e115\">\n      <div class=\"ds-page\" data-eid=\"e116\">\n        <div class=\"hiw-cols\" data-eid=\"e117\">\n          <div class=\"hiw-col\" data-eid=\"e118\">\n            <div class=\"hiw-col-head\" data-eid=\"e119\">\n              <span class=\"hiw-col-icon\" aria-hidden=\"true\" data-eid=\"e120\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M2.5 7.5h11v9h-11z\"></path><path d=\"M13.5 11h4l3 3v2.5h-7z\"></path><circle cx=\"6.5\" cy=\"18.5\" r=\"1.75\"></circle><circle cx=\"17\" cy=\"18.5\" r=\"1.75\"></circle></svg></span>\n              <h2 data-eid=\"e121\">Delivery</h2>\n            </div>\n            <p class=\"is-empty\" data-eid=\"e122\">We'll add our delivery details here soon.</p>\n          </div>\n          <div class=\"hiw-col\" data-eid=\"e123\">\n            <div class=\"hiw-col-head\" data-eid=\"e124\">\n              <span class=\"hiw-col-icon\" aria-hidden=\"true\" data-eid=\"e125\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 12a9 9 0 1 0 3-6.7\"></path><path d=\"M3 4.5V9h4.5\"></path></svg></span>\n              <h2 data-eid=\"e126\">Returns</h2>\n            </div>\n            <p class=\"is-empty\" data-eid=\"e127\">We'll add our returns details here soon.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e128\">\n      <section class=\"hiw-close\" data-eid=\"e129\">\n        <div class=\"hiw-close-inner\" data-eid=\"e130\">\n          <svg class=\"ds-deco hiw-close-shape\" viewBox=\"0 0 200 200\" aria-hidden=\"true\"><circle cx=\"100\" cy=\"100\" r=\"92\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"></circle><circle cx=\"100\" cy=\"100\" r=\"64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"></circle><circle cx=\"100\" cy=\"100\" r=\"34\" fill=\"currentColor\"></circle></svg>\n          <div class=\"hiw-close-text\" data-eid=\"e131\">\n            <span class=\"ds-label-caps\" data-eid=\"e132\">Ready when you are</span>\n            <h2 data-eid=\"e133\">Now you know how it works.</h2>\n            <p data-eid=\"e134\">Sign up once and the shop opens for you. Browse the products first if you would rather see the prices.</p>\n          </div>\n          <div class=\"ds-row\" data-eid=\"e135\">\n            <a class=\"ds-btn ds-btn-lg\" href=\"#\" data-eid=\"e136\">Sign up</a>\n            <a class=\"ds-btn ds-btn-secondary ds-btn-lg\" data-goto=\"products\" style=\"border-color: hsl(var(--band-foreground)); color: hsl(var(--band-foreground)); background: transparent\" data-eid=\"e137\">See the products</a>\n          </div>\n        </div>\n      </section>\n    </div>\n\n    <div data-part=\"footer\" data-eid=\"e138\"></div>\n  </section>\n</main>","changes":[]}