{"html":"<style>\n  .ed-head { display: flex; align-items: flex-end; justify-content: space-between; gap: calc(16px * var(--space-scale, 1)); flex-wrap: wrap; }\n  .ed-figures { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(16px * var(--space-scale, 1)); margin-top: calc(24px * var(--space-scale, 1)); }\n  .ed-figure { padding: calc(20px * var(--space-scale, 1)); border-radius: var(--card-radius); background: hsl(var(--card)); box-shadow: var(--shadow); border: 1px solid hsl(var(--border)); }\n  .ed-figure.is-lead { background: hsl(var(--band)); color: hsl(var(--band-foreground)); border-color: transparent; }\n  .ed-figure.is-lead .ds-stat-label { color: hsl(var(--band-foreground) / 0.75); }\n  .ed-figure .ds-stat-value { font-family: var(--font-heading); font-size: clamp(32px, 5vw, 48px); letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; margin-top: calc(8px * var(--space-scale, 1)); display: block; }\n  .ed-figure .ds-stat-label { margin: 0; }\n  .ed-figure-note { margin-top: calc(8px * var(--space-scale, 1)); font-size: 13px; color: hsl(var(--muted-foreground)); }\n  .ed-figure.is-lead .ed-figure-note { color: hsl(var(--band-foreground) / 0.75); }\n\n  .ed-split { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: calc(32px * var(--space-scale, 1)); margin-top: calc(32px * var(--space-scale, 1)); align-items: start; }\n\n  .ed-table-card-head { display: flex; align-items: center; gap: calc(12px * var(--space-scale, 1)); flex-wrap: wrap; }\n  .ed-prod-name { display: flex; align-items: center; gap: calc(12px * var(--space-scale, 1)); min-width: 0; }\n  .ed-thumb { width: 44px; height: 44px; border-radius: calc(var(--radius) - 4px); flex: none; }\n  .ed-prod-name b { display: block; font-weight: 600; }\n  .ed-prod-name small { display: block; color: hsl(var(--muted-foreground)); font-size: 13px; }\n  .ed-price { font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; font-weight: 600; }\n  .ed-visible { display: flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); }\n  .ed-visible-label { font-size: 13px; white-space: nowrap; color: hsl(var(--muted-foreground)); }\n  .ed-order { font-variant-numeric: tabular-nums; color: hsl(var(--muted-foreground)); white-space: nowrap; text-align: right; }\n  .ed-card-pad { padding: calc(24px * var(--space-scale, 1)); }\n  .ed-card-title { font-family: var(--font-heading); font-size: 20px; letter-spacing: -0.02em; margin: 0; }\n  .ed-pages { list-style: none; margin: calc(16px * var(--space-scale, 1)) 0 0; padding: 0; display: grid; gap: calc(4px * var(--space-scale, 1)); }\n  .ed-page-link { display: flex; align-items: center; gap: calc(12px * var(--space-scale, 1)); padding: calc(12px * var(--space-scale, 1)); border-radius: var(--radius-button); text-decoration: none; color: hsl(var(--foreground)); min-height: 48px; }\n  .ed-page-link:hover { background: hsl(var(--primary) / 0.08); }\n  .ed-page-link svg { flex: none; color: hsl(var(--primary-text)); }\n  .ed-page-link span { flex: 1; min-width: 0; }\n  .ed-page-link small { display: block; color: hsl(var(--muted-foreground)); font-size: 13px; }\n  .ed-page-link .ed-chev { color: hsl(var(--muted-foreground)); }\n\n  .ed-quick { margin-top: calc(24px * var(--space-scale, 1)); }\n  .ed-quick .ds-form-row { margin-top: calc(12px * var(--space-scale, 1)); }\n  .ed-note { margin-top: calc(16px * var(--space-scale, 1)); display: flex; gap: calc(10px * var(--space-scale, 1)); align-items: flex-start; color: hsl(var(--muted-foreground)); font-size: 14px; }\n\n  @media (max-width: 960px) {\n    .ed-split { grid-template-columns: minmax(0, 1fr); }\n    .ed-figures { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  }\n  @media (max-width: 640px) {\n    .ed-figures { grid-template-columns: minmax(0, 1fr); }\n  }\n</style><main data-screen=\"editor\" data-eid=\"e1\">\n  <div data-part=\"header\" data-eid=\"e2\"></div>\n  <div data-eid=\"content\">\n\n    <div class=\"ds-page\" style=\"padding-top: calc(32px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1))\" data-eid=\"e3\">\n\n      <div class=\"ds-page-head\" data-eid=\"e4\">\n        <div data-eid=\"e5\">\n          <span class=\"ds-eyebrow\" data-eid=\"e6\">Editors' area</span>\n          <h1 class=\"ds-h1\" style=\"margin-top: calc(8px * var(--space-scale, 1))\" data-eid=\"e7\">Products</h1>\n          <p class=\"ds-muted\" style=\"margin-top: calc(8px * var(--space-scale, 1)); max-width: 46ch\" data-eid=\"e8\">\n            Every product on the site, with its price and whether shoppers can see it.\n          </p>\n        </div>\n        <div class=\"ds-actions\" data-eid=\"e9\">\n          <a class=\"ds-btn ds-btn-secondary\" data-goto=\"products\" data-eid=\"e10\">See the products page</a>\n          <button class=\"ds-btn\" data-goto=\"editor\" data-eid=\"e11\">Add product</button>\n        </div>\n      </div>\n\n      <div class=\"ed-figures\" data-eid=\"e12\">\n        <div class=\"ed-figure is-lead\" data-eid=\"e13\">\n          <p class=\"ds-stat-label\" style=\"margin: 0\" data-eid=\"e14\">Products on the site</p>\n          <span class=\"ds-stat-value\" data-sample=\"\" data-eid=\"e15\">6</span>\n          <p class=\"ed-figure-note\" data-eid=\"e16\">Shoppers see these now</p>\n        </div>\n        <div class=\"ed-figure\" data-eid=\"e17\">\n          <p class=\"ds-stat-label\" style=\"margin: 0\" data-eid=\"e18\">Hidden from shoppers</p>\n          <span class=\"ds-stat-value\" data-sample=\"\" data-eid=\"e19\">1</span>\n          <p class=\"ed-figure-note\" data-eid=\"e20\">Switch one on to show it</p>\n        </div>\n        <div class=\"ed-figure\" data-eid=\"e21\">\n          <p class=\"ds-stat-label\" style=\"margin: 0\" data-eid=\"e22\">Form entries</p>\n          <span class=\"ds-stat-value\" data-sample=\"\" data-eid=\"e23\">3</span>\n          <p class=\"ed-figure-note\" data-eid=\"e24\">Messages sent through the site</p>\n        </div>\n      </div>\n\n      <div class=\"ed-split\" data-eid=\"e25\">\n\n        <div class=\"ds-table-card\" data-eid=\"e26\">\n          <div class=\"ed-table-card-head\" style=\"padding: calc(20px * var(--space-scale, 1)); padding-bottom: 0\" data-eid=\"e27\">\n            <h2 class=\"ds-h3\" style=\"margin: 0\" data-eid=\"e28\">All products</h2>\n            <span class=\"ds-spacer\" data-eid=\"e29\"></span>\n            <button class=\"ds-btn ds-btn-secondary ds-btn-sm\" data-goto=\"editor\" data-eid=\"e30\">\n              Add product\n            </button>\n          </div>\n          <div class=\"ds-table-wrap\" data-eid=\"e31\">\n            <table class=\"ds-table\" data-eid=\"e32\">\n              <thead data-eid=\"e33\">\n                <tr data-eid=\"e34\">\n                  <th scope=\"col\" data-eid=\"e35\">Product</th>\n                  <th scope=\"col\" style=\"text-align: right\" data-eid=\"e36\">Price</th>\n                  <th scope=\"col\" data-eid=\"e37\">Visible</th>\n                  <th scope=\"col\" class=\"ds-only-wide\" style=\"text-align: right\" data-eid=\"e38\">Order</th>\n                  <th scope=\"col\" data-eid=\"e39\"><span class=\"ds-only-wide\" data-eid=\"e40\">Actions</span><span class=\"ds-only-narrow\" aria-hidden=\"true\" data-eid=\"e41\"></span></th>\n                </tr>\n              </thead>\n              <tbody data-eid=\"e42\">\n                <tr data-eid=\"e43\">\n                  <td data-eid=\"e44\">\n                    <div class=\"ed-prod-name\" data-eid=\"e45\">\n                      <div class=\"ds-img ed-thumb\" data-sample=\"\" data-eid=\"e46\"></div>\n                      <div data-eid=\"e47\">\n                        <b data-sample=\"Product#1.name\">Bramble honey, 340g jar</b>\n                        <small data-sample=\"Product#1.group\" data-eid=\"e48\">Store cupboard</small>\n                      </div>\n                    </div>\n                  </td>\n                  <td class=\"ed-price\" data-sample=\"Product#1.pricePence\" data-eid=\"e49\">£8.50</td>\n                  <td data-eid=\"e50\">\n                    <div class=\"ed-visible\" data-eid=\"e51\">\n                      <button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Visible for Bramble honey, 340g jar\" data-eid=\"e52\"></button>\n                      <span class=\"ed-visible-label ds-only-wide\" data-eid=\"e53\">On</span>\n                    </div>\n                  </td>\n                  <td class=\"ed-order ds-only-wide\" data-sample=\"Product#1.sortOrder\" data-eid=\"e54\">1</td>\n                  <td data-eid=\"e55\">\n                    <div class=\"ds-row-actions\" data-eid=\"e56\">\n                      <button class=\"ds-btn ds-btn-secondary ds-btn-sm ds-only-wide\" data-goto=\"editor\" data-eid=\"e57\">Edit</button>\n                      <details class=\"ds-menu\">\n                        <summary class=\"ds-btn ds-btn-ghost ds-btn-icon\" aria-label=\"More actions for Bramble honey, 340g jar\">\n                          <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.5\"></circle></svg>\n                        </summary>\n                        <div class=\"ds-menu-list\" data-eid=\"e58\">\n                          <a data-goto=\"editor\" data-eid=\"e59\">Edit</a>\n                          <a data-goto=\"editor\" data-eid=\"e60\">Hide from the site</a>\n                          <a href=\"#\" role=\"button\" data-eid=\"e61\">Remove</a>\n                        </div>\n                      </details>\n                    </div>\n                  </td>\n                </tr>\n                <tr data-eid=\"e62\">\n                  <td data-eid=\"e63\">\n                    <div class=\"ed-prod-name\" data-eid=\"e64\">\n                      <div class=\"ds-img ed-thumb\" data-sample=\"\" data-eid=\"e65\"></div>\n                      <div data-eid=\"e66\">\n                        <b data-sample=\"Product#2.name\">Sourdough loaf</b>\n                        <small data-sample=\"Product#2.group\" data-eid=\"e67\">Fresh bread</small>\n                      </div>\n                    </div>\n                  </td>\n                  <td class=\"ed-price\" data-sample=\"Product#2.pricePence\" data-eid=\"e68\">£4.20</td>\n                  <td data-eid=\"e69\">\n                    <div class=\"ed-visible\" data-eid=\"e70\">\n                      <button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Visible for Sourdough loaf\" data-eid=\"e71\"></button>\n                      <span class=\"ed-visible-label ds-only-wide\" data-eid=\"e72\">On</span>\n                    </div>\n                  </td>\n                  <td class=\"ed-order ds-only-wide\" data-sample=\"Product#2.sortOrder\" data-eid=\"e73\">2</td>\n                  <td data-eid=\"e74\">\n                    <div class=\"ds-row-actions\" data-eid=\"e75\">\n                      <button class=\"ds-btn ds-btn-secondary ds-btn-sm ds-only-wide\" data-goto=\"editor\" data-eid=\"e76\">Edit</button>\n                      <details class=\"ds-menu\">\n                        <summary class=\"ds-btn ds-btn-ghost ds-btn-icon\" aria-label=\"More actions for Sourdough loaf\">\n                          <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.5\"></circle></svg>\n                        </summary>\n                        <div class=\"ds-menu-list\" data-eid=\"e77\">\n                          <a data-goto=\"editor\" data-eid=\"e78\">Edit</a>\n                          <a data-goto=\"editor\" data-eid=\"e79\">Hide from the site</a>\n                          <a href=\"#\" role=\"button\" data-eid=\"e80\">Remove</a>\n                        </div>\n                      </details>\n                    </div>\n                  </td>\n                </tr>\n                <tr data-eid=\"e81\">\n                  <td data-eid=\"e82\">\n                    <div class=\"ed-prod-name\" data-eid=\"e83\">\n                      <div class=\"ds-img ed-thumb\" data-sample=\"\" data-eid=\"e84\"></div>\n                      <div data-eid=\"e85\">\n                        <b data-sample=\"Product#3.name\">Dead Sea mud soap, unscented</b>\n                        <small data-sample=\"Product#3.group\" data-eid=\"e86\">Bathroom shelf</small>\n                      </div>\n                    </div>\n                  </td>\n                  <td class=\"ed-price\" data-sample=\"Product#3.pricePence\" data-eid=\"e87\">£12.50</td>\n                  <td data-eid=\"e88\">\n                    <div class=\"ed-visible\" data-eid=\"e89\">\n                      <button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Visible for Dead Sea mud soap, unscented\" data-eid=\"e90\"></button>\n                      <span class=\"ed-visible-label ds-only-wide\" data-eid=\"e91\">On</span>\n                    </div>\n                  </td>\n                  <td class=\"ed-order ds-only-wide\" data-sample=\"Product#3.sortOrder\" data-eid=\"e92\">3</td>\n                  <td data-eid=\"e93\">\n                    <div class=\"ds-row-actions\" data-eid=\"e94\">\n                      <button class=\"ds-btn ds-btn-secondary ds-btn-sm ds-only-wide\" data-goto=\"editor\" data-eid=\"e95\">Edit</button>\n                      <details class=\"ds-menu\">\n                        <summary class=\"ds-btn ds-btn-ghost ds-btn-icon\" aria-label=\"More actions for Dead Sea mud soap, unscented\">\n                          <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.5\"></circle></svg>\n                        </summary>\n                        <div class=\"ds-menu-list\" data-eid=\"e96\">\n                          <a data-goto=\"editor\" data-eid=\"e97\">Edit</a>\n                          <a data-goto=\"editor\" data-eid=\"e98\">Hide from the site</a>\n                          <a href=\"#\" role=\"button\" data-eid=\"e99\">Remove</a>\n                        </div>\n                      </details>\n                    </div>\n                  </td>\n                </tr>\n                <tr data-eid=\"e100\">\n                  <td data-eid=\"e101\">\n                    <div class=\"ed-prod-name\" data-eid=\"e102\">\n                      <div class=\"ds-img ed-thumb\" data-sample=\"\" data-eid=\"e103\"></div>\n                      <div data-eid=\"e104\">\n                        <b data-sample=\"Product#4.name\">Cotton tea towel, moss green</b>\n                        <small data-sample=\"Product#4.group\" data-eid=\"e105\">Kitchen</small>\n                      </div>\n                    </div>\n                  </td>\n                  <td class=\"ed-price\" data-sample=\"Product#4.pricePence\" data-eid=\"e106\">£9.00</td>\n                  <td data-eid=\"e107\">\n                    <div class=\"ed-visible\" data-eid=\"e108\">\n                      <button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Visible for Cotton tea towel, moss green\" data-eid=\"e109\"></button>\n                      <span class=\"ed-visible-label ds-only-wide\" data-eid=\"e110\">On</span>\n                    </div>\n                  </td>\n                  <td class=\"ed-order ds-only-wide\" data-sample=\"Product#4.sortOrder\" data-eid=\"e111\">4</td>\n                  <td data-eid=\"e112\">\n                    <div class=\"ds-row-actions\" data-eid=\"e113\">\n                      <button class=\"ds-btn ds-btn-secondary ds-btn-sm ds-only-wide\" data-goto=\"editor\" data-eid=\"e114\">Edit</button>\n                      <details class=\"ds-menu\">\n                        <summary class=\"ds-btn ds-btn-ghost ds-btn-icon\" aria-label=\"More actions for Cotton tea towel, moss green\">\n                          <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.5\"></circle></svg>\n                        </summary>\n                        <div class=\"ds-menu-list\" data-eid=\"e115\">\n                          <a data-goto=\"editor\" data-eid=\"e116\">Edit</a>\n                          <a data-goto=\"editor\" data-eid=\"e117\">Hide from the site</a>\n                          <a href=\"#\" role=\"button\" data-eid=\"e118\">Remove</a>\n                        </div>\n                      </details>\n                    </div>\n                  </td>\n                </tr>\n                <tr data-eid=\"e119\">\n                  <td data-eid=\"e120\">\n                    <div class=\"ed-prod-name\" data-eid=\"e121\">\n                      <div class=\"ds-img ed-thumb\" data-sample=\"\" data-eid=\"e122\"></div>\n                      <div data-eid=\"e123\">\n                        <b data-sample=\"Product#5.name\">Cider vinegar, 500ml</b>\n                        <small data-sample=\"Product#5.group\" data-eid=\"e124\">Store cupboard</small>\n                      </div>\n                    </div>\n                  </td>\n                  <td class=\"ed-price\" data-sample=\"Product#5.pricePence\" data-eid=\"e125\">£6.25</td>\n                  <td data-eid=\"e126\">\n                    <div class=\"ed-visible\" data-eid=\"e127\">\n                      <button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Visible for Cider vinegar, 500ml\" data-eid=\"e128\"></button>\n                      <span class=\"ed-visible-label ds-only-wide\" data-eid=\"e129\">On</span>\n                    </div>\n                  </td>\n                  <td class=\"ed-order ds-only-wide\" data-sample=\"Product#5.sortOrder\" data-eid=\"e130\">5</td>\n                  <td data-eid=\"e131\">\n                    <div class=\"ds-row-actions\" data-eid=\"e132\">\n                      <button class=\"ds-btn ds-btn-secondary ds-btn-sm ds-only-wide\" data-goto=\"editor\" data-eid=\"e133\">Edit</button>\n                      <details class=\"ds-menu\">\n                        <summary class=\"ds-btn ds-btn-ghost ds-btn-icon\" aria-label=\"More actions for Cider vinegar, 500ml\">\n                          <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.5\"></circle></svg>\n                        </summary>\n                        <div class=\"ds-menu-list\" data-eid=\"e134\">\n                          <a data-goto=\"editor\" data-eid=\"e135\">Edit</a>\n                          <a data-goto=\"editor\" data-eid=\"e136\">Hide from the site</a>\n                          <a href=\"#\" role=\"button\" data-eid=\"e137\">Remove</a>\n                        </div>\n                      </details>\n                    </div>\n                  </td>\n                </tr>\n                <tr data-eid=\"e138\">\n                  <td data-eid=\"e139\">\n                    <div class=\"ed-prod-name\" data-eid=\"e140\">\n                      <div class=\"ds-img ed-thumb\" data-sample=\"\" data-eid=\"e141\"></div>\n                      <div data-eid=\"e142\">\n                        <b data-sample=\"Product#6.name\">Elderflower cordial</b>\n                        <small data-sample=\"Product#6.group\" data-eid=\"e143\">Drinks</small>\n                      </div>\n                    </div>\n                  </td>\n                  <td class=\"ed-price\" data-sample=\"Product#6.pricePence\" data-eid=\"e144\">£7.80</td>\n                  <td data-eid=\"e145\">\n                    <div class=\"ed-visible\" data-eid=\"e146\">\n                      <button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Visible for Elderflower cordial\" data-eid=\"e147\"></button>\n                      <span class=\"ed-visible-label ds-only-wide\" data-eid=\"e148\">On</span>\n                    </div>\n                  </td>\n                  <td class=\"ed-order ds-only-wide\" data-sample=\"Product#6.sortOrder\" data-eid=\"e149\">6</td>\n                  <td data-eid=\"e150\">\n                    <div class=\"ds-row-actions\" data-eid=\"e151\">\n                      <button class=\"ds-btn ds-btn-secondary ds-btn-sm ds-only-wide\" data-goto=\"editor\" data-eid=\"e152\">Edit</button>\n                      <details class=\"ds-menu\">\n                        <summary class=\"ds-btn ds-btn-ghost ds-btn-icon\" aria-label=\"More actions for Elderflower cordial\">\n                          <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.5\"></circle></svg>\n                        </summary>\n                        <div class=\"ds-menu-list\" data-eid=\"e153\">\n                          <a data-goto=\"editor\" data-eid=\"e154\">Edit</a>\n                          <a data-goto=\"editor\" data-eid=\"e155\">Hide from the site</a>\n                          <a href=\"#\" role=\"button\" data-eid=\"e156\">Remove</a>\n                        </div>\n                      </details>\n                