{"html":"<style>\n  .dn-ed-header { background: hsl(var(--band)); color: hsl(var(--band-foreground)); }\n  .dn-ed-bar { display: flex; align-items: center; gap: calc(16px * var(--space-scale, 1)); padding-top: calc(12px * var(--space-scale, 1)); padding-bottom: calc(12px * var(--space-scale, 1)); }\n  .dn-ed-brand { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 800; font-size: 20px; letter-spacing: -0.03em; color: inherit; text-decoration: none; white-space: nowrap; }\n  .dn-ed-mark { width: 30px; height: 30px; border-radius: calc(var(--radius) * 0.8); background: hsl(var(--band-foreground)); color: hsl(var(--band)); display: inline-grid; place-items: center; flex: none; }\n  .dn-ed-mark svg { width: 18px; height: 18px; }\n  .dn-ed-tag { font-size: 11px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; padding: calc(4px * var(--space-scale, 1)) calc(10px * var(--space-scale, 1)); border-radius: 999px; background: hsl(var(--band-foreground) / 0.16); color: inherit; border: 1px solid hsl(var(--band-foreground) / 0.28); }\n  .dn-ed-nav { display: flex; align-items: center; gap: calc(4px * var(--space-scale, 1)); }\n  .dn-ed-nav a { display: inline-flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); padding: calc(8px * var(--space-scale, 1)) calc(14px * var(--space-scale, 1)); border-radius: 999px; font-size: 14px; font-weight: 600; color: hsl(var(--band-foreground) / 0.78); text-decoration: none; white-space: nowrap; transition: background .15s, color .15s; }\n  .dn-ed-nav a:hover { color: inherit; background: hsl(var(--band-foreground) / 0.12); }\n  .dn-ed-nav a.dn-on { color: hsl(var(--band)); background: hsl(var(--band-foreground)); }\n  .dn-ed-nav a svg { width: 16px; height: 16px; }\n  .dn-ed-right { display: flex; align-items: center; gap: calc(12px * var(--space-scale, 1)); }\n  .dn-ed-user { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); padding: calc(4px * var(--space-scale, 1)) calc(12px * var(--space-scale, 1)) calc(4px * var(--space-scale, 1)) calc(4px * var(--space-scale, 1)); border-radius: 999px; background: hsl(var(--band-foreground) / 0.12); }\n  .dn-ed-user-text { display: flex; flex-direction: column; line-height: 1.15; }\n  .dn-ed-user-name { font-size: 13px; font-weight: 700; color: inherit; white-space: nowrap; }\n  .dn-ed-user-role { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: hsl(var(--band-foreground) / 0.75); white-space: nowrap; }\n  .dn-ed-avatar { width: 30px; height: 30px; border-radius: 999px; display: inline-grid; place-items: center; font-size: 12px; font-weight: 700; background: hsl(var(--band-foreground)); color: hsl(var(--band)); flex: none; }\n  .dn-ed-mobile-theme { padding: calc(8px * var(--space-scale, 1)); border-top: 1px solid hsl(var(--border)); margin-top: calc(8px * var(--space-scale, 1)); }\n  .dn-ed-menu-link { display: inline-flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); }\n  .dn-ed-menu-link svg { width: 16px; height: 16px; }\n  @media (max-width: 1100px) {\n    .dn-ed-user-text { display: none; }\n  }\n</style>\n<header class=\"dn-ed-header\" data-eid=\"e1\">\n  <div class=\"ds-bar dn-ed-bar\" data-eid=\"e2\">\n    <a class=\"dn-ed-brand\" data-goto=\"home\" href=\"#\" data-eid=\"e3\">\n      <span class=\"dn-ed-mark\" aria-hidden=\"true\" data-eid=\"e4\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 7V5.5A2.5 2.5 0 0 1 10.5 3h3A2.5 2.5 0 0 1 16 5.5V7\"></path><path d=\"M4 7h16v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7Z\"></path><path d=\"M4 7v4h16\"></path><path d=\"M9 17v-3M15 17v-3\"></path></svg></span>\n      <span class=\"ds-brand-text\" data-eid=\"e5\">Donkey website</span>\n    </a>\n    <span class=\"dn-ed-tag\" data-eid=\"e6\">Editors</span>\n    <nav class=\"dn-ed-nav ds-only-wide\" aria-label=\"Editors' area\" data-eid=\"e7\">\n      <a data-goto=\"editor\" href=\"#\" class=\"dn-on\" data-eid=\"e8\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z\"></path><path d=\"m4 7.5 8 4.5 8-4.5M12 12v9\"></path></svg>\n        Products\n      </a>\n      <a data-goto=\"editor\" href=\"#\" data-eid=\"e9\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5h9a3 3 0 0 1 3 3v11H7a3 3 0 0 1-3-3V5Z\"></path><path d=\"M16 9h4v10h-4\"></path></svg>\n        Page wording\n      </a>\n      <a data-goto=\"editor\" href=\"#\" data-eid=\"e10\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5h16v12H9l-5 4V5Z\"></path><path d=\"M8 9h8M8 12.5h5\"></path></svg>\n        Form entries\n      </a>\n    </nav>\n    <span class=\"ds-spacer\" data-eid=\"e11\"></span>\n    <div class=\"dn-ed-right\" data-eid=\"e12\">\n      <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e13\">\n        <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e14\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n        <button aria-label=\"Dark\" data-eid=\"e15\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n        <button aria-label=\"Auto\" data-eid=\"e16\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n      </div>\n      <div class=\"dn-ed-user\" data-eid=\"e17\">\n        <span class=\"dn-ed-avatar\" data-sample=\"\" data-eid=\"e18\">PS</span>\n        <span class=\"dn-ed-user-text\" data-eid=\"e19\">\n          <b class=\"dn-ed-user-name\" data-sample=\"me.name\">Priya Shah</b>\n          <span class=\"dn-ed-user-role\" data-sample=\"me.role\" data-eid=\"e20\">Editor</span>\n        </span>\n      </div>\n      <details class=\"ds-menu ds-only-narrow\">\n        <summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary>\n        <div class=\"ds-menu-list\" data-eid=\"e21\">\n          <a data-goto=\"editor\" href=\"#\" class=\"dn-ed-menu-link\" data-eid=\"e22\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z\"></path><path d=\"m4 7.5 8 4.5 8-4.5M12 12v9\"></path></svg>\n            Products\n          </a>\n          <a data-goto=\"editor\" href=\"#\" class=\"dn-ed-menu-link\" data-eid=\"e23\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5h9a3 3 0 0 1 3 3v11H7a3 3 0 0 1-3-3V5Z\"></path><path d=\"M16 9h4v10h-4\"></path></svg>\n            Page wording\n          </a>\n          <a data-goto=\"editor\" href=\"#\" class=\"dn-ed-menu-link\" data-eid=\"e24\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5h16v12H9l-5 4V5Z\"></path><path d=\"M8 9h8M8 12.5h5\"></path></svg>\n            Form entries\n          </a>\n          <a data-goto=\"editor\" href=\"#\" data-eid=\"e25\">Sign out</a>\n          <div class=\"dn-ed-mobile-theme\" data-eid=\"e26\">\n            <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e27\">\n              <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e28\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n              <button aria-label=\"Dark\" data-eid=\"e29\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n              <button aria-label=\"Auto\" data-eid=\"e30\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n            </div>\n          </div>\n        </div>\n      </details>\n    </div>\n  </div>\n</header>","changes":[]}