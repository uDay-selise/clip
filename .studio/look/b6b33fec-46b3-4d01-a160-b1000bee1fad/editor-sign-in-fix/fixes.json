{"html":"<style>\n  [data-screen=\"editor-sign-in\"] {\n    min-height: 100vh;\n    background:\n      radial-gradient(120% 90% at 82% -10%, hsl(var(--primary) / 0.14), transparent 62%),\n      radial-gradient(90% 70% at -10% 110%, hsl(var(--accent) / 0.16), transparent 60%),\n      hsl(var(--background));\n  }\n  .es-top {\n    display: flex;\n    align-items: center;\n    gap: calc(16px * var(--space-scale, 1));\n    padding: calc(16px * var(--space-scale, 1)) 0;\n  }\n  .es-brand {\n    display: inline-flex;\n    align-items: center;\n    gap: calc(12px * var(--space-scale, 1));\n    font-family: var(--font-heading);\n    font-weight: 800;\n    font-size: 20px;\n    letter-spacing: -0.03em;\n    color: hsl(var(--foreground));\n    text-decoration: none;\n  }\n  .es-mark {\n    width: 34px;\n    height: 34px;\n    border-radius: 12px;\n    background: hsl(var(--primary));\n    color: hsl(var(--primary-foreground));\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    box-shadow: var(--shadow);\n  }\n  .es-mark svg { width: 20px; height: 20px; }\n\n  .es-body {\n    display: grid;\n    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);\n    gap: calc(48px * var(--space-scale, 1));\n    align-items: stretch;\n    padding-top: calc(32px * var(--space-scale, 1));\n    padding-bottom: calc(64px * var(--space-scale, 1));\n  }\n\n  /* the page head sits in the left column of the split */\n  .es-head { margin: 0; }\n  .es-head .ds-eyebrow { display: inline-block; }\n  .es-title {\n    margin: calc(16px * var(--space-scale, 1)) 0 0;\n    font-family: var(--font-heading);\n    font-size: clamp(40px, 7vw, 76px);\n    line-height: 0.96;\n    letter-spacing: -0.045em;\n    font-weight: 800;\n    color: hsl(var(--foreground));\n  }\n  .es-title span { color: hsl(var(--primary-text)); }\n  .es-lead {\n    margin: calc(24px * var(--space-scale, 1)) 0 0;\n    max-width: 34ch;\n    font-size: 18px;\n    line-height: 1.6;\n    color: hsl(var(--muted-foreground));\n  }\n  .es-points {\n    list-style: none;\n    margin: calc(32px * var(--space-scale, 1)) 0 0;\n    padding: 0;\n    display: grid;\n    gap: calc(16px * var(--space-scale, 1));\n    max-width: 40ch;\n  }\n  .es-points li {\n    display: grid;\n    grid-template-columns: 28px 1fr;\n    gap: calc(12px * var(--space-scale, 1));\n    align-items: start;\n    font-size: 15px;\n    line-height: 1.5;\n    color: hsl(var(--foreground));\n  }\n  .es-tick {\n    width: 28px;\n    height: 28px;\n    border-radius: 999px;\n    background: hsl(var(--primary) / 0.14);\n    color: hsl(var(--primary-text));\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .es-tick svg { width: 16px; height: 16px; }\n\n  /* the door panel: the one bold move */\n  .es-door {\n    position: relative;\n    border-radius: calc(var(--radius) + 12px);\n    background: hsl(var(--primary));\n    color: hsl(var(--primary-foreground));\n    padding: calc(32px * var(--space-scale, 1));\n    box-shadow: 0 calc(32px * var(--space-scale, 1)) calc(64px * var(--space-scale, 1)) hsl(var(--primary) / 0.28);\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    gap: calc(32px * var(--space-scale, 1));\n    overflow: hidden;\n  }\n  .es-ring {\n    top: -120px;\n    right: -110px;\n    width: 320px;\n    height: 320px;\n    border-radius: 999px;\n    border: 2px solid hsl(var(--primary-foreground) / 0.28);\n    box-sizing: border-box;\n  }\n  .es-blob {\n    bottom: -90px;\n    left: -70px;\n    width: 240px;\n    height: 240px;\n    border-radius: 999px;\n    background: hsl(var(--primary-foreground) / 0.08);\n  }\n  .es-door-label {\n    display: inline-block;\n    font-size: 12px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    font-weight: 700;\n    color: hsl(var(--primary-foreground) / 0.78);\n    position: relative;\n  }\n  .es-door-title {\n    position: relative;\n    margin: calc(12px * var(--space-scale, 1)) 0 0;\n    font-family: var(--font-heading);\n    font-size: 26px;\n    line-height: 1.1;\n    letter-spacing: -0.03em;\n    font-weight: 800;\n    color: hsl(var(--primary-foreground));\n  }\n  .es-door-copy {\n    position: relative;\n    margin: calc(12px * var(--space-scale, 1)) 0 0;\n    font-size: 15px;\n    line-height: 1.55;\n    color: hsl(var(--primary-foreground) / 0.86);\n  }\n  .es-door .ds-btn {\n    position: relative;\n    width: 100%;\n    background: hsl(var(--primary-foreground));\n    color: hsl(var(--primary-text));\n    border-color: transparent;\n    font-weight: 700;\n  }\n  .es-door .ds-btn:hover { background: hsl(var(--primary-foreground) / 0.9); }\n  .es-door-footnote {\n    position: relative;\n    margin: calc(12px * var(--space-scale, 1)) 0 0;\n    text-align: center;\n    font-size: 13px;\n    color: hsl(var(--primary-foreground) / 0.78);\n  }\n  .es-door-footnote a {\n    color: inherit;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n  .es-lock {\n    width: 52px;\n    height: 52px;\n    border-radius: 16px;\n    background: hsl(var(--primary-foreground) / 0.14);\n    color: hsl(var(--primary-foreground));\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n  }\n  .es-lock svg { width: 24px; height: 24px; }\n  .es-door-top { position: relative; }\n\n  @media (max-width: 900px) {\n    .es-body { grid-template-columns: 1fr; gap: calc(32px * var(--space-scale, 1)); }\n  }\n</style><main data-screen=\"editor-sign-in\" data-eid=\"e1\">\n  <div class=\"ds-page es-page\" style=\"padding-top: 0\" data-eid=\"e2\">\n    <div class=\"es-top\" data-eid=\"e3\">\n      <a class=\"es-brand\" data-goto=\"home\" data-eid=\"e4\">\n        <span class=\"es-mark\" aria-hidden=\"true\" data-eid=\"e5\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 9c0-2 1.5-4 4-4h6c2.5 0 4 2 4 4v4c0 3.5-2.5 6-6 6h-2c-3.5 0-6-2.5-6-6V9Z\"></path><path d=\"M9 9v.01M15 9v.01\"></path></svg>\n        </span>\n        Donkey\n      </a>\n      <span class=\"ds-spacer\" data-eid=\"e6\"></span>\n      <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e7\">\n        <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e8\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n        <button aria-label=\"Dark\" data-eid=\"e9\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n        <button aria-label=\"Auto\" data-eid=\"e10\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n      </div>\n    </div>\n\n    <div class=\"es-body\" data-eid=\"e11\">\n      <section class=\"ds-page-head es-head\" data-eid=\"e12\">\n        <span class=\"ds-eyebrow\" data-eid=\"e13\">For Donkey's editors</span>\n        <h1 class=\"es-title\" data-eid=\"e14\">The shop's <span data-eid=\"e15\">editor desk.</span></h1>\n        <p class=\"es-lead\" data-eid=\"e16\">This is where the Donkey team keeps the site up to date: page wording, delivery and returns, contact details, and every product with its price.</p>\n        <ul class=\"es-points\" data-eid=\"e17\">\n          <li data-eid=\"e18\"><span class=\"es-tick\" aria-hidden=\"true\" data-eid=\"e19\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12 5 5 9-9\"></path></svg></span>Change the words shoppers read on Home, How it works and Contact.</li>\n          <li data-eid=\"e20\"><span class=\"es-tick\" aria-hidden=\"true\" data-eid=\"e21\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12 5 5 9-9\"></path></svg></span>Add products, prices and photos, and choose what shows on the site.</li>\n          <li data-eid=\"e22\"><span class=\"es-tick\" aria-hidden=\"true\" data-eid=\"e23\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12 5 5 9-9\"></path></svg></span>Sign in with the email address your invite came to.</li>\n        </ul>\n      </section>\n\n      <aside class=\"es-door\" data-eid=\"e24\">\n        <div class=\"ds-deco es-ring\" aria-hidden=\"true\" data-eid=\"e25\"></div>\n        <div class=\"ds-deco es-blob\" aria-hidden=\"true\" data-eid=\"e26\"></div>\n        <div class=\"es-door-top\" data-eid=\"e27\">\n          <span class=\"es-lock\" aria-hidden=\"true\" data-eid=\"e28\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4.5\" y=\"10.5\" width=\"15\" height=\"10\" rx=\"3\"></rect><path d=\"M8 10.5V8a4 4 0 0 1 8 0v2.5\"></path><path d=\"M12 14.5v2.5\"></path></svg></span>\n          <span class=\"es-door-label\" style=\"margin-top: calc(24px * var(--space-scale, 1))\" data-eid=\"e29\">Editors' area</span>\n          <h2 class=\"es-door-title\" data-eid=\"e30\">Only invited editors get in.</h2>\n          <p class=\"es-door-copy\" data-eid=\"e31\">No sign-up here, and nothing on the shop pages links to this door. Your invite email set your password the first time.</p>\n        </div>\n        <div data-eid=\"e32\">\n          <button class=\"ds-btn ds-btn-lg\" data-goto=\"editor\" data-eid=\"e33\">Sign in</button>\n          <p class=\"es-door-footnote\" data-eid=\"e34\">Lost your invite email? Write to <a href=\"#\" data-eid=\"e35\">hello@donkey.example</a> and the team will send a new one.</p>\n        </div>\n      </aside>\n    </div>\n  </div>\n\n  <div data-part=\"footer\" data-eid=\"e36\"></div>\n</main>","changes":[]}