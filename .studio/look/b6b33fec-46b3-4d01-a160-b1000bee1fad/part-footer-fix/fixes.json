{"html":"<style>\n  .dn-footer { background: hsl(var(--band)); color: hsl(var(--band-foreground)); margin-top: calc(64px * var(--space-scale, 1)); }\n  .dn-footer-bar { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: calc(32px * var(--space-scale, 1)) calc(48px * var(--space-scale, 1)); padding-top: calc(48px * var(--space-scale, 1)); padding-bottom: calc(32px * var(--space-scale, 1)); align-items: start; }\n  .dn-foot-brand { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 800; font-size: 26px; letter-spacing: -0.03em; color: inherit; text-decoration: none; }\n  .dn-foot-mark { width: 34px; height: 34px; border-radius: calc(var(--radius) * 0.9); background: hsl(var(--band-foreground)); color: hsl(var(--band)); display: inline-grid; place-items: center; flex: none; }\n  .dn-foot-mark svg { width: 20px; height: 20px; }\n  .dn-foot-line { margin-top: calc(14px * var(--space-scale, 1)); max-width: 30ch; font-size: 15px; line-height: 1.6; color: hsl(var(--band-foreground) / 0.8); }\n  .dn-foot-caps { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: hsl(var(--band-foreground) / 0.65); }\n  .dn-foot-links { display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1)); margin-top: calc(14px * var(--space-scale, 1)); }\n  .dn-foot-links a { font-size: 15px; font-weight: 600; color: inherit; text-decoration: none; width: fit-content; }\n  .dn-foot-links a:hover { text-decoration: underline; text-underline-offset: 4px; }\n  .dn-foot-details { display: flex; flex-direction: column; gap: calc(12px * var(--space-scale, 1)); margin-top: calc(14px * var(--space-scale, 1)); }\n  .dn-foot-detail { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-size: 15px; font-weight: 600; color: inherit; text-decoration: none; width: fit-content; }\n  .dn-foot-detail:hover { text-decoration: underline; text-underline-offset: 4px; }\n  .dn-foot-detail svg { width: 17px; height: 17px; flex: none; color: hsl(var(--band-foreground) / 0.7); }\n  .dn-foot-bottom { display: flex; align-items: center; gap: calc(16px * var(--space-scale, 1)); padding-top: calc(20px * var(--space-scale, 1)); padding-bottom: calc(24px * var(--space-scale, 1)); border-top: 1px solid hsl(var(--band-foreground) / 0.18); font-size: 13px; color: hsl(var(--band-foreground) / 0.7); }\n  @media (max-width: 860px) {\n    .dn-footer-bar { grid-template-columns: 1fr 1fr; }\n    .dn-foot-brand-col { grid-column: 1 / -1; }\n  }\n  @media (max-width: 520px) {\n    .dn-footer-bar { grid-template-columns: 1fr; }\n    .dn-foot-bottom { flex-wrap: wrap; }\n  }\n</style>\n<footer class=\"dn-footer\" data-eid=\"e1\">\n  <div class=\"ds-bar dn-footer-bar\" data-eid=\"e2\">\n    <div class=\"dn-foot-brand-col\" data-eid=\"e3\">\n      <a class=\"dn-foot-brand\" data-goto=\"home\" href=\"#\" data-eid=\"e4\">\n        <span class=\"dn-foot-mark\" aria-hidden=\"true\" data-eid=\"e5\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 7V5.5A2.5 2.5 0 0 1 10.5 3h3A2.5 2.5 0 0 1 16 5.5V7\"></path><path d=\"M4 7h16v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7Z\"></path><path d=\"M4 7v4h16\"></path><path d=\"M9 17v-3M15 17v-3\"></path></svg></span>\n        <span class=\"ds-brand-text\" data-eid=\"e6\">Donkey website</span>\n      </a>\n      <p class=\"dn-foot-line\" data-sample=\"PageWording#home.intro\" data-eid=\"e7\">Plain, useful things for the home and the garden, chosen by Donkey and sent out from our workshop.</p>\n    </div>\n    <div data-eid=\"e8\">\n      <span class=\"dn-foot-caps\" data-eid=\"e9\">Pages</span>\n      <nav class=\"dn-foot-links\" aria-label=\"Pages\" data-eid=\"e10\">\n        <a data-goto=\"home\" href=\"#\" data-eid=\"e11\">Home</a>\n        <a data-goto=\"how-it-works\" href=\"#\" data-eid=\"e12\">How it works</a>\n        <a data-goto=\"products\" href=\"#\" data-eid=\"e13\">Products</a>\n        <a data-goto=\"about\" href=\"#\" data-eid=\"e14\">About</a>\n        <a data-goto=\"contact\" href=\"#\" data-eid=\"e15\">Contact</a>\n      </nav>\n    </div>\n    <div data-eid=\"e16\">\n      <span class=\"dn-foot-caps\" data-eid=\"e17\">Reach us</span>\n      <div class=\"dn-foot-details\" data-eid=\"e18\">\n        <a class=\"dn-foot-detail\" href=\"#\" data-goto=\"contact\" data-eid=\"e19\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"></rect><path d=\"m4 7 8 6 8-6\"></path></svg>\n          <span data-sample=\"PageWording#contact.email\" data-eid=\"e20\">hello@donkey.example</span>\n        </a>\n        <a class=\"dn-foot-detail\" href=\"#\" data-goto=\"contact\" data-eid=\"e21\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 3h3l2 5-2.5 1.5a12 12 0 0 0 6 6L16 13l5 2v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4 5.2 2 2 0 0 1 6 3Z\"></path></svg>\n          <span data-sample=\"PageWording#contact.phone\" data-eid=\"e22\">01234 567890</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"ds-bar dn-foot-bottom\" data-eid=\"e23\">\n    <span data-sample=\"\" data-eid=\"e24\">Donkey, a small shop for everyday things.</span>\n    <span class=\"ds-spacer\" data-eid=\"e25\"></span>\n    <span data-eid=\"e26\">Prices in pounds.</span>\n  </div>\n</footer>","changes":[]}