{"html":"<style>\n  .pr-top { display: flex; align-items: center; gap: calc(24px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) 0; }\n  .pr-brand { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 700; font-size: 21px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; }\n  .pr-mark { width: 34px; height: 34px; border-radius: var(--radius); background: hsl(var(--band)); color: hsl(var(--band-foreground)); display: grid; place-items: center; flex: none; }\n  .pr-links { display: flex; gap: calc(24px * var(--space-scale, 1)); font-size: 15px; align-items: center; }\n  .pr-links a { color: hsl(var(--muted-foreground)); text-decoration: none; padding: 10px 0; }\n  .pr-links a:hover { color: hsl(var(--foreground)); }\n  .pr-links a.pr-here { color: hsl(var(--foreground)); font-weight: 600; }\n\n  .pr-head { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: calc(48px * var(--space-scale, 1)); align-items: end; padding-top: calc(48px * var(--space-scale, 1)); padding-bottom: calc(40px * var(--space-scale, 1)); position: relative; }\n  .pr-head h1 { margin-top: calc(12px * var(--space-scale, 1)); }\n  .pr-head h1 em { font-style: normal; color: hsl(var(--primary-text)); }\n  .pr-head-lead { margin-top: calc(16px * var(--space-scale, 1)); max-width: 32em; font-size: 17px; line-height: 1.6; color: hsl(var(--muted-foreground)); }\n  .pr-count { justify-self: end; text-align: right; }\n  .pr-count-big { font-family: var(--font-heading); font-size: 64px; line-height: 0.9; letter-spacing: -0.04em; color: hsl(var(--primary-text)); font-variant-numeric: tabular-nums; display: block; }\n  .pr-count-label { display: block; margin-top: calc(8px * var(--space-scale, 1)); font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: hsl(var(--muted-foreground)); }\n\n  .pr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(24px * var(--space-scale, 1)); }\n  .pr-card { display: flex; flex-direction: column; border-radius: calc(var(--radius) + 6px); background: hsl(var(--card)); box-shadow: var(--shadow); border: 1px solid hsl(var(--border)); overflow: hidden; }\n  .pr-photo { aspect-ratio: 4 / 3; border-radius: 0; width: 100%; background: hsl(var(--muted)); }\n  .pr-photo.ds-img { border-radius: 0; }\n  .pr-body { display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1)); padding: calc(20px * var(--space-scale, 1)); flex: 1; }\n  .pr-name { font-family: var(--font-heading); font-size: 21px; line-height: 1.2; letter-spacing: -0.02em; margin: 0; }\n  .pr-desc { font-size: 15px; line-height: 1.55; color: hsl(var(--muted-foreground)); margin: 0; }\n  .pr-price-row { margin-top: auto; padding-top: calc(12px * var(--space-scale, 1)); display: flex; align-items: baseline; gap: calc(10px * var(--space-scale, 1)); }\n  .pr-price { font-family: var(--font-heading); font-size: 30px; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; line-height: 1; }\n  .pr-med { font-size: 13px; line-height: 1.45; color: hsl(var(--muted-foreground)); border-left: 2px solid hsl(var(--warning)); padding-left: calc(8px * var(--space-scale, 1)); margin: 0; }\n  .pr-card .ds-btn { margin-top: calc(12px * var(--space-scale, 1)); width: 100%; }\n\n  .pr-close { padding-top: calc(64px * var(--space-scale, 1)); padding-bottom: calc(72px * var(--space-scale, 1)); }\n  .pr-close-in { position: relative; display: grid; grid-template-columns: 1.2fr 0.8fr; gap: calc(40px * var(--space-scale, 1)); align-items: center; padding: calc(48px * var(--space-scale, 1)); border-radius: calc(var(--radius) + 14px); background: hsl(var(--band)); color: hsl(var(--band-foreground)); overflow: visible; }\n  .pr-close-in h2 { color: hsl(var(--band-foreground)); margin-top: calc(10px * var(--space-scale, 1)); max-width: 16em; }\n  .pr-close-in p { margin-top: calc(14px * var(--space-scale, 1)); max-width: 30em; color: hsl(var(--band-foreground) / 0.85); font-size: 16px; line-height: 1.6; }\n  .pr-close-in .ds-eyebrow { color: hsl(var(--band-foreground) / 0.8); }\n  .pr-close-act { display: flex; flex-direction: column; align-items: flex-start; gap: calc(12px * var(--space-scale, 1)); }\n  .pr-close-act .ds-btn { background: hsl(var(--band-foreground)); color: hsl(var(--band)); border-color: transparent; }\n  .pr-close-act a { color: hsl(var(--band-foreground)); font-size: 14px; }\n  .pr-ring { width: 260px; height: 260px; right: calc(-40px * var(--space-scale, 1)); bottom: calc(-40px * var(--space-scale, 1)); color: hsl(var(--band-foreground) / 0.16); }\n\n  @media (max-width: 980px) {\n    .pr-head { grid-template-columns: 1fr; align-items: start; gap: calc(24px * var(--space-scale, 1)); }\n    .pr-count { justify-self: start; text-align: left; }\n    .pr-grid { grid-template-columns: repeat(2, 1fr); }\n    .pr-close-in { grid-template-columns: 1fr; }\n  }\n  @media (max-width: 620px) {\n    .pr-grid { grid-template-columns: 1fr; }\n    .pr-links { display: none; }\n    .pr-count-big { font-size: 52px; }\n    .pr-close-in { padding: calc(32px * var(--space-scale, 1)); }\n    .pr-close-act .ds-btn { width: 100%; }\n  }\n</style><main data-screen=\"products\" data-eid=\"e1\">\n\n  <div data-eid=\"content\">\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e2\">\n      <header class=\"pr-top\" data-eid=\"e3\">\n        <a class=\"pr-brand\" data-goto=\"home\" data-eid=\"e4\">\n          <span class=\"pr-mark\" aria-hidden=\"true\" data-eid=\"e5\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 17c0-4 1.5-7 4-7s4 3 4 7\"></path><path d=\"M13 17c0-4 1.5-7 4-7\"></path><path d=\"M4 20h16\"></path></svg>\n          </span>\n          Donkey\n        </a>\n        <span class=\"ds-spacer\" data-eid=\"e6\"></span>\n        <nav class=\"pr-links ds-only-wide\" aria-label=\"Site pages\" data-eid=\"e7\">\n          <a data-goto=\"home\" data-eid=\"e8\">Home</a>\n          <a data-goto=\"products\" class=\"pr-here\" aria-current=\"page\" data-eid=\"e9\">Products</a>\n          <a data-goto=\"how-it-works\" data-eid=\"e10\">How it works</a>\n          <a data-goto=\"about\" data-eid=\"e11\">About</a>\n          <a data-goto=\"contact\" data-eid=\"e12\">Contact</a>\n        </nav>\n        <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e13\">\n          <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e14\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n          <button aria-label=\"Dark\" data-eid=\"e15\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n          <button aria-label=\"Auto\" data-eid=\"e16\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n        </div>\n        <button class=\"ds-btn ds-btn-sm\" data-goto=\"home\" data-eid=\"e17\">Sign up</button>\n        <details class=\"ds-menu ds-only-narrow\">\n          <summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary>\n          <div class=\"ds-menu-list\" data-eid=\"e18\">\n            <a data-goto=\"home\" data-eid=\"e19\">Home</a>\n            <a data-goto=\"products\" data-eid=\"e20\">Products</a>\n            <a data-goto=\"how-it-works\" data-eid=\"e21\">How it works</a>\n            <a data-goto=\"about\" data-eid=\"e22\">About</a>\n            <a data-goto=\"contact\" data-eid=\"e23\">Contact</a>\n            <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e24\">\n              <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e25\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n              <button aria-label=\"Dark\" data-eid=\"e26\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n              <button aria-label=\"Auto\" data-eid=\"e27\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n            </div>\n          </div>\n        </details>\n      </header>\n    </div>\n\n    <div class=\"ds-page\" data-eid=\"e28\">\n      <div class=\"pr-head\" data-eid=\"e29\">\n        <div data-eid=\"e30\">\n          <span class=\"ds-eyebrow\" data-eid=\"e31\">Everything in the shop</span>\n          <h1 class=\"ds-display\" data-eid=\"e32\">What Donkey <em data-eid=\"e33\">sells</em>.</h1>\n          <p class=\"pr-head-lead\" data-eid=\"e34\">Every product here, with what it costs. Pick what you like, then use Sign up to buy it in the shop.</p>\n        </div>\n        <div class=\"pr-count\" data-eid=\"e35\">\n          <span class=\"pr-count-big\" data-sample=\"\" data-eid=\"e36\">7</span>\n          <span class=\"pr-count-label\" data-eid=\"e37\">Products in the shop</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ds-page\" data-eid=\"e38\">\n      <div class=\"pr-grid\" data-eid=\"e39\">\n\n        <article class=\"pr-card\" data-eid=\"e40\">\n          <div class=\"ds-img pr-photo\" data-sample=\"\" data-eid=\"e41\"></div>\n          <div class=\"pr-body\" data-eid=\"e42\">\n            <h2 class=\"pr-name\" data-sample=\"Product#1.name\" data-eid=\"e43\">Donkey's own honey</h2>\n            <p class=\"pr-desc\" data-sample=\"Product#1.description\" data-eid=\"e44\">Raw honey from our own hives, jarred in small batches. A little grainy, the way real honey goes.</p>\n            <div class=\"pr-price-row\" data-eid=\"e45\">\n              <span class=\"pr-price\" data-sample=\"Product#1.price\" data-eid=\"e46\">£8.50</span>\n            </div>\n            <a class=\"ds-btn\" data-goto=\"home\" data-eid=\"e47\">Sign up</a>\n          </div>\n        </article>\n\n        <article class=\"pr-card\" data-eid=\"e48\">\n          <div class=\"ds-img pr-photo\" data-sample=\"\" data-eid=\"e49\"></div>\n          <div class=\"pr-body\" data-eid=\"e50\">\n            <h2 class=\"pr-name\" data-sample=\"Product#2.name\" data-eid=\"e51\">Sourdough loaf, baked this morning</h2>\n            <p class=\"pr-desc\" data-sample=\"Product#2.description\" data-eid=\"e52\">A slow rise and a dark crust. Baked each morning and sold the same day, so it never sits overnight.</p>\n            <div class=\"pr-price-row\" data-eid=\"e53\">\n              <span class=\"pr-price\" data-sample=\"Product#2.price\" data-eid=\"e54\">£4.20</span>\n            </div>\n            <a class=\"ds-btn\" data-goto=\"home\" data-eid=\"e55\">Sign up</a>\n          </div>\n        </article>\n\n        <article class=\"pr-card\" data-eid=\"e56\">\n          <div class=\"ds-img pr-photo\" data-sample=\"\" data-eid=\"e57\"></div>\n          <div class=\"pr-body\" data-eid=\"e58\">\n            <h2 class=\"pr-name\" data-sample=\"Product#3.name\" data-eid=\"e59\">Calendula hand salve</h2>\n            <p class=\"pr-desc\" data-sample=\"Product#3.description\" data-eid=\"e60\">A small tin of salve for dry hands, made with our own calendula. Keep it by the sink.</p>\n            <div class=\"pr-price-row\" data-eid=\"e61\">\n              <span class=\"pr-price\" data-sample=\"Product#3.price\" data-eid=\"e62\">£12.50</span>\n            </div>\n            <p class=\"pr-med\" data-sample=\"Product#3.medicineNote\" data-eid=\"e63\">Contains lanolin. Not for use on broken skin.</p>\n            <a class=\"ds-btn\" data-goto=\"home\" data-eid=\"e64\">Sign up</a>\n          </div>\n        </article>\n\n        <article class=\"pr-card\" data-eid=\"e65\">\n          <div class=\"ds-img pr-photo\" data-sample=\"\" data-eid=\"e66\"></div>\n          <div class=\"pr-body\" data-eid=\"e67\">\n            <h2 class=\"pr-name\" data-sample=\"Product#4.name\" data-eid=\"e68\">Field notes notebook</h2>\n            <p class=\"pr-desc\" data-sample=\"Product#4.description\" data-eid=\"e69\">A slim notebook with plain pages and a cloth cover, for lists and sketches alike.</p>\n            <div class=\"pr-price-row\" data-eid=\"e70\">\n              <span class=\"pr-price\" data-sample=\"Product#4.price\" data-eid=\"e71\">£9.00</span>\n            </div>\n            <a class=\"ds-btn\" data-goto=\"home\" data-eid=\"e72\">Sign up</a>\n          </div>\n        </article>\n\n        <article class=\"pr-card\" data-eid=\"e73\">\n          <div class=\"ds-img pr-photo\" data-sample=\"\" data-eid=\"e74\"></div>\n          <div class=\"pr-body\" data-eid=\"e75\">\n            <h2 class=\"pr-name\" data-sample=\"Product#5.name\" data-eid=\"e76\">Wool socks</h2>\n            <div class=\"pr-price-row\" data-eid=\"e77\">\n              <span class=\"pr-price\" data-sample=\"Product#5.price\" data-eid=\"e78\">£15.00</span>\n            </div>\n            <a class=\"ds-btn\" data-goto=\"home\" data-eid=\"e79\">Sign up</a>\n          </div>\n        </article>\n\n        <article class=\"pr-card\" data-eid=\"e80\">\n          <div class=\"ds-img pr-photo\" data-sample=\"\" data-eid=\"e81\"></div>\n          <div class=\"pr-body\" data-eid=\"e82\">\n            <h2 class=\"pr-name\" data-sample=\"Product#6.name\" data-eid=\"e83\">Apple and blackberry chutney</h2>\n            <p class=\"pr-desc\" data-sample=\"Product#6.description\" data-eid=\"e84\">Made from the orchard at the back of the farm, sharp and good with cheese or a hot pie.</p>\n            <div class=\"pr-price-row\" data-eid=\"e85\">\n              <span class=\"pr-price\" data-sample=\"Product#6.price\" data-eid=\"e86\">£6.40</span>\n            </div>\n            <a class=\"ds-btn\" data-goto=\"home\" data-eid=\"e87\">Sign up</a>\n          </div>\n        </article>\n\n        <article class=\"pr-card\" data-eid=\"e88\">\n          <div class=\"ds-img pr-photo\" data-sample=\"\" data-eid=\"e89\"></div>\n          <div class=\"pr-body\" data-eid=\"e90\">\n            <h2 class=\"pr-name\" data-sample=\"Product#7.name\" data-eid=\"e91\">Strawberry and elderflower cordial</h2>\n            <p class=\"pr-desc\" data-sample=\"Product#7.description\" data-eid=\"e92\">A tall bottle of cordial, made in June and bottled by hand. Mix it with cold water or fizz.</p>\n            <div class=\"pr-price-row\" data-eid=\"e93\">\n              <span class=\"pr-price\" data-sample=\"Product#7.price\" data-eid=\"e94\">£7.80</span>\n            </div>\n            <p class=\"pr-med\" data-sample=\"Product#7.medicineNote\" data-eid=\"e95\">High in sugar. Best kept in the fridge once opened.</p>\n            <a class=\"ds-btn\" data-goto=\"home\" data-eid=\"e96\">Sign up</a>\n          </div>\n        </article>\n\n      </div>\n    </div>\n\n    <div class=\"ds-page pr-close\" data-eid=\"e97\">\n      <div class=\"pr-close-in\" data-eid=\"e98\">\n        <svg class=\"ds-deco pr-ring\" viewBox=\"0 0 200 200\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"100\" cy=\"100\" r=\"96\"></circle><circle cx=\"100\" cy=\"100\" r=\"68\"></circle><circle cx=\"100\" cy=\"100\" r=\"40\"></circle></svg>\n        <div data-eid=\"e99\">\n          <span class=\"ds-eyebrow\" data-eid=\"e100\">Found something you like?</span>\n          <h2 class=\"ds-h1\" data-eid=\"e101\">Pick it, then sign up to buy it.</h2>\n          <p data-eid=\"e102\">Sign up opens Donkey app, where you add what you want to your basket and pay.</p>\n        </div>\n        <div class=\"pr-close-act\" data-eid=\"e103\">\n          <a class=\"ds-btn ds-btn-lg\" data-goto=\"home\" data-eid=\"e104\">Sign up</a>\n          <a data-goto=\"how-it-works\" data-eid=\"e105\">Read how buying works</a>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <section data-state=\"empty\" hidden=\"\" data-eid=\"e106\">\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e107\">\n      <header class=\"pr-top\" data-eid=\"e108\">\n        <a class=\"pr-brand\" data-goto=\"home\" data-eid=\"e109\">\n          <span class=\"pr-mark\" aria-hidden=\"true\" data-eid=\"e110\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 17c0-4 1.5-7 4-7s4 3 4 7\"></path><path d=\"M13 17c0-4 1.5-7 4-7\"></path><path d=\"M4 20h16\"></path></svg>\n          </span>\n          Donkey\n        </a>\n        <span class=\"ds-spacer\" data-eid=\"e111\"></span>\n        <nav class=\"pr-links ds-only-wide\" aria-label=\"Site pages\" data-eid=\"e112\">\n          <a data-goto=\"home\" data-eid=\"e113\">Home</a>\n          <a data-goto=\"products\" class=\"pr-here\" aria-current=\"page\" data-eid=\"e114\">Products</a>\n          <a data-goto=\"how-it-works\" data-eid=\"e115\">How it works</a>\n          <a data-goto=\"about\" data-eid=\"e116\">About</a>\n          <a data-goto=\"contact\" data-eid=\"e117\">Contact</a>\n        </nav>\n        <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e118\">\n          <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e119\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n          <button aria-label=\"Dark\" data-eid=\"e120\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n          <button aria-label=\"Auto\" data-eid=\"e121\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n        </div>\n        <button class=\"ds-btn ds-btn-sm\" data-goto=\"home\" data-eid=\"e122\">Sign up</button>\n      </header>\n    </div>\n    <div class=\"ds-page\" style=\"padding-top: calc(48px * var(--space-scale, 1)); padding-bottom: calc(64px * var(--space-scale, 1))\" data-eid=\"e123\">\n      <div class=\"ds-empty\" data-eid=\"e124\">\n        <div class=\"ds-empty-icon\" aria-hidden=\"true\" data-eid=\"e125\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 8h16l-1.5 10a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2Z\"></path><path d=\"M8 8V6a4 4 0 0 1 8 0v2\"></path></svg>\n        </div>\n        <h2 class=\"ds-h2\" data-eid=\"e126\">Our products are on their way. Check back soon.</h2>\n        <p class=\"ds-muted\" data-eid=\"e127\">In the meantime, read how buying from Donkey works.</p>\n        <a class=\"ds-btn ds-btn-secondary\" data-goto=\"how-it-works\" data-eid=\"e128\">How it works</a>\n      </div>\n    </div>\n  </section>\n\n  <div data-part=\"footer\" data-eid=\"e129\"></div>\n\n</main>","changes":[]}