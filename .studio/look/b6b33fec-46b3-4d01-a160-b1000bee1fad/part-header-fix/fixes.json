{"html":"<style>\n  .dn-header { position: sticky; top: 0; z-index: 20; background: hsl(var(--background) / 0.92); backdrop-filter: blur(10px); border-bottom: 1px solid hsl(var(--border)); }\n  .dn-header-bar { display: flex; align-items: center; gap: calc(20px * var(--space-scale, 1)); padding-top: calc(14px * var(--space-scale, 1)); padding-bottom: calc(14px * var(--space-scale, 1)); }\n  .dn-brand { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 800; font-size: 22px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; white-space: nowrap; }\n  .dn-mark { width: 34px; height: 34px; border-radius: calc(var(--radius) * 0.9); background: hsl(var(--brand)); color: hsl(var(--brand-foreground)); display: inline-grid; place-items: center; box-shadow: 0 6px 16px hsl(var(--main-900) / 0.28); flex: none; }\n  .dn-mark svg { width: 20px; height: 20px; }\n  .dn-links { display: flex; align-items: center; gap: calc(4px * var(--space-scale, 1)); }\n  .dn-links a { position: relative; padding: calc(8px * var(--space-scale, 1)) calc(12px * var(--space-scale, 1)); border-radius: var(--radius-button); font-size: 15px; font-weight: 600; color: hsl(var(--muted-foreground)); text-decoration: none; white-space: nowrap; transition: color .15s, background .15s; }\n  .dn-links a:hover { color: hsl(var(--foreground)); background: hsl(var(--primary) / 0.10); }\n  .dn-links a.dn-on { color: hsl(var(--primary-text)); background: hsl(var(--primary) / 0.14); }\n  .dn-acts { display: flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); }\n  .dn-mobile-theme { padding: calc(8px * var(--space-scale, 1)); border-top: 1px solid hsl(var(--border)); margin-top: calc(8px * var(--space-scale, 1)); }\n</style>\n<header class=\"dn-header\" data-eid=\"e1\">\n  <div class=\"ds-bar dn-header-bar\" data-eid=\"e2\">\n    <a class=\"dn-brand\" data-goto=\"home\" href=\"#\" data-eid=\"e3\">\n      <span class=\"dn-mark\" aria-hidden=\"true\" data-eid=\"e4\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 7V5.5A2.5 2.5 0 0 1 10.5 3h3A2.5 2.5 0 0 1 16 5.5V7\"></path><path d=\"M4 7h16v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7Z\"></path><path d=\"M4 7v4h16\"></path><path d=\"M9 17v-3M15 17v-3\"></path></svg></span>\n      <span class=\"ds-brand-text\" data-eid=\"e5\">Donkey website</span>\n    </a>\n    <nav class=\"dn-links ds-only-wide\" aria-label=\"Site pages\" data-eid=\"e6\">\n      <a data-goto=\"home\" href=\"#\" class=\"dn-on\" data-eid=\"e7\">Home</a>\n      <a data-goto=\"how-it-works\" href=\"#\" data-eid=\"e8\">How it works</a>\n      <a data-goto=\"products\" href=\"#\" data-eid=\"e9\">Products</a>\n      <a data-goto=\"about\" href=\"#\" data-eid=\"e10\">About</a>\n      <a data-goto=\"contact\" href=\"#\" data-eid=\"e11\">Contact</a>\n    </nav>\n    <span class=\"ds-spacer\" data-eid=\"e12\"></span>\n    <div class=\"dn-acts\" data-eid=\"e13\">\n      <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e14\">\n        <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e15\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n        <button aria-label=\"Dark\" data-eid=\"e16\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n        <button aria-label=\"Auto\" data-eid=\"e17\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n      </div>\n      <a class=\"ds-btn ds-btn-secondary ds-btn-sm ds-only-wide\" data-goto=\"editor-sign-in\" href=\"#\" data-eid=\"e18\">Sign in</a>\n      <a class=\"ds-btn ds-btn-sm\" data-goto=\"editor-sign-in\" href=\"#\" data-eid=\"e19\">Sign up</a>\n      <details class=\"ds-menu ds-only-narrow\">\n        <summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary>\n        <div class=\"ds-menu-list\" data-eid=\"e20\">\n          <a data-goto=\"home\" href=\"#\" data-eid=\"e21\">Home</a>\n          <a data-goto=\"how-it-works\" href=\"#\" data-eid=\"e22\">How it works</a>\n          <a data-goto=\"products\" href=\"#\" data-eid=\"e23\">Products</a>\n          <a data-goto=\"about\" href=\"#\" data-eid=\"e24\">About</a>\n          <a data-goto=\"contact\" href=\"#\" data-eid=\"e25\">Contact</a>\n          <div class=\"dn-mobile-theme\" data-eid=\"e26\">\n            <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e27\">\n              <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e28\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n              <button aria-label=\"Dark\" data-eid=\"e29\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n              <button aria-label=\"Auto\" data-eid=\"e30\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n            </div>\n          </div>\n        </div>\n      </details>\n    </div>\n  </div>\n</header>","changes":[]}