{"html":"<style>\n  .ct-top { display: flex; align-items: center; gap: calc(24px * var(--space-scale, 1)); padding-top: calc(16px * var(--space-scale, 1)); padding-bottom: calc(16px * var(--space-scale, 1)); }\n  .ct-brand { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 700; font-size: 20px; letter-spacing: -0.02em; color: hsl(var(--foreground)); text-decoration: none; }\n  .ct-mark { width: 32px; height: 32px; border-radius: 999px; background: hsl(var(--brand)); box-shadow: inset 0 0 0 7px hsl(var(--background)); position: relative; }\n  .ct-links { display: flex; gap: calc(24px * var(--space-scale, 1)); font-size: 15px; }\n  .ct-links a { color: hsl(var(--muted-foreground)); text-decoration: none; padding: calc(8px * var(--space-scale, 1)) 0; }\n  .ct-links a.is-here { color: hsl(var(--foreground)); font-weight: 600; }\n  .ct-hero { position: relative; display: grid; grid-template-columns: 1fr; gap: calc(32px * var(--space-scale, 1)); padding-top: calc(48px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1)); }\n  .ct-hero-lead { font-size: 18px; line-height: 1.6; color: hsl(var(--muted-foreground)); max-width: 30em; margin-top: calc(16px * var(--space-scale, 1)); }\n  .ct-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(16px * var(--space-scale, 1)); margin-top: calc(32px * var(--space-scale, 1)); }\n  .ct-card { display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1)); padding: calc(24px * var(--space-scale, 1)); border-radius: var(--card-radius); background: hsl(var(--card)); border: 1px solid hsl(var(--border)); box-shadow: var(--shadow); text-decoration: none; color: hsl(var(--foreground)); }\n  .ct-card:hover { border-color: hsl(var(--primary) / 0.5); }\n  .ct-card-label { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: hsl(var(--primary-text)); }\n  .ct-card-value { font-family: var(--font-heading); font-size: 24px; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }\n  .ct-card-note { font-size: 14px; color: hsl(var(--muted-foreground)); }\n  .ct-card-icon { width: 40px; height: 40px; border-radius: 999px; display: grid; place-items: center; background: hsl(var(--primary) / 0.12); color: hsl(var(--primary-text)); margin-bottom: calc(8px * var(--space-scale, 1)); }\n  .ct-address { margin-top: calc(16px * var(--space-scale, 1)); padding: calc(24px * var(--space-scale, 1)); border-radius: var(--card-radius); background: hsl(var(--muted)); border: 1px solid hsl(var(--border)); }\n  .ct-address p { margin: calc(8px * var(--space-scale, 1)) 0 0; font-size: 16px; line-height: 1.6; color: hsl(var(--foreground)); }\n  .ct-band { padding-top: calc(48px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1)); }\n  .ct-band-grid { display: grid; grid-template-columns: 1fr; gap: calc(24px * var(--space-scale, 1)); align-items: center; }\n  .ct-band h2 { color: hsl(var(--primary-foreground)); margin: 0; }\n  .ct-band .ct-band-text { color: hsl(var(--primary-foreground) / 0.85); font-size: 17px; line-height: 1.6; margin-top: calc(12px * var(--space-scale, 1)); max-width: 26em; }\n  .ct-band .ds-btn-secondary { background: transparent; color: hsl(var(--primary-foreground)); border-color: hsl(var(--primary-foreground) / 0.7); }\n  .ct-empty-wrap { display: grid; place-items: center; padding-top: calc(48px * var(--space-scale, 1)); }\n  @media (min-width: 720px) {\n    .ct-hero { grid-template-columns: 1.15fr 0.85fr; align-items: start; gap: calc(48px * var(--space-scale, 1)); }\n    .ct-cards { grid-template-columns: 1fr; margin-top: 0; }\n    .ct-band-grid { grid-template-columns: 1.3fr auto; }\n  }\n  @media (max-width: 719px) {\n    .ct-links { display: none; }\n  }\n</style><main data-screen=\"contact\" data-eid=\"e1\">\n  <div class=\"ds-page\" style=\"padding-bottom: 0\" data-eid=\"e2\">\n    <header class=\"ct-top\" data-eid=\"e3\">\n      <a class=\"ct-brand\" data-goto=\"home\" data-eid=\"e4\"><span class=\"ct-mark\" aria-hidden=\"true\" data-eid=\"e5\"></span>Donkey</a>\n      <nav class=\"ct-links ds-only-wide\" aria-label=\"Pages\" data-eid=\"e6\">\n        <a data-goto=\"home\" data-eid=\"e7\">Home</a>\n        <a data-goto=\"how-it-works\" data-eid=\"e8\">How it works</a>\n        <a data-goto=\"products\" data-eid=\"e9\">Products</a>\n        <a data-goto=\"about\" data-eid=\"e10\">About</a>\n        <a class=\"is-here\" aria-current=\"page\" data-eid=\"e11\">Contact</a>\n      </nav>\n      <span class=\"ds-spacer\" data-eid=\"e12\"></span>\n      <a class=\"ds-btn ds-btn-sm ds-only-wide\" data-goto=\"editor-sign-in\" data-eid=\"e13\">Sign up</a>\n      <details class=\"ds-menu ds-only-narrow\"><summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary><div class=\"ds-menu-list\" data-eid=\"e14\"><a data-goto=\"home\" data-eid=\"e15\">Home</a><a data-goto=\"how-it-works\" data-eid=\"e16\">How it works</a><a data-goto=\"products\" data-eid=\"e17\">Products</a><a data-goto=\"about\" data-eid=\"e18\">About</a><a data-goto=\"contact\" data-eid=\"e19\">Contact</a><a data-goto=\"editor-sign-in\" data-eid=\"e20\">Sign up</a><div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e21\"><button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e22\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button><button aria-label=\"Dark\" data-eid=\"e23\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button><button aria-label=\"Auto\" data-eid=\"e24\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button></div></div></details>\n      <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e25\">\n        <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e26\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n        <button aria-label=\"Dark\" data-eid=\"e27\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n        <button aria-label=\"Auto\" data-eid=\"e28\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n      </div>\n    </header>\n  </div>\n\n  <div class=\"ds-page\" data-eid=\"e29\">\n    <div class=\"ds-page-head\" data-eid=\"e30\">\n      <div data-eid=\"e31\">\n        <span class=\"ds-eyebrow\" data-eid=\"e32\">Contact</span>\n        <h1 class=\"ds-h1\" style=\"margin-top: calc(8px * var(--space-scale, 1))\" data-eid=\"e33\">Talk to Donkey.</h1>\n        <p class=\"ds-text ds-muted\" style=\"margin-top: calc(8px * var(--space-scale, 1)); max-width: 34em\" data-eid=\"e34\">A question about an order, a product or a return? Reach us by email or phone and a person will answer.</p>\n      </div>\n    </div>\n\n    <section class=\"ct-hero\" data-eid=\"e35\">\n      <div data-eid=\"e36\">\n        <span class=\"ds-label-caps\" data-eid=\"e37\">Ways to reach us</span>\n        <p class=\"ct-hero-lead\" data-eid=\"e38\">Write to us and we reply within one working day. If it is easier to talk, call during shop hours.</p>\n        <div class=\"ct-cards\" data-eid=\"e39\">\n          <a class=\"ct-card\" href=\"#\" data-eid=\"e40\">\n            <span class=\"ct-card-icon\" aria-hidden=\"true\" data-eid=\"e41\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"></rect><path d=\"m3.5 6.5 8.5 6 8.5-6\"></path></svg></span>\n            <span class=\"ct-card-label\" data-eid=\"e42\">Email</span>\n            <span class=\"ct-card-value\" data-sample=\"PageWording.contact.email\" data-eid=\"e43\">hello@donkey.example</span>\n            <span class=\"ct-card-note\" data-eid=\"e44\">Orders, products and returns.</span>\n          </a>\n          <a class=\"ct-card\" href=\"#\" data-eid=\"e45\">\n            <span class=\"ct-card-icon\" aria-hidden=\"true\" data-eid=\"e46\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M5 4h3.5l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5V19a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z\"></path></svg></span>\n            <span class=\"ct-card-label\" data-eid=\"e47\">Phone</span>\n            <span class=\"ct-card-value\" data-sample=\"PageWording.contact.phone\" data-eid=\"e48\">01234 567890</span>\n            <span class=\"ct-card-note\" data-eid=\"e49\">Monday to Friday, 9am to 5pm.</span>\n          </a>\n        </div>\n\n        <div class=\"ct-address\" data-eid=\"e50\">\n          <span class=\"ds-label-caps\" data-eid=\"e51\">Where we are</span>\n          <p data-sample=\"PageWording.contact.address\" data-eid=\"e52\">Donkey<br>14 Mill Lane<br>Bristol BS1 4QT</p>\n        </div>\n      </div>\n\n      <div class=\"ds-glow\" style=\"position: relative; border-radius: var(--card-radius); padding: calc(32px * var(--space-scale, 1)); background: hsl(var(--primary) / 0.1); border: 1px solid hsl(var(--border));\" data-eid=\"e53\">\n        <span class=\"ds-label-caps\" data-eid=\"e54\">Before you write</span>\n        <h2 class=\"ds-h3\" style=\"margin-top: calc(8px * var(--space-scale, 1))\" data-eid=\"e55\">Check the answers that cover most questions.</h2>\n        <p class=\"ds-text ds-muted\" style=\"margin-top: calc(8px * var(--space-scale, 1))\" data-eid=\"e56\">Delivery times and how returns work are on the How it works page. Prices for everything we sell are on Products.</p>\n        <div class=\"ds-row\" style=\"margin-top: calc(24px * var(--space-scale, 1))\" data-eid=\"e57\">\n          <a class=\"ds-btn ds-btn-secondary\" data-goto=\"how-it-works\" data-eid=\"e58\">How it works</a>\n          <a class=\"ds-btn ds-btn-ghost\" data-goto=\"products\" data-eid=\"e59\">Products</a>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <section class=\"ds-band-bold ct-band\" data-eid=\"e60\">\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e61\">\n      <div class=\"ct-band-grid\" data-eid=\"e62\">\n        <div data-eid=\"e63\">\n          <h2 class=\"ds-h2\" data-eid=\"e64\">Ready to shop?</h2>\n          <p class=\"ct-band-text\" data-eid=\"e65\">Sign up once and the whole shop opens to you, with every product and price in pounds.</p>\n        </div>\n        <a class=\"ds-btn ds-btn-lg ds-btn-secondary\" data-goto=\"editor-sign-in\" data-eid=\"e66\">Sign up</a>\n      </div>\n    </div>\n  </section>\n\n  <div data-part=\"footer\" data-eid=\"e67\"></div>\n\n  <section data-state=\"empty\" hidden=\"\" data-replaces=\"content\" data-eid=\"content\">\n    <div class=\"ds-page\" data-eid=\"e68\">\n      <div class=\"ds-page-head\" data-eid=\"e69\">\n        <div data-eid=\"e70\">\n          <span class=\"ds-eyebrow\" data-eid=\"e71\">Contact</span>\n          <h1 class=\"ds-h1\" style=\"margin-top: calc(8px * var(--space-scale, 1))\" data-eid=\"e72\">Talk to Donkey.</h1>\n        </div>\n      </div>\n      <div class=\"ds-empty ct-empty-wrap\" style=\"margin-top: calc(32px * var(--space-scale, 1))\" data-eid=\"e73\">\n        <div class=\"ds-empty-icon\" aria-hidden=\"true\" data-eid=\"e74\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M5 4h3.5l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5V19a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z\"></path></svg></div>\n        <p class=\"ds-text\" style=\"margin-top: calc(16px * var(--space-scale, 1)); font-size: 18px\" data-eid=\"e75\">Contact details are on their way. Check back soon.</p>\n        <a class=\"ds-btn\" data-goto=\"products\" style=\"margin-top: calc(24px * var(--space-scale, 1))\" data-eid=\"e76\">See products</a>\n      </div>\n    </div>\n  </section>\n</main>","changes":[]}