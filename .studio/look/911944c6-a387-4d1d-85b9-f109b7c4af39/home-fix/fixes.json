{"html":"<style>\n  /* Home page: bold family, brand #1c825d */\n  .hm-root {\n    background: hsl(var(--background));\n    color: hsl(var(--foreground));\n    overflow-x: clip;\n  }\n\n  /* The screen's own top row: the logo on the left, the Sign in button on the right */\n  .hm-topbar { background: hsl(var(--background)); border-bottom: 1px solid hsl(var(--border)); }\n  .hm-top { display: flex; align-items: center; gap: calc(24px * var(--space-scale, 1)); padding: calc(12px * var(--space-scale, 1)) 0; }\n  .hm-brand { display: inline-flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 800; font-size: 22px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; white-space: nowrap; }\n  .hm-mark { width: 34px; height: 34px; border-radius: 999px; background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); display: inline-flex; align-items: center; justify-content: center; flex: none; }\n  .hm-links { display: flex; gap: calc(24px * var(--space-scale, 1)); font-size: 15px; }\n  .hm-links a { color: hsl(var(--muted-foreground)); text-decoration: none; font-weight: 600; }\n  .hm-links a:hover { color: hsl(var(--primary-text)); }\n  .hm-top-actions { display: flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); }\n\n  /* Hero: main move, huge type against a framed product panel */\n  .hm-hero { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: calc(48px * var(--space-scale, 1)); align-items: center; padding: calc(48px * var(--space-scale, 1)) 0 calc(64px * var(--space-scale, 1)); position: relative; }\n  .hm-hero-copy { position: relative; }\n  .hm-display { font-family: var(--font-heading); font-size: clamp(44px, 7.3vw, 88px); line-height: 0.95; letter-spacing: -0.045em; margin: calc(16px * var(--space-scale, 1)) 0 0; font-weight: 800; }\n  .hm-intro { margin: calc(24px * var(--space-scale, 1)) 0 calc(32px * var(--space-scale, 1)); max-width: 30em; font-size: 18px; line-height: 1.6; color: hsl(var(--muted-foreground)); }\n\n  /* Hero product panel */\n  .hm-panel { position: relative; }\n  .hm-card { border-radius: calc(var(--radius) + 10px); box-shadow: var(--shadow); background: hsl(var(--card)); padding: calc(24px * var(--space-scale, 1)); border: 1px solid hsl(var(--border)); }\n  .hm-shot { border-radius: calc(var(--radius) + 2px); overflow: hidden; aspect-ratio: 4 / 3; }\n  .hm-shot .ds-img { width: 100%; height: 100%; }\n  .hm-card-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: calc(16px * var(--space-scale, 1)); margin-top: calc(16px * var(--space-scale, 1)); }\n  .hm-price { font-family: var(--font-heading); font-size: 34px; letter-spacing: -0.03em; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; color: hsl(var(--foreground)); }\n\n  /* Band: strong colour, the promise and the midpoint Sign up.\n     A darker field of the brand carries the band so white text clears contrast. */\n  .hm-band {\n    background: hsl(var(--main-950));\n    color: hsl(var(--primary-foreground));\n    border-radius: 0;\n    position: relative;\n    overflow: hidden;\n  }\n  .hm-band-inner { padding: calc(48px * var(--space-scale, 1)) 0; position: relative; }\n  .hm-band-grid { display: grid; grid-template-columns: auto 1fr auto; gap: calc(32px * var(--space-scale, 1)); align-items: center; position: relative; }\n  .hm-band .hm-eyebrow { color: hsl(var(--main-100)); }\n  .hm-band h2 { color: hsl(var(--primary-foreground)); }\n  .hm-band .hm-band-text { color: hsl(var(--main-100)); }\n  .hm-band .hm-badge { display: flex; flex-direction: column; justify-content: center; align-items: center; width: 132px; height: 132px; border-radius: 999px; background: hsl(var(--primary-foreground) / 0.12); border: 1.5px dashed hsl(var(--primary-foreground) / 0.45); flex: none; }\n  .hm-band .hm-badge b { font-family: var(--font-heading); font-size: 40px; letter-spacing: -0.04em; line-height: 1; color: hsl(var(--primary-foreground)); }\n  .hm-band .hm-badge small { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: hsl(var(--primary-foreground)); margin-top: 6px; }\n  .hm-band .ds-btn-solid-white { background: hsl(var(--primary-foreground)); color: hsl(var(--main-950)); border: 1.5px solid hsl(var(--primary-foreground)); }\n  .hm-band .ds-btn-solid-white:hover { background: transparent; color: hsl(var(--primary-foreground)); }\n  .hm-band .hm-band-glow {\n    position: absolute;\n    top: calc(-64px * var(--space-scale, 1));\n    right: calc(-48px * var(--space-scale, 1));\n    width: 420px;\n    height: 420px;\n    border-radius: 999px;\n    background: radial-gradient(circle at center, hsl(var(--brand) / 0.55), hsl(var(--brand) / 0) 68%);\n  }\n\n  /* What shoppers can do */\n  .hm-tasks { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: calc(32px * var(--space-scale, 1)); padding: calc(48px * var(--space-scale, 1)) 0; align-items: start; }\n  .hm-task { display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1)); }\n  .hm-task .hm-num { font-family: var(--font-heading); font-size: 13px; font-weight: 800; letter-spacing: 0.1em; color: hsl(var(--primary-text)); padding-top: calc(4px * var(--space-scale, 1)); }\n  .hm-task h3 { margin: 0; }\n  .hm-task p { margin: 0; font-size: 15px; line-height: 1.55; color: hsl(var(--muted-foreground)); }\n\n  /* Closing call */\n  .hm-close { padding: calc(16px * var(--space-scale, 1)) 0 calc(64px * var(--space-scale, 1)); }\n  .hm-close-inner { background: hsl(var(--primary) / 0.1); border-radius: calc(var(--radius) + 10px); padding: calc(48px * var(--space-scale, 1)); display: grid; grid-template-columns: 1fr auto; gap: calc(32px * var(--space-scale, 1)); align-items: center; position: relative; overflow: hidden; }\n  .hm-close h2 { max-width: 20em; margin: calc(8px * var(--space-scale, 1)) 0 0; }\n\n  @media (max-width: 900px) {\n    .hm-hero { grid-template-columns: 1fr; gap: calc(32px * var(--space-scale, 1)); padding-top: calc(24px * var(--space-scale, 1)); }\n    .hm-links { display: none; }\n    .hm-band-grid { grid-template-columns: 1fr; gap: calc(24px * var(--space-scale, 1)); }\n    .hm-band .hm-badge { width: 100%; height: auto; border-radius: calc(var(--radius) + 4px); flex-direction: row; gap: calc(12px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)); justify-content: flex-start; }\n    .hm-band .hm-badge b { font-size: 32px; }\n    .hm-band .hm-badge small { margin-top: 0; }\n    .hm-tasks { grid-template-columns: 1fr; gap: calc(24px * var(--space-scale, 1)); }\n    .hm-close-inner { grid-template-columns: 1fr; padding: calc(32px * var(--space-scale, 1)) calc(24px * var(--space-scale, 1)); }\n  }\n  @media (max-width: 520px) {\n    .hm-top { gap: calc(8px * var(--space-scale, 1)); justify-content: space-between; }\n    .hm-brand { font-size: 20px; }\n    .hm-top-actions .hm-signin { display: none; }\n    .hm-display { font-size: clamp(40px, 12vw, 60px); }\n  }\n</style><main data-screen=\"home\" class=\"hm-root\" data-eid=\"e1\">\n\n  <div class=\"hm-topbar ds-only-wide\" data-eid=\"e55\">\n    <div class=\"ds-bar hm-top\" data-eid=\"e56\">\n      <a class=\"hm-brand\" data-goto=\"home\" data-eid=\"e57\"><span class=\"hm-mark\" aria-hidden=\"true\" data-eid=\"e58\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" data-eid=\"e59\"><path d=\"M5 9h14v11H5zM9 9V6a3 3 0 0 1 6 0v3\"></path></svg></span>Donkey website</a>\n      <nav class=\"hm-links\" data-eid=\"e60\"><a data-goto=\"home\" data-eid=\"e61\">Home</a><a data-goto=\"how-it-works\" data-eid=\"e62\">How it works</a><a data-goto=\"products\" data-eid=\"e63\">Products</a><a data-goto=\"about\" data-eid=\"e64\">About</a><a data-goto=\"contact\" data-eid=\"e65\">Contact</a></nav>\n      <span class=\"ds-spacer\" data-eid=\"e66\"></span>\n      <div class=\"hm-top-actions\" data-eid=\"e67\">\n        <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e68\">\n          <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e69\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" data-eid=\"e70\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n          <button aria-label=\"Dark\" data-eid=\"e71\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" data-eid=\"e72\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n          <button aria-label=\"Auto\" data-eid=\"e73\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" data-eid=\"e74\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n        </div>\n        <a class=\"ds-btn ds-btn-ghost hm-signin\" data-goto=\"editor-sign-in\" data-eid=\"e75\">Sign in</a>\n        <a class=\"ds-btn\" data-goto=\"editor-sign-in\" data-eid=\"e76\">Sign up</a>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ds-only-narrow\" data-eid=\"e77\">\n    <div class=\"ds-bar hm-top\" data-eid=\"e78\">\n      <a class=\"hm-brand\" data-goto=\"home\" data-eid=\"e79\"><span class=\"hm-mark\" aria-hidden=\"true\" data-eid=\"e80\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" data-eid=\"e81\"><path d=\"M5 9h14v11H5zM9 9V6a3 3 0 0 1 6 0v3\"></path></svg></span>Donkey website</a>\n      <span class=\"ds-spacer\" data-eid=\"e82\"></span>\n      <a class=\"ds-btn ds-btn-sm\" data-goto=\"editor-sign-in\" data-eid=\"e83\">Sign up</a>\n      <details class=\"ds-menu\" data-eid=\"e84\">\n        <summary class=\"ds-btn ds-btn-ghost ds-btn-icon\" aria-label=\"Open the menu\" data-eid=\"e85\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" data-eid=\"e86\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary>\n        <div class=\"ds-menu-list\" data-eid=\"e87\">\n          <a data-goto=\"home\" data-eid=\"e88\">Home</a><a data-goto=\"how-it-works\" data-eid=\"e89\">How it works</a><a data-goto=\"products\" data-eid=\"e90\">Products</a><a data-goto=\"about\" data-eid=\"e91\">About</a><a data-goto=\"contact\" data-eid=\"e92\">Contact</a>\n          <a data-goto=\"editor-sign-in\" data-eid=\"e93\">Sign in</a>\n          <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e94\">\n            <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e95\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" data-eid=\"e96\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n            <button aria-label=\"Dark\" data-eid=\"e97\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" data-eid=\"e98\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n            <button aria-label=\"Auto\" data-eid=\"e99\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" data-eid=\"e100\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n          </div>\n        </div>\n      </details>\n    </div>\n  </div>\n\n  <div class=\"ds-page\" data-eid=\"e3\">\n    <section class=\"hm-hero\" data-eid=\"e4\">\n      <div class=\"hm-hero-copy\" data-eid=\"e5\">\n        <h1 class=\"hm-display\" data-sample=\"PageWording#home.heading\" data-eid=\"e7\">Good things,<br>at honest prices.</h1>\n        <p class=\"hm-intro\" data-sample=\"PageWording#home.intro\" data-eid=\"e8\">Donkey sells useful things for home and kitchen: simple, sturdy, and priced so you don't have to think twice.</p>\n        <div class=\"ds-row\" data-eid=\"e9\">\n          <a class=\"ds-btn ds-btn-lg\" data-goto=\"products\" data-eid=\"e10\">See the products</a>\n          <a class=\"ds-btn ds-btn-secondary ds-btn-lg\" data-goto=\"how-it-works\" data-eid=\"e11\">How it works</a>\n        </div>\n      </div>\n      <div class=\"hm-panel\" data-eid=\"e12\">\n        <div class=\"hm-card\" data-eid=\"e13\">\n          <div class=\"hm-shot\" data-eid=\"e14\"><div class=\"ds-img\" data-sample=\"\" data-eid=\"e15\"></div></div>\n          <div class=\"hm-card-foot\" data-eid=\"e16\">\n            <div data-eid=\"e17\">\n              <span class=\"ds-label-caps\" data-sample=\"Product#1.name\" data-eid=\"e18\">The enamel pot</span>\n              <div class=\"ds-muted\" style=\"font-size: 14px; margin-top: 4px\" data-sample=\"Product#1.description\" data-eid=\"e19\">Holds four litres. Works on every hob.</div>\n            </div>\n            <div class=\"hm-price\" data-sample=\"Product#1.pricePence\" data-eid=\"e20\">£38.00</div>\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <section class=\"ds-band hm-band\" data-eid=\"e21\">\n    <div class=\"ds-deco hm-band-glow\" aria-hidden=\"true\" data-eid=\"e101\"></div>\n    <div class=\"ds-page hm-band-inner\" data-eid=\"e22\">\n      <div class=\"hm-band-grid\" data-eid=\"e23\">\n        <div class=\"hm-badge\" data-eid=\"e24\"><b data-eid=\"e25\" data-sample=\"\">£</b><small data-eid=\"e26\">pounds</small></div>\n        <div data-eid=\"e27\">\n          <span class=\"ds-eyebrow hm-eyebrow\" data-eid=\"e28\">What shoppers do here</span>\n          <h2 class=\"ds-h2\" style=\"margin-top: 8px\" data-eid=\"e29\">Browse the shelf, then step into the shop.</h2>\n          <p class=\"hm-band-text\" style=\"margin-top: 10px; max-width: 34em\" data-eid=\"e30\">See every product and its price in pounds, the bare price only. When one catches your eye, sign up and buy it in Donkey app.</p>\n        </div>\n        <div data-eid=\"e31\">\n          <a class=\"ds-btn ds-btn-lg ds-btn-solid-white\" data-goto=\"editor-sign-in\" data-eid=\"e32\">Sign up</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"ds-page\" data-eid=\"e33\">\n    <section class=\"hm-tasks\" data-eid=\"e34\">\n      <div class=\"hm-task\" data-eid=\"e35\">\n        <span class=\"hm-num\" data-eid=\"e36\">01</span>\n        <h3 class=\"ds-h3\" data-eid=\"e37\">Look around</h3>\n        <p data-eid=\"e38\">Every product the team keeps on the shelf, with a short description and its price.</p>\n      </div>\n      <div class=\"hm-task\" data-eid=\"e39\">\n        <span class=\"hm-num\" data-eid=\"e40\">02</span>\n        <h3 class=\"ds-h3\" data-eid=\"e41\">Know the score</h3>\n        <p data-eid=\"e42\">Read the delivery and returns details before you commit to anything.</p>\n      </div>\n      <div class=\"hm-task\" data-eid=\"e43\">\n        <span class=\"hm-num\" data-eid=\"e44\">03</span>\n        <h3 class=\"ds-h3\" data-eid=\"e45\">Sign up and buy</h3>\n        <p data-eid=\"e46\">The Sign up button opens Donkey app, where the buying happens.</p>\n      </div>\n    </section>\n  </div>\n\n  <div class=\"ds-page hm-close\" data-eid=\"e47\">\n    <div class=\"hm-close-inner\" data-eid=\"e48\">\n      <div data-eid=\"e49\">\n        <span class=\"ds-eyebrow\" data-eid=\"e50\">Ready when you are</span>\n        <h2 class=\"ds-h1\" data-eid=\"e51\">Take the shop with you.</h2>\n        <p class=\"ds-muted\" style=\"margin-top: 12px; max-width: 32em\" data-eid=\"e52\">Sign up once and every product and price is a tap away.</p>\n      </div>\n      <div data-eid=\"e53\">\n        <a class=\"ds-btn ds-btn-lg\" data-goto=\"editor-sign-in\" data-eid=\"e54\">Sign up</a>\n      </div>\n    </div>\n  </div>\n\n  <div data-part=\"footer\" data-eid=\"e2\"></div>\n</main>","changes":[{"fix":"link","what":"data-goto \"sign-in\" → \"editor-sign-in\"","from":"sign-in","to":"editor-sign-in"},{"fix":"link","what":"data-goto \"sign-in\" → \"editor-sign-in\"","from":"sign-in","to":"editor-sign-in"},{"fix":"link","what":"data-goto \"sign-in\" → \"editor-sign-in\"","from":"sign-in","to":"editor-sign-in"},{"fix":"link","what":"data-goto \"sign-in\" → \"editor-sign-in\"","from":"sign-in","to":"editor-sign-in"},{"fix":"link","what":"data-goto \"sign-in\" → \"editor-sign-in\"","from":"sign-in","to":"editor-sign-in"},{"fix":"link","what":"data-goto \"sign-in\" → \"editor-sign-in\"","from":"sign-in","to":"editor-sign-in"}]}