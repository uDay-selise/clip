{"html":"<style>\n  .dn-top { display: flex; align-items: center; gap: calc(24px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) 0; }\n  .dn-brand { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 700; font-size: 20px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; }\n  .dn-mark { width: 34px; height: 34px; border-radius: 999px; background: hsl(var(--primary)); display: inline-flex; align-items: center; justify-content: center; color: hsl(var(--primary-foreground)); flex: none; }\n  .dn-links { display: flex; gap: calc(24px * var(--space-scale, 1)); font-size: 15px; }\n  .dn-links a { color: hsl(var(--muted-foreground)); text-decoration: none; padding: 10px 0; }\n  .dn-links a:hover { color: hsl(var(--foreground)); }\n\n  .dn-hero { position: relative; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: calc(48px * var(--space-scale, 1)); align-items: center; padding: calc(56px * var(--space-scale, 1)) 0 calc(64px * var(--space-scale, 1)); }\n  .dn-hero h1 { margin: calc(16px * var(--space-scale, 1)) 0 0; font-size: clamp(44px, 7.4vw, 92px); line-height: 0.98; letter-spacing: -0.04em; }\n  .dn-hero h1 em { font-style: normal; color: hsl(var(--primary-text)); }\n  .dn-lead { margin: calc(20px * var(--space-scale, 1)) 0 calc(28px * var(--space-scale, 1)); max-width: 30em; font-size: 18px; line-height: 1.55; color: hsl(var(--muted-foreground)); }\n  .dn-hero-art { position: relative; aspect-ratio: 4 / 5; border-radius: calc(var(--radius) * 2); background: linear-gradient(160deg, hsl(var(--main-100)), hsl(var(--main-300))); box-shadow: var(--shadow); display: flex; align-items: center; justify-content: center; min-width: 0; }\n  .dark .dn-hero-art { background: linear-gradient(160deg, hsl(var(--main-900)), hsl(var(--main-800))); }\n  .dn-hero-art .dn-art-img { position: absolute; inset: calc(20px * var(--space-scale, 1)); border-radius: var(--card-radius); }\n  .dn-hero-art .dn-price-card { position: relative; align-self: flex-end; margin: 0 calc(-32px * var(--space-scale, 1)) calc(32px * var(--space-scale, 1)) 0; }\n  .dn-price-card { background: hsl(var(--card)); color: hsl(var(--foreground)); border-radius: var(--card-radius); padding: calc(16px * var(--space-scale, 1)) calc(20px * var(--space-scale, 1)); box-shadow: var(--shadow); }\n  .dn-price-card b { display: block; font-family: var(--font-heading); font-size: 30px; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }\n\n  .dn-band { padding: calc(56px * var(--space-scale, 1)) 0; }\n  .dn-band h2 { margin: calc(12px * var(--space-scale, 1)) 0 0; font-size: clamp(32px, 4.4vw, 52px); line-height: 1.02; letter-spacing: -0.035em; max-width: 16em; }\n  .dn-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(16px * var(--space-scale, 1)); margin-top: calc(40px * var(--space-scale, 1)); }\n  .dn-tile { background: hsl(var(--card)); border-radius: var(--card-radius); padding: calc(28px * var(--space-scale, 1)); box-shadow: var(--shadow); display: flex; flex-direction: column; gap: calc(10px * var(--space-scale, 1)); }\n  .dn-tile .dn-num { font-family: var(--font-heading); font-size: 44px; line-height: 1; letter-spacing: -0.04em; color: hsl(var(--primary-text)); }\n  .dn-tile h3 { margin: 0; }\n  .dn-tile p { margin: 0; font-size: 15px; line-height: 1.55; color: hsl(var(--muted-foreground)); }\n  .dn-tile.dn-tile-accent { background: hsl(var(--accent)); }\n  .dn-tile.dn-tile-accent p { color: hsl(var(--accent-foreground) / 0.85); }\n  .dn-tile.dn-tile-accent .dn-num, .dn-tile.dn-tile-accent h3 { color: hsl(var(--accent-foreground)); }\n\n  .dn-split { display: grid; grid-template-columns: 1fr 1fr; gap: calc(48px * var(--space-scale, 1)); align-items: center; padding: calc(64px * var(--space-scale, 1)) 0; }\n  .dn-split h2 { margin: calc(12px * var(--space-scale, 1)) 0 calc(20px * var(--space-scale, 1)); font-size: clamp(30px, 4vw, 46px); line-height: 1.04; letter-spacing: -0.035em; }\n  .dn-list { margin: 0; padding: 0; list-style: none; display: grid; gap: calc(14px * var(--space-scale, 1)); }\n  .dn-list li { display: flex; gap: calc(14px * var(--space-scale, 1)); align-items: flex-start; font-size: 16px; line-height: 1.5; }\n  .dn-dot { flex: none; width: 26px; height: 26px; border-radius: 999px; background: hsl(var(--primary) / 0.14); color: hsl(var(--primary-text)); display: inline-flex; align-items: center; justify-content: center; margin-top: 1px; }\n  .dn-preview { border-radius: calc(var(--radius) * 2); background: hsl(var(--muted)); padding: calc(24px * var(--space-scale, 1)); box-shadow: var(--shadow); display: grid; gap: calc(12px * var(--space-scale, 1)); min-width: 0; }\n  .dn-preview-row { display: flex; align-items: center; gap: calc(16px * var(--space-scale, 1)); background: hsl(var(--card)); border-radius: var(--card-radius); padding: calc(14px * var(--space-scale, 1)) calc(16px * var(--space-scale, 1)); min-width: 0; }\n  .dn-preview-row .dn-thumb { width: 56px; height: 56px; flex: none; border-radius: var(--radius); }\n  .dn-preview-row .dn-row-text { min-width: 0; }\n  .dn-preview-row b { display: block; font-size: 16px; }\n  .dn-preview-row span.sm { display: block; font-size: 13px; color: hsl(var(--muted-foreground)); }\n  .dn-preview-row .dn-price { margin-left: auto; font-family: var(--font-heading); font-weight: 700; font-size: 18px; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; white-space: nowrap; }\n\n  .dn-close { text-align: center; padding: calc(64px * var(--space-scale, 1)) 0; position: relative; }\n  .dn-close h2 { margin: calc(12px * var(--space-scale, 1)) auto calc(24px); font-size: clamp(38px, 6vw, 72px); line-height: 1; letter-spacing: -0.04em; max-width: 12em; }\n\n  @media (max-width: 900px) {\n    .dn-hero, .dn-split { grid-template-columns: 1fr; gap: calc(32px * var(--space-scale, 1)); }\n    .dn-tiles { grid-template-columns: 1fr; }\n    .dn-hero-art { aspect-ratio: 16 / 10; }\n    .dn-links { display: none; }\n    .dn-hero-art .dn-art-img { inset: calc(12px * var(--space-scale, 1)); }\n    .dn-hero-art .dn-price-card { margin: 0 0 calc(16px * var(--space-scale, 1)) 0; align-self: flex-end; }\n  }\n</style><main data-screen=\"home\" data-eid=\"e1\">\n  <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e2\">\n    <header class=\"dn-top\" data-eid=\"e3\">\n      <a class=\"dn-brand\" data-goto=\"home\" data-eid=\"e4\"><span class=\"dn-mark\" aria-hidden=\"true\" data-eid=\"e5\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M6 9c0-2.2 1.6-4 3.6-4h4.8C16.4 5 18 6.8 18 9v6c0 2.2-1.6 4-3.6 4H9.6C7.6 19 6 17.2 6 15Z\"></path><path d=\"M9.5 10.5v3M14.5 10.5v3\"></path></svg></span>Donkey website</a>\n      <nav class=\"dn-links ds-only-wide\" data-eid=\"e6\"><a data-goto=\"home\" data-eid=\"e7\">Home</a><a data-goto=\"how-it-works\" data-eid=\"e8\">How it works</a><a data-goto=\"about\" data-eid=\"e9\">About</a><a data-goto=\"contact\" data-eid=\"e10\">Contact</a></nav>\n      <span class=\"ds-spacer\" data-eid=\"e11\"></span>\n      <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e12\">\n        <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e13\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n        <button aria-label=\"Dark\" data-eid=\"e14\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n        <button aria-label=\"Auto\" data-eid=\"e15\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n      </div>\n      <button class=\"ds-btn ds-btn-secondary ds-only-wide\" data-goto=\"editor-sign-in\" data-eid=\"e16\">Sign in</button>\n      <details class=\"ds-menu ds-only-narrow\"><summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary><div class=\"ds-menu-list\" data-eid=\"e17\"><a data-goto=\"home\" data-eid=\"e18\">Home</a><a data-goto=\"how-it-works\" data-eid=\"e19\">How it works</a><a data-goto=\"about\" data-eid=\"e20\">About</a><a data-goto=\"contact\" data-eid=\"e21\">Contact</a><a data-goto=\"editor-sign-in\" data-eid=\"e22\">Sign in</a><div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e23\"><button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e24\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button><button aria-label=\"Dark\" data-eid=\"e25\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button><button aria-label=\"Auto\" data-eid=\"e26\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button></div></div></details>\n    </header>\n  </div>\n\n  <div class=\"ds-page dn-hero\" data-eid=\"e27\">\n    <div data-eid=\"e28\">\n      <span class=\"ds-eyebrow\" data-eid=\"e29\">Donkey shop</span>\n      <h1 data-eid=\"e30\">Good things, <em data-eid=\"e31\">fair prices.</em></h1>\n      <p class=\"dn-lead\" data-sample=\"PageWording#home.intro\" data-eid=\"e32\">Donkey sells everyday goods chosen with care: homeware, pantry staples and small gifts. Browse what we have, see what it costs, and sign up to buy.</p>\n      <div class=\"ds-row\" data-eid=\"e33\">\n        <button class=\"ds-btn ds-btn-lg\" data-goto=\"products\" data-eid=\"e34\">Sign up</button>\n        <button class=\"ds-btn ds-btn-lg ds-btn-secondary\" data-goto=\"how-it-works\" data-eid=\"e35\">How buying works</button>\n      </div>\n    </div>\n    <div class=\"dn-hero-art\" data-eid=\"e36\">\n      <div class=\"ds-img dn-art-img\" data-sample=\"\" data-eid=\"e37\"></div>\n      <div class=\"dn-price-card\" data-eid=\"e38\">\n        <span class=\"ds-label-caps\" data-eid=\"e39\">From the shop</span>\n        <b data-sample=\"\">£12.50</b>\n      </div>\n    </div>\n  </div>\n\n  <section class=\"ds-band-bold dn-band\" data-eid=\"e40\">\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e41\">\n      <h2 style=\"color: inherit\" data-eid=\"e42\">Pick what you like. Pay once. It arrives.</h2>\n      <div class=\"dn-tiles\" data-eid=\"e43\">\n        <article class=\"dn-tile\" data-eid=\"e44\">\n          <span class=\"dn-num\" data-eid=\"e45\">01</span>\n          <h3 class=\"ds-h3\" data-eid=\"e46\">Pick what you want</h3>\n          <p data-eid=\"e47\">Every product shows its photo, name and price up front, so nothing is a surprise.</p>\n        </article>\n        <article class=\"dn-tile\" data-eid=\"e48\">\n          <span class=\"dn-num\" data-eid=\"e49\">02</span>\n          <h3 class=\"ds-h3\" data-eid=\"e50\">Pay at the checkout</h3>\n          <p data-eid=\"e51\">One payment, in pounds, with no hidden charges added at the end.</p>\n        </article>\n        <article class=\"dn-tile dn-tile-accent\" data-eid=\"e52\">\n          <span class=\"dn-num\" data-eid=\"e53\">03</span>\n          <h3 class=\"ds-h3\" data-eid=\"e54\">It comes to your door</h3>\n          <p style=\"color: hsl(var(--accent-foreground))\" data-eid=\"e55\">Orders are packed by hand and posted with care. Delivery details live on the How it works page.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"ds-page\" data-eid=\"e56\">\n    <section class=\"dn-split\" data-eid=\"e57\">\n      <div data-eid=\"e58\">\n        <span class=\"ds-label-caps\" data-eid=\"e59\">What you can do here</span>\n        <h2 data-eid=\"e60\">Look around freely. Sign up when you're ready to buy.</h2>\n        <ul class=\"dn-list\" data-eid=\"e61\">\n          <li data-eid=\"e62\"><span class=\"dn-dot\" aria-hidden=\"true\" data-eid=\"e63\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"m5 12 5 5 9-9\"></path></svg></span><span data-eid=\"e64\">Browse every product and its price without signing in.</span></li>\n          <li data-eid=\"e65\"><span class=\"dn-dot\" aria-hidden=\"true\" data-eid=\"e66\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"m5 12 5 5 9-9\"></path></svg></span><span data-eid=\"e67\">Read how delivery and returns work before you decide.</span></li>\n          <li data-eid=\"e68\"><span class=\"dn-dot\" aria-hidden=\"true\" data-eid=\"e69\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"m5 12 5 5 9-9\"></path></svg></span><span data-eid=\"e70\">Use Sign up to head into the shop and place your order.</span></li>\n        </ul>\n        <div class=\"ds-row\" style=\"margin-top: calc(28px * var(--space-scale, 1))\" data-eid=\"e71\">\n          <button class=\"ds-btn\" data-goto=\"products\" data-eid=\"e72\">Sign up</button>\n          <button class=\"ds-btn ds-btn-ghost\" data-goto=\"contact\" data-eid=\"e73\">Questions? Contact us</button>\n        </div>\n      </div>\n      <div class=\"dn-preview\" data-eid=\"e74\">\n        <span class=\"ds-label-caps\" data-eid=\"e75\">In the shop now</span>\n        <div class=\"dn-preview-row\" data-eid=\"e76\">\n          <div class=\"ds-img dn-thumb\" data-sample=\"\" data-eid=\"e77\"></div>\n          <div class=\"dn-row-text\" data-eid=\"e78\"><b data-sample=\"Product#1.name\">Stoneware mug</b><span class=\"sm\" data-sample=\"Product#1.description\" data-eid=\"e79\">Glazed by hand, holds a large cup</span></div>\n          <span class=\"dn-price\" data-sample=\"Product#1.pricePence\" data-eid=\"e80\">£12.50</span>\n        </div>\n        <div class=\"dn-preview-row\" data-eid=\"e81\">\n          <div class=\"ds-img dn-thumb\" data-sample=\"\" data-eid=\"e82\"></div>\n          <div class=\"dn-row-text\" data-eid=\"e83\"><b data-sample=\"Product#2.name\">Sourdough starter kit</b><span class=\"sm\" data-sample=\"Product#2.description\" data-eid=\"e84\">Jar, flour and a folded recipe card</span></div>\n          <span class=\"dn-price\" data-sample=\"Product#2.pricePence\" data-eid=\"e85\">£18.00</span>\n        </div>\n        <div class=\"dn-preview-row\" data-eid=\"e86\">\n          <div class=\"ds-img dn-thumb\" data-sample=\"\" data-eid=\"e87\"></div>\n          <div class=\"dn-row-text\" data-eid=\"e88\"><b data-sample=\"Product#3.name\">Linen tea towel</b><span class=\"sm\" data-sample=\"Product#3.description\" data-eid=\"e89\">Washed flax, sage stripe</span></div>\n          <span class=\"dn-price\" data-sample=\"Product#3.pricePence\" data-eid=\"e90\">£9.75</span>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <div class=\"ds-page\" data-eid=\"e91\">\n    <section class=\"dn-close\" data-eid=\"e92\">\n      <h2 data-eid=\"e93\">Ready to see it all?</h2>\n      <button class=\"ds-btn ds-btn-lg\" data-goto=\"products\" data-eid=\"e94\">Sign up</button>\n    </section>\n  </div>\n\n  <div data-part=\"footer\" data-eid=\"e95\"></div>\n</main>","changes":[]}