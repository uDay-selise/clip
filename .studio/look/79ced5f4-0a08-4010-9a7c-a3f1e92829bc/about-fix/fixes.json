{"html":"<style>\n  .ab-top { display: flex; align-items: center; gap: calc(16px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) 0; position: relative; }\n  .ab-brand { display: inline-flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 800; font-size: 20px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; }\n  .ab-mark { width: 34px; height: 34px; border-radius: 999px; background: conic-gradient(from 200deg, hsl(var(--primary)), hsl(var(--accent)), hsl(var(--primary))); box-shadow: inset 0 0 0 7px hsl(var(--background)); flex: none; }\n  .ab-links { display: flex; gap: calc(24px * var(--space-scale, 1)); font-size: 15px; }\n  .ab-links a { color: hsl(var(--muted-foreground)); text-decoration: none; padding: 8px 0; min-height: 40px; display: inline-flex; align-items: center; }\n  .ab-links a.is-here { color: hsl(var(--foreground)); font-weight: 600; }\n\n  .ab-hero { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: calc(48px * var(--space-scale, 1)); align-items: center; padding-top: calc(32px * var(--space-scale, 1)); padding-bottom: calc(64px * var(--space-scale, 1)); }\n  .ab-hero h1 { margin: calc(12px * var(--space-scale, 1)) 0 0; }\n  .ab-hero h1 em { font-style: normal; color: hsl(var(--primary-text)); }\n  .ab-lead { margin: calc(24px * var(--space-scale, 1)) 0 calc(32px * var(--space-scale, 1)); max-width: 32em; font-size: 18px; line-height: 1.6; color: hsl(var(--muted-foreground)); }\n  .ab-hero-figure { position: relative; }\n  .ab-hero-img { width: 100%; aspect-ratio: 4 / 5; border-radius: calc(var(--radius) * 2.5); overflow: hidden; box-shadow: var(--shadow); background: hsl(var(--primary) / 0.12); }\n  .ab-hero-img .ds-img { width: 100%; height: 100%; border-radius: 0; }\n  .ab-hero-tag { margin-top: calc(-32px * var(--space-scale, 1)); margin-left: calc(-16px * var(--space-scale, 1)); position: relative; display: inline-flex; align-items: center; gap: calc(12px * var(--space-scale, 1)); background: hsl(var(--card)); border-radius: var(--radius); padding: calc(12px * var(--space-scale, 1)) calc(16px * var(--space-scale, 1)); box-shadow: var(--shadow); }\n  .ab-hero-tag b { font-family: var(--font-heading); font-size: 15px; letter-spacing: -0.01em; }\n\n  .ab-kinds { padding: calc(48px * var(--space-scale, 1)) 0 calc(56px * var(--space-scale, 1)); position: relative; }\n  .ab-kinds-inner { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: calc(48px * var(--space-scale, 1)); align-items: start; }\n  .ab-kinds h2 { margin: calc(12px * var(--space-scale, 1)) 0 0; color: hsl(var(--band-foreground)); }\n  .ab-kinds .ds-eyebrow { color: hsl(var(--band-foreground)); }\n  .ab-kinds-lead { color: hsl(var(--band-foreground)); margin-top: calc(16px * var(--space-scale, 1)); font-size: 16px; line-height: 1.6; max-width: 30em; }\n  .ab-kind-list { display: grid; gap: calc(12px * var(--space-scale, 1)); }\n  .ab-kind { display: grid; grid-template-columns: 44px 1fr auto; gap: calc(16px * var(--space-scale, 1)); align-items: center; background: hsl(var(--card)); border-radius: var(--radius); padding: calc(16px * var(--space-scale, 1)); color: hsl(var(--card-foreground, var(--foreground))); min-height: 44px; box-shadow: var(--shadow); }\n  .ab-kind-icon { width: 44px; height: 44px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: hsl(var(--primary) / 0.12); color: hsl(var(--primary-text)); flex: none; }\n  .ab-kind b { font-family: var(--font-heading); font-size: 17px; letter-spacing: -0.01em; display: block; }\n  .ab-kind span.ab-kind-note { font-size: 14px; color: hsl(var(--muted-foreground)); }\n  .ab-kind-price { font-family: var(--font-heading); font-size: 17px; font-variant-numeric: tabular-nums; white-space: nowrap; color: hsl(var(--primary-text)); }\n\n  .ab-story { padding: calc(56px * var(--space-scale, 1)) 0; }\n  .ab-story-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: calc(48px * var(--space-scale, 1)); align-items: start; }\n  .ab-story h2 { margin: calc(12px * var(--space-scale, 1)) 0 0; }\n  .ab-story-text p { font-size: 17px; line-height: 1.65; margin: 0 0 calc(16px * var(--space-scale, 1)); max-width: 46ch; color: hsl(var(--foreground)); }\n  .ab-story-text p:last-child { margin-bottom: 0; }\n  .ab-story-text strong { color: hsl(var(--foreground)); }\n\n  .ab-close { padding-bottom: calc(64px * var(--space-scale, 1)); }\n  .ab-close-panel { position: relative; background: hsl(var(--accent)); color: hsl(var(--accent-foreground)); border-radius: calc(var(--radius) * 2); padding: calc(40px * var(--space-scale, 1)); overflow: hidden; display: grid; grid-template-columns: 1.3fr auto; gap: calc(32px * var(--space-scale, 1)); align-items: center; }\n  .ab-close-panel h2 { margin: 0; color: hsl(var(--accent-foreground)); max-width: 20em; }\n  .ab-close-panel p { margin: calc(12px * var(--space-scale, 1)) 0 0; color: hsl(var(--accent-foreground)); font-size: 16px; line-height: 1.6; max-width: 34em; }\n  .ab-close-panel .ab-close-btn { background: hsl(var(--foreground)); color: hsl(var(--background)); border-color: transparent; white-space: nowrap; }\n  .ab-close-ring { width: 300px; height: 300px; right: calc(-90px * var(--space-scale, 1)); top: calc(-110px * var(--space-scale, 1)); opacity: 0.16; }\n\n  @media (max-width: 900px) {\n    .ab-hero, .ab-kinds-inner, .ab-story-grid, .ab-close-panel { grid-template-columns: 1fr; gap: calc(32px * var(--space-scale, 1)); }\n    .ab-links { display: none; }\n    .ab-hero-img { aspect-ratio: 4 / 3; }\n    .ab-close-panel .ab-close-btn { justify-self: start; }\n  }\n</style><main data-screen=\"about\" data-eid=\"e1\">\n  <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e2\">\n    <header class=\"ab-top\" data-eid=\"e3\">\n      <a class=\"ab-brand\" data-goto=\"home\" data-eid=\"e4\"><span class=\"ab-mark\" aria-hidden=\"true\" data-eid=\"e5\"></span>Donkey website</a>\n      <nav class=\"ab-links ds-only-wide\" aria-label=\"Pages\" data-eid=\"e6\">\n        <a data-goto=\"home\" data-eid=\"e7\">Home</a>\n        <a data-goto=\"products\" data-eid=\"e8\">Products</a>\n        <a data-goto=\"how-it-works\" data-eid=\"e9\">How it works</a>\n        <a class=\"is-here\" data-goto=\"about\" aria-current=\"page\" data-eid=\"e10\">About</a>\n        <a data-goto=\"contact\" data-eid=\"e11\">Contact</a>\n      </nav>\n      <span class=\"ds-spacer\" data-eid=\"e12\"></span>\n      <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e13\">\n        <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e14\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n        <button aria-label=\"Dark\" data-eid=\"e15\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n        <button aria-label=\"Auto\" data-eid=\"e16\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n      </div>\n      <a class=\"ds-btn ds-btn-sm\" data-goto=\"home\" data-eid=\"e17\">Sign up</a>\n      <details class=\"ds-menu ds-only-narrow\">\n        <summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary>\n        <div class=\"ds-menu-list\" data-eid=\"e18\">\n          <a data-goto=\"home\" data-eid=\"e19\">Home</a>\n          <a data-goto=\"products\" data-eid=\"e20\">Products</a>\n          <a data-goto=\"how-it-works\" data-eid=\"e21\">How it works</a>\n          <a data-goto=\"about\" data-eid=\"e22\">About</a>\n          <a data-goto=\"contact\" data-eid=\"e23\">Contact</a>\n          <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e24\">\n            <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e25\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n            <button aria-label=\"Dark\" data-eid=\"e26\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n            <button aria-label=\"Auto\" data-eid=\"e27\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n          </div>\n        </div>\n      </details>\n    </header>\n\n    <section class=\"ab-hero\" data-eid=\"e28\">\n      <div data-eid=\"e29\">\n        <span class=\"ds-eyebrow\" data-eid=\"e30\">About Donkey</span>\n        <h1 class=\"ds-display\" data-eid=\"e31\">We sell the good stuff, <em data-eid=\"e32\">picked for you.</em></h1>\n        <p class=\"ab-lead\" data-eid=\"e33\">Donkey is a small shop with a big shelf: everyday things for the kitchen, the garden and a slow weekend, chosen by hand and priced plainly.</p>\n        <div class=\"ds-row\" data-eid=\"e34\">\n          <a class=\"ds-btn ds-btn-lg\" data-goto=\"home\" data-eid=\"e35\">Sign up</a>\n          <a class=\"ds-btn ds-btn-secondary ds-btn-lg\" data-goto=\"products\" data-eid=\"e36\">See the products</a>\n        </div>\n      </div>\n      <div class=\"ab-hero-figure\" data-eid=\"e37\">\n        <div class=\"ab-hero-img\" data-eid=\"e38\"><div class=\"ds-img\" data-sample=\"\" data-eid=\"e39\"></div></div>\n        <div class=\"ab-hero-tag\" data-eid=\"e40\">\n          <span class=\"ds-badge ds-badge-success\" data-eid=\"e41\">Open</span>\n          <b data-sample=\"\">Open for orders every day</b>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <section class=\"ds-band-bold ab-kinds\" data-eid=\"e42\">\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e43\">\n      <div class=\"ab-kinds-inner\" data-eid=\"e44\">\n        <div data-eid=\"e45\">\n          <span class=\"ds-eyebrow\" data-eid=\"e46\">What we sell</span>\n          <h2 class=\"ds-h1\" data-eid=\"e47\">Four kinds of thing, all chosen by hand.</h2>\n          <p class=\"ab-kinds-lead\" data-eid=\"e48\">We keep the shelf short on purpose. Each thing earns its place: it lasts, it does one job well, and it costs what it says.</p>\n        </div>\n        <div class=\"ab-kind-list\" data-eid=\"e49\">\n          <div class=\"ab-kind\" data-sample=\"Product#1.group\" data-eid=\"e50\">\n            <span class=\"ab-kind-icon\" data-eid=\"e51\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M4 10h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM8 10V7a4 4 0 0 1 8 0v3\"></path></svg></span>\n            <div data-eid=\"e52\"><b>Kitchen</b><span class=\"ab-kind-note\" data-eid=\"e53\">Mugs, bowls, and the small tools we reach for daily.</span></div>\n            <span class=\"ab-kind-price\" data-sample=\"\" data-eid=\"e54\">from £8.00</span>\n          </div>\n          <div class=\"ab-kind\" data-sample=\"Product#2.group\" data-eid=\"e55\">\n            <span class=\"ab-kind-icon\" data-eid=\"e56\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 21V11M12 11a5 5 0 0 0-5-5H4v2a5 5 0 0 0 5 5h3zM12 11a5 5 0 0 1 5-5h3v2a5 5 0 0 1-5 5h-3z\"></path></svg></span>\n            <div data-eid=\"e57\"><b>Garden</b><span class=\"ab-kind-note\" data-eid=\"e58\">Pots, twine and gloves that survive a wet spring.</span></div>\n            <span class=\"ab-kind-price\" data-sample=\"\" data-eid=\"e59\">from £4.50</span>\n          </div>\n          <div class=\"ab-kind\" data-sample=\"Product#3.group\" data-eid=\"e60\">\n            <span class=\"ab-kind-icon\" data-eid=\"e61\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 3v18M5 8l7-5 7 5\"></path></svg></span>\n            <div data-eid=\"e62\"><b>Weekend</b><span class=\"ab-kind-note\" data-eid=\"e63\">Blankets, lanterns and things for slow days off.</span></div>\n            <span class=\"ab-kind-price\" data-sample=\"\" data-eid=\"e64\">from £12.50</span>\n          </div>\n          <div class=\"ab-kind\" data-sample=\"Product#4.group\" data-eid=\"e65\">\n            <span class=\"ab-kind-icon\" data-eid=\"e66\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z\"></path></svg></span>\n            <div data-eid=\"e67\"><b>Gifts</b><span class=\"ab-kind-note\" data-eid=\"e68\">Wrapped, stamped and ready for someone else.</span></div>\n            <span class=\"ab-kind-price\" data-sample=\"\" data-eid=\"e69\">from £6.00</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e70\">\n    <section class=\"ab-story\" data-eid=\"e71\">\n      <div class=\"ab-story-grid\" data-eid=\"e72\">\n        <div data-eid=\"e73\">\n          <span class=\"ds-eyebrow\" data-eid=\"e74\">How we pick</span>\n          <h2 class=\"ds-h1\" data-eid=\"e75\">A short shelf, chosen slowly.</h2>\n        </div>\n        <div class=\"ab-story-text\" data-eid=\"e76\">\n          <p data-eid=\"e77\">We started Donkey because buying a good wooden spoon shouldn't take an afternoon. So we do the looking for you: we hold each thing, use it for a week, and only then does it go on the shelf.</p>\n          <p data-eid=\"e78\"><strong data-eid=\"e79\">Plain prices, in pounds,</strong> with no faff around them. When something sells out, we say so and tell you when it's back, rather than quietly taking your order.</p>\n          <p data-eid=\"e80\">Orders go out from our own little store room. If you're not sure which size or shape you need, write to us and a real person will answer.</p>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e81\">\n    <section class=\"ab-close\" data-eid=\"e82\">\n      <div class=\"ab-close-panel\" data-eid=\"e83\">\n        <svg class=\"ds-deco ab-close-ring\" viewBox=\"0 0 200 200\" aria-hidden=\"true\"><circle cx=\"100\" cy=\"100\" r=\"96\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"></circle><circle cx=\"100\" cy=\"100\" r=\"66\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"></circle><circle cx=\"100\" cy=\"100\" r=\"34\" fill=\"currentColor\"></circle></svg>\n        <div data-eid=\"e84\">\n          <h2 class=\"ds-h2\" data-eid=\"e85\">Ready to have a look around?</h2>\n          <p data-eid=\"e86\">Sign up to step into the shop, or read how buying works first. Either way, take your time.</p>\n        </div>\n        <a class=\"ds-btn ds-btn-lg ab-close-btn\" data-goto=\"home\" data-eid=\"e87\">Sign up</a>\n      </div>\n    </section>\n  </div>\n\n  <div data-part=\"footer\" data-eid=\"e88\"></div>\n</main>","changes":[]}