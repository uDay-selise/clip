{"html":"<style>\n  .dn-top { display: flex; align-items: center; gap: calc(24px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) 0; }\n  .dn-brand { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 700; font-size: 20px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; }\n  .dn-mark { width: 34px; height: 34px; border-radius: 999px; background: hsl(var(--primary)); display: inline-flex; align-items: center; justify-content: center; color: hsl(var(--primary-foreground)); flex: none; }\n  .dn-links { display: flex; gap: calc(24px * var(--space-scale, 1)); font-size: 15px; }\n  .dn-links a { color: hsl(var(--muted-foreground)); text-decoration: none; padding: 10px 0; }\n  .dn-links a:hover { color: hsl(var(--foreground)); }\n\n  .dn-hero { position: relative; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: calc(48px * var(--space-scale, 1)); align-items: center; padding: calc(56px * var(--space-scale, 1)) 0 calc(64px * var(--space-scale, 1)); }\n  .dn-hero h1 { margin: calc(16px * var(--space-scale, 1)) 0 0; font-size: clamp(44px, 7.4vw, 92px); line-height: 0.98; letter-spacing: -0.04em; }\n  .dn-hero h1 em { font-style: normal; color: hsl(var(--primary-text)); }\n  .dn-lead { margin: calc(20px * var(--space-scale, 1)) 0 calc(28px * var(--space-scale, 1)); max-width: 30em; font-size: 18px; line-height: 1.55; color: hsl(var(--muted-foreground)); }\n  .dn-hero-art { position: relative; aspect-ratio: 4 / 5; border-radius: calc(var(--radius) * 2); background: linear-gradient(160deg, hsl(var(--main-100)), hsl(var(--main-300))); box-shadow: var(--shadow); display: flex; align-items: center; justify-content: center; }\n  .dark .dn-hero-art { background: linear-gradient(160deg, hsl(var(--main-900)), hsl(var(--main-800))); }\n  .dn-hero-art .ds-img { position: absolute; inset: calc(20px * var(--space-scale, 1)); border-radius: var(--card-radius); }\n  .dn-hero-art .dn-price-card { position: relative; align-self: flex-end; margin: 0 calc(-32px * var(--space-scale, 1)) calc(32px * var(--space-scale, 1)) 0; }\n  .dn-price-card { background: hsl(var(--card)); color: hsl(var(--foreground)); border-radius: var(--card-radius); padding: calc(16px * var(--space-scale, 1)) calc(20px * var(--space-scale, 1)); box-shadow: var(--shadow); }\n  .dn-price-card b { display: block; font-family: var(--font-heading); font-size: 30px; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }\n\n  .dn-band { padding: calc(56px * var(--space-scale, 1)) 0; }\n  .dn-band h2 { margin: calc(12px * var(--space-scale, 1)) 0 0; font-size: clamp(32px, 4.4vw, 52px); line-height: 1.02; letter-spacing: -0.035em; max-width: 16em; }\n  .dn-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(16px * var(--space-scale, 1)); margin-top: calc(40px * var(--space-scale, 1)); }\n  .dn-tile { background: hsl(var(--card)); border-radius: var(--card-radius); padding: calc(28px * var(--space-scale, 1)); box-shadow: var(--shadow); display: flex; flex-direction: column; gap: calc(10px * var(--space-scale, 1)); }\n  .dn-tile .dn-num { font-family: var(--font-heading); font-size: 44px; line-height: 1; letter-spacing: -0.04em; color: hsl(var(--primary-text)); }\n  .dn-tile h3 { margin: 0; }\n  .dn-tile p { margin: 0; font-size: 15px; line-height: 1.55; color: hsl(var(--muted-foreground)); }\n  .dn-tile.dn-tile-accent { background: hsl(var(--accent)); }\n  .dn-tile.dn-tile-accent p, .dn-tile.dn-tile-accent .dn-num { color: hsl(var(--accent-foreground) / 0.82); }\n  .dn-tile.dn-tile-accent h3 { color: hsl(var(--accent-foreground)); }\n\n  .dn-split { display: grid; grid-template-columns: 1fr 1fr; gap: calc(48px * var(--space-scale, 1)); align-items: center; padding: calc(64px * var(--space-scale, 1)) 0; }\n  .dn-split h2 { margin: calc(12px * var(--space-scale, 1)) 0 calc(20px * var(--space-scale, 1)); font-size: clamp(30px, 4vw, 46px); line-height: 1.04; letter-spacing: -0.035em; }\n  .dn-list { margin: 0; padding: 0; list-style: none; display: grid; gap: calc(14px * var(--space-scale, 1)); }\n  .dn-list li { display: flex; gap: calc(14px * var(--space-scale, 1)); align-items: flex-start; font-size: 16px; line-height: 1.5; }\n  .dn-dot { flex: none; width: 26px; height: 26px; border-radius: 999px; background: hsl(var(--primary) / 0.14); color: hsl(var(--primary-text)); display: inline-flex; align-items: center; justify-content: center; margin-top: 1px; }\n  .dn-preview { border-radius: calc(var(--radius) * 2); background: hsl(var(--muted)); padding: calc(24px * var(--space-scale, 1)); box-shadow: var(--shadow); display: grid; gap: calc(12px * var(--space-scale, 1)); }\n  .dn-preview-row { display: flex; align-items: center; gap: calc(16px * var(--space-scale, 1)); background: hsl(var(--card)); border-radius: var(--card-radius); padding: calc(14px * var(--space-scale, 1)) calc(16px * var(--space-scale, 1)); }\n  .dn-preview-row .ds-img { width: 56px; height: 56px; flex: none; border-radius: var(--radius); }\n  .dn-preview-row b { display: block; font-size: 16px; }\n  .dn-preview-row span.sm { display: block; font-size: 13px; color: hsl(var(--muted-foreground)); }\n  .dn-preview-row .dn-price { margin-left: auto; font-family: var(--font-heading); font-weight: 700; font-size: 18px; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; white-space: nowrap; }\n\n  .dn-close { text-align: center; padding: calc(64px * var(--space-scale, 1)) 0; position: relative; }\n  .dn-close h2 { margin: calc(12px * var(--space-scale, 1)) auto calc(24px); font-size: clamp(38px, 6vw, 72px); line-height: 1; letter-spacing: -0.04em; max-width: 12em; }\n\n  @media (max-width: 900px) {\n    .dn-hero, .dn-split { grid-template-columns: 1fr; gap: calc(32px * var(--space-scale, 1)); }\n    .dn-tiles { grid-template-columns: 1fr; }\n    .dn-hero-art { aspect-ratio: 16 / 10; }\n    .dn-links { display: none; }\n  }\n</style><main data-screen=\"home\" data-eid=\"e1\">\n  <div data-part=\"header\" data-eid=\"e2\"></div>\n\n  <div data-eid=\"content\">\n    <div class=\"ds-page dn-hero\" data-eid=\"e3\">\n      <div data-eid=\"e4\">\n        <span class=\"ds-eyebrow\" data-eid=\"e5\">Donkey shop</span>\n        <h1 data-eid=\"e6\">Good things, <em data-eid=\"e7\">fair prices.</em></h1>\n        <p class=\"dn-lead\" data-sample=\"PageWording#home.intro\" data-eid=\"e8\">Donkey sells everyday goods chosen with care: homeware, pantry staples and small gifts. Browse what we have, see what it costs, and sign up to buy.</p>\n        <div class=\"ds-row\" data-eid=\"e9\">\n          <button class=\"ds-btn ds-btn-lg\" data-goto=\"products\" data-eid=\"e10\">Sign up</button>\n          <button class=\"ds-btn ds-btn-lg ds-btn-secondary\" data-goto=\"how-it-works\" data-eid=\"e11\">How buying works</button>\n        </div>\n      </div>\n      <div class=\"dn-hero-art\" data-eid=\"e12\">\n        <div class=\"ds-img\" data-sample=\"\" data-eid=\"e13\"></div>\n        <div class=\"dn-price-card\" data-eid=\"e14\">\n          <span class=\"ds-label-caps\" data-eid=\"e15\">From the shop</span>\n          <b data-sample=\"\">£12.50</b>\n        </div>\n      </div>\n    </div>\n\n    <section class=\"ds-band-bold dn-band\" data-eid=\"e16\">\n      <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e17\">\n        <h2 style=\"color: inherit\" data-eid=\"e18\">Pick what you like. Pay once. It arrives.</h2>\n        <div class=\"dn-tiles\" data-eid=\"e19\">\n          <article class=\"dn-tile\" data-eid=\"e20\">\n            <span class=\"dn-num\" data-eid=\"e21\">01</span>\n            <h3 class=\"ds-h3\" data-eid=\"e22\">Pick what you want</h3>\n            <p data-eid=\"e23\">Every product shows its photo, name and price up front, so nothing is a surprise.</p>\n          </article>\n          <article class=\"dn-tile\" data-eid=\"e24\">\n            <span class=\"dn-num\" data-eid=\"e25\">02</span>\n            <h3 class=\"ds-h3\" data-eid=\"e26\">Pay at the checkout</h3>\n            <p data-eid=\"e27\">One payment, in pounds, with no hidden charges added at the end.</p>\n          </article>\n          <article class=\"dn-tile dn-tile-accent\" data-eid=\"e28\">\n            <span class=\"dn-num\" data-eid=\"e29\">03</span>\n            <h3 class=\"ds-h3\" data-eid=\"e30\">It comes to your door</h3>\n            <p data-eid=\"e31\">Orders are packed by hand and posted with care. Delivery details live on the How it works page.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"ds-page\" data-eid=\"e32\">\n      <section class=\"dn-split\" data-eid=\"e33\">\n        <div data-eid=\"e34\">\n          <span class=\"ds-label-caps\" data-eid=\"e35\">What you can do here</span>\n          <h2 data-eid=\"e36\">Look around freely. Sign up when you're ready to buy.</h2>\n          <ul class=\"dn-list\" data-eid=\"e37\">\n            <li data-eid=\"e38\"><span class=\"dn-dot\" aria-hidden=\"true\" data-eid=\"e39\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"m5 12 5 5 9-9\"></path></svg></span><span data-eid=\"e40\">Browse every product and its price without signing in.</span></li>\n            <li data-eid=\"e41\"><span class=\"dn-dot\" aria-hidden=\"true\" data-eid=\"e42\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"m5 12 5 5 9-9\"></path></svg></span><span data-eid=\"e43\">Read how delivery and returns work before you decide.</span></li>\n            <li data-eid=\"e44\"><span class=\"dn-dot\" aria-hidden=\"true\" data-eid=\"e45\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"m5 12 5 5 9-9\"></path></svg></span><span data-eid=\"e46\">Use Sign up to head into the shop and place your order.</span></li>\n          </ul>\n          <div class=\"ds-row\" style=\"margin-top: calc(28px * var(--space-scale, 1))\" data-eid=\"e47\">\n            <button class=\"ds-btn\" data-goto=\"products\" data-eid=\"e48\">Sign up</button>\n            <button class=\"ds-btn ds-btn-ghost\" data-goto=\"contact\" data-eid=\"e49\">Questions? Contact us</button>\n          </div>\n        </div>\n        <div class=\"dn-preview\" data-eid=\"e50\">\n          <span class=\"ds-label-caps\" data-eid=\"e51\">In the shop now</span>\n          <div class=\"dn-preview-row\" data-eid=\"e52\">\n            <div class=\"ds-img\" data-sample=\"\" data-eid=\"e53\"></div>\n            <div data-eid=\"e54\"><b data-sample=\"Product#1.name\">Stoneware mug</b><span class=\"sm\" data-sample=\"Product#1.description\" data-eid=\"e55\">Glazed by hand, holds a large cup</span></div>\n            <span class=\"dn-price\" data-sample=\"Product#1.pricePence\" data-eid=\"e56\">£12.50</span>\n          </div>\n          <div class=\"dn-preview-row\" data-eid=\"e57\">\n            <div class=\"ds-img\" data-sample=\"\" data-eid=\"e58\"></div>\n            <div data-eid=\"e59\"><b data-sample=\"Product#2.name\">Sourdough starter kit</b><span class=\"sm\" data-sample=\"Product#2.description\" data-eid=\"e60\">Jar, flour and a folded recipe card</span></div>\n            <span class=\"dn-price\" data-sample=\"Product#2.pricePence\" data-eid=\"e61\">£18.00</span>\n          </div>\n          <div class=\"dn-preview-row\" data-eid=\"e62\">\n            <div class=\"ds-img\" data-sample=\"\" data-eid=\"e63\"></div>\n            <div data-eid=\"e64\"><b data-sample=\"Product#3.name\">Linen tea towel</b><span class=\"sm\" data-sample=\"Product#3.description\" data-eid=\"e65\">Washed flax, sage stripe</span></div>\n            <span class=\"dn-price\" data-sample=\"Product#3.pricePence\" data-eid=\"e66\">£9.75</span>\n          </div>\n        </div>\n      </section>\n    </div>\n\n    <div class=\"ds-page\" data-eid=\"e67\">\n      <section class=\"dn-close\" data-eid=\"e68\">\n        <h2 data-eid=\"e69\">Ready to see it all?</h2>\n        <button class=\"ds-btn ds-btn-lg\" data-goto=\"products\" data-eid=\"e70\">Sign up</button>\n      </section>\n    </div>\n  </div>\n\n  <div data-part=\"footer\" data-eid=\"e71\"></div>\n</main>","changes":[]}