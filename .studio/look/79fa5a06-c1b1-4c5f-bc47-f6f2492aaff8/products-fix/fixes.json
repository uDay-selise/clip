{"html":"<style>\n  .pr-top { display: flex; align-items: center; gap: calc(24px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) 0; }\n  .pr-brand { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 800; font-size: 20px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; white-space: nowrap; }\n  .pr-mark { width: 32px; height: 32px; border-radius: 999px; background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); display: inline-flex; align-items: center; justify-content: center; flex: none; }\n  .pr-mark svg { width: 20px; height: 20px; }\n  .pr-links { display: flex; gap: calc(22px * var(--space-scale, 1)); font-size: 15px; }\n  .pr-links a { color: hsl(var(--muted-foreground)); text-decoration: none; padding: 10px 0; display: inline-flex; align-items: center; min-height: 40px; }\n  .pr-links a.pr-on { color: hsl(var(--foreground)); font-weight: 600; box-shadow: inset 0 -2px 0 hsl(var(--primary)); }\n  .pr-head { display: grid; grid-template-columns: 1.35fr 1fr; gap: calc(48px * var(--space-scale, 1)); align-items: end; padding: calc(48px * var(--space-scale, 1)) 0 calc(40px * var(--space-scale, 1)); }\n  .pr-head h1 { margin: calc(12px * var(--space-scale, 1)) 0 0; }\n  .pr-lead { margin: calc(16px * var(--space-scale, 1)) 0 0; max-width: 26em; font-size: 17px; line-height: 1.6; color: hsl(var(--muted-foreground)); }\n  .pr-counts { display: flex; gap: calc(32px * var(--space-scale, 1)); border-top: 2px solid hsl(var(--foreground)); padding-top: calc(16px * var(--space-scale, 1)); }\n  .pr-count b { display: block; font-family: var(--font-heading); font-size: 40px; line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }\n  .pr-count span { display: block; margin-top: calc(8px * var(--space-scale, 1)); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: hsl(var(--muted-foreground)); }\n  .pr-band { background: hsl(var(--band)); color: hsl(var(--band-foreground)); padding: calc(48px * var(--space-scale, 1)) 0 calc(64px * var(--space-scale, 1)); border-radius: calc(var(--radius) + 20px); margin-top: calc(8px * var(--space-scale, 1)); }\n  .pr-band-head { display: flex; align-items: baseline; gap: calc(16px * var(--space-scale, 1)); flex-wrap: wrap; }\n  .pr-band-head .ds-label-caps { color: hsl(var(--band-foreground) / 0.75); }\n  .pr-band-note { margin-left: auto; font-size: 13px; color: hsl(var(--band-foreground) / 0.75); font-variant-numeric: tabular-nums; }\n  .pr-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(24px * var(--space-scale, 1)); margin-top: calc(24px * var(--space-scale, 1)); }\n  .pr-card { display: flex; flex-direction: column; background: hsl(var(--card)); border-radius: calc(var(--card-radius, var(--radius)) + 4px); box-shadow: var(--shadow); overflow: hidden; }\n  .pr-photo { aspect-ratio: 4 / 3; background: linear-gradient(150deg, hsl(var(--main-100)), hsl(var(--main-200))); position: relative; display: flex; align-items: center; justify-content: center; color: hsl(var(--main-600)); }\n  .dark .pr-photo { background: linear-gradient(150deg, hsl(var(--main-900)), hsl(var(--main-800))); color: hsl(var(--main-300)); }\n  .pr-photo svg { width: 48px; height: 48px; opacity: 0.6; }\n  .pr-tag { position: static; }\n  .pr-tagline { display: flex; gap: calc(8px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) calc(20px * var(--space-scale, 1)) 0; flex-wrap: wrap; }\n  .pr-body { padding: calc(10px * var(--space-scale, 1)) calc(20px * var(--space-scale, 1)) calc(20px * var(--space-scale, 1)); display: flex; flex-direction: column; flex: 1; }\n  .pr-name { font-family: var(--font-heading); font-size: 21px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin: calc(8px * var(--space-scale, 1)) 0 0; }\n  .pr-desc { margin: calc(8px * var(--space-scale, 1)) 0 0; font-size: 15px; line-height: 1.55; color: hsl(var(--muted-foreground)); }\n  .pr-med { margin: calc(12px * var(--space-scale, 1)) 0 0; display: flex; gap: calc(8px * var(--space-scale, 1)); align-items: flex-start; font-size: 13px; line-height: 1.45; color: hsl(var(--muted-foreground)); background: hsl(var(--muted)); border-radius: var(--radius-input); padding: calc(10px * var(--space-scale, 1)); }\n  .pr-med svg { width: 16px; height: 16px; flex: none; margin-top: 1px; color: hsl(var(--primary-text)); }\n  .pr-foot { margin-top: auto; padding-top: calc(20px * var(--space-scale, 1)); display: flex; align-items: center; gap: calc(12px * var(--space-scale, 1)); }\n  .pr-price { font-family: var(--font-heading); font-size: 30px; font-weight: 700; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }\n  .pr-foot .ds-btn { margin-left: auto; min-height: 44px; }\n  .pr-close { margin-top: calc(64px * var(--space-scale, 1)); display: grid; grid-template-columns: 1.1fr 1fr; gap: calc(40px * var(--space-scale, 1)); align-items: center; background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); border-radius: calc(var(--radius) + 16px); padding: calc(40px * var(--space-scale, 1)); position: relative; overflow: visible; }\n  .pr-close h2 { margin: calc(10px * var(--space-scale, 1)) 0 0; color: inherit; }\n  .pr-close p { margin: calc(12px * var(--space-scale, 1)) 0 0; font-size: 16px; line-height: 1.6; color: hsl(var(--primary-foreground) / 0.85); max-width: 24em; }\n  .pr-close .ds-eyebrow { color: hsl(var(--primary-foreground) / 0.75); }\n  .pr-close-btn { display: flex; justify-content: flex-end; align-items: center; gap: calc(16px * var(--space-scale, 1)); flex-wrap: wrap; }\n  .pr-close .ds-btn { background: hsl(var(--primary-foreground)); color: hsl(var(--primary-text)); border-color: transparent; }\n  .pr-close .ds-btn-ghost { background: transparent; color: hsl(var(--primary-foreground)); border: 1px solid hsl(var(--primary-foreground) / 0.5); }\n  .pr-close-shape { width: 260px; height: 260px; right: calc(-40px * var(--space-scale, 1)); bottom: calc(-60px * var(--space-scale, 1)); color: hsl(var(--primary-foreground)); opacity: 0.14; }\n  @media (max-width: 1000px) {\n    .pr-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .pr-head { grid-template-columns: 1fr; gap: calc(24px * var(--space-scale, 1)); }\n  }\n  @media (max-width: 720px) {\n    .pr-links { display: none; }\n    .pr-grid { grid-template-columns: 1fr; }\n    .pr-close { grid-template-columns: 1fr; }\n    .pr-close-btn { justify-content: flex-start; }\n    .pr-band { border-radius: calc(var(--radius) + 12px); }\n    .pr-counts { gap: calc(24px * var(--space-scale, 1)); }\n    .pr-count b { font-size: 32px; }\n  }\n</style><main data-screen=\"products\" data-eid=\"e1\">\n  <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e2\">\n    <header class=\"pr-top\" data-eid=\"e3\">\n      <a class=\"pr-brand\" data-goto=\"home\" data-eid=\"e4\">\n        <span class=\"pr-mark\" aria-hidden=\"true\" data-eid=\"e5\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M7 8c-1.5 1.6-2 3.4 0 4.5M17 8c1.5 1.6 2 3.4 0 4.5\"></path><path d=\"M6 13.5c0 3.5 2.7 6 6 6s6-2.5 6-6c0-1.6-1-2.8-2.5-2.8h-7C7 10.7 6 11.9 6 13.5Z\"></path></svg></span>\n        <span data-eid=\"e6\">Donkey</span>\n      </a>\n      <nav class=\"pr-links ds-only-wide\" aria-label=\"Site pages\" data-eid=\"e7\">\n        <a data-goto=\"home\" data-eid=\"e8\">Home</a>\n        <a class=\"pr-on\" href=\"#\" aria-current=\"page\" data-eid=\"e9\">Products</a>\n        <a data-goto=\"how-it-works\" data-eid=\"e10\">How it works</a>\n        <a data-goto=\"about\" data-eid=\"e11\">About</a>\n        <a data-goto=\"contact\" data-eid=\"e12\">Contact</a>\n      </nav>\n      <span class=\"ds-spacer\" data-eid=\"e13\"></span>\n      <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e14\">\n        <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e15\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n        <button aria-label=\"Dark\" data-eid=\"e16\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n        <button aria-label=\"Auto\" data-eid=\"e17\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n      </div>\n      <a class=\"ds-btn ds-btn-sm\" data-goto=\"home\" data-eid=\"e18\">Sign up</a>\n      <a class=\"ds-btn ds-btn-ghost ds-btn-sm\" data-goto=\"editor-sign-in\" data-eid=\"e19\">Sign in</a>\n      <details class=\"ds-menu ds-only-narrow\"><summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary><div class=\"ds-menu-list\" data-eid=\"e20\"><a data-goto=\"home\" data-eid=\"e21\">Home</a><a href=\"#\" data-eid=\"e22\">Products</a><a data-goto=\"how-it-works\" data-eid=\"e23\">How it works</a><a data-goto=\"about\" data-eid=\"e24\">About</a><a data-goto=\"contact\" data-eid=\"e25\">Contact</a><div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e26\"><button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e27\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button><button aria-label=\"Dark\" data-eid=\"e28\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button><button aria-label=\"Auto\" data-eid=\"e29\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button></div></div></details>\n    </header>\n  </div>\n\n  <div data-eid=\"content\">\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e30\">\n      <div class=\"ds-page-head pr-head\" data-eid=\"e31\">\n        <div data-eid=\"e32\">\n          <span class=\"ds-eyebrow\" data-eid=\"e33\">The shop</span>\n          <h1 class=\"ds-h1 ds-display\" data-eid=\"e34\">Everything we sell, priced plainly.</h1>\n          <p class=\"pr-lead\" data-eid=\"e35\">Six things on the shelf right now. Every price is the full price in pounds, nothing added at the counter.</p>\n        </div>\n        <div class=\"pr-counts\" data-eid=\"e36\">\n          <div class=\"pr-count\" data-eid=\"e37\"><b data-sample=\"\">6</b><span data-eid=\"e38\">On sale</span></div>\n          <div class=\"pr-count\" data-eid=\"e39\"><b data-sample=\"\">£12.50</b><span data-eid=\"e40\">From</span></div>\n          <div class=\"pr-count\" data-eid=\"e41\"><b data-sample=\"\">3 to 5 days</b><span data-eid=\"e42\">Delivery</span></div>\n        </div>\n      </div>\n    </div>\n\n    <section class=\"ds-band pr-band\" data-eid=\"e43\">\n      <svg class=\"ds-deco pr-close-shape\" viewBox=\"0 0 200 200\" aria-hidden=\"true\"><circle cx=\"100\" cy=\"100\" r=\"96\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"></circle><circle cx=\"100\" cy=\"100\" r=\"64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"></circle></svg>\n      <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e44\">\n        <div class=\"pr-band-head\" data-eid=\"e45\">\n          <span class=\"ds-label-caps\" data-eid=\"e46\">On sale now</span>\n          <span class=\"pr-band-note\" data-eid=\"e47\">Prices in pounds, no extras</span>\n        </div>\n\n        <div class=\"pr-grid\" data-eid=\"e48\">\n          <article class=\"pr-card\" data-eid=\"e49\">\n            <div class=\"pr-photo\" data-eid=\"e50\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"m3 16 5-4 4 3 3-2 6 4\"></path><circle cx=\"9\" cy=\"9\" r=\"1.5\"></circle></svg></div>\n            <div class=\"pr-tagline\" data-eid=\"e51\"><span class=\"ds-badge ds-badge-success\" data-eid=\"e52\">In stock</span><span class=\"ds-badge ds-badge-quiet\" data-sample=\"Product#1.group\" data-eid=\"e53\">Oils</span></div>\n            <div class=\"pr-body\" data-eid=\"e54\">\n              <h2 class=\"pr-name\" data-sample=\"Product#1.name\" data-eid=\"e55\">Calm Nights lavender oil</h2>\n              <p class=\"pr-desc\" data-sample=\"Product#1.description\" data-eid=\"e56\">A small bottle of cold-pressed lavender oil for the end of the day. Ten drops in a warm bath, or on the pillow.</p>\n              <p class=\"pr-med\" data-eid=\"e57\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 3v18M5 8h14M5 16h14\"></path></svg><span data-sample=\"Product#1.medicineNote\" data-eid=\"e58\">For adults. Keep away from children and ask your doctor if you are pregnant.</span></p>\n              <div class=\"pr-foot\" data-eid=\"e59\">\n                <span class=\"pr-price\" data-sample=\"Product#1.price\" data-eid=\"e60\">£12.50</span>\n                <a class=\"ds-btn ds-btn-secondary ds-btn-sm\" data-goto=\"home\" data-eid=\"e61\">Sign up</a>\n              </div>\n            </div>\n          </article>\n\n          <article class=\"pr-card\" data-eid=\"e62\">\n            <div class=\"pr-photo\" data-eid=\"e63\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"m3 16 5-4 4 3 3-2 6 4\"></path><circle cx=\"9\" cy=\"9\" r=\"1.5\"></circle></svg></div>\n            <div class=\"pr-tagline\" data-eid=\"e64\"><span class=\"ds-badge ds-badge-success\" data-eid=\"e65\">In stock</span><span class=\"ds-badge ds-badge-quiet\" data-sample=\"Product#2.group\" data-eid=\"e66\">Balms</span></div>\n            <div class=\"pr-body\" data-eid=\"e67\">\n              <h2 class=\"pr-name\" data-sample=\"Product#2.name\" data-eid=\"e68\">Hand balm, unscented</h2>\n              <p class=\"pr-desc\" data-sample=\"Product#2.description\" data-eid=\"e69\">Beeswax and shea, in a tin that fits a coat pocket. For gardeners and anyone who washes up a lot.</p>\n              <div class=\"pr-foot\" data-eid=\"e70\">\n                <span class=\"pr-price\" data-sample=\"Product#2.price\" data-eid=\"e71\">£8.00</span>\n                <a class=\"ds-btn ds-btn-secondary ds-btn-sm\" data-goto=\"home\" data-eid=\"e72\">Sign up</a>\n              </div>\n            </div>\n          </article>\n\n          <article class=\"pr-card\" data-eid=\"e73\">\n            <div class=\"pr-photo\" data-eid=\"e74\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"m3 16 5-4 4 3 3-2 6 4\"></path><circle cx=\"9\" cy=\"9\" r=\"1.5\"></circle></svg></div>\n            <div class=\"pr-tagline\" data-eid=\"e75\"><span class=\"ds-badge ds-badge-warning\" data-eid=\"e76\">Low stock</span><span class=\"ds-badge ds-badge-quiet\" data-sample=\"Product#3.group\" data-eid=\"e77\">Teas</span></div>\n            <div class=\"pr-body\" data-eid=\"e78\">\n              <h2 class=\"pr-name\" data-sample=\"Product#3.name\" data-eid=\"e79\">Nettle and mint tea, 20 bags</h2>\n              <p class=\"pr-desc\" data-sample=\"Product#3.description\" data-eid=\"e80\">Grown on a small farm near Frome, dried slowly and packed in paper. Bright and grassy, good after a heavy meal.</p>\n              <p class=\"pr-med\" data-eid=\"e81\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 3v18M5 8h14M5 16h14\"></path></svg><span data-sample=\"Product#3.medicineNote\" data-eid=\"e82\">A food, not a medicine. Not for children under 2.</span></p>\n              <div class=\"pr-foot\" data-eid=\"e83\">\n                <span class=\"pr-price\" data-sample=\"Product#3.price\" data-eid=\"e84\">£6.40</span>\n                <a class=\"ds-btn ds-btn-secondary ds-btn-sm\" data-goto=\"home\" data-eid=\"e85\">Sign up</a>\n              </div>\n            </div>\n          </article>\n\n          <article class=\"pr-card\" data-eid=\"e86\">\n            <div class=\"pr-photo\" data-eid=\"e87\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"m3 16 5-4 4 3 3-2 6 4\"></path><circle cx=\"9\" cy=\"9\" r=\"1.5\"></circle></svg></div>\n            <div class=\"pr-tagline\" data-eid=\"e88\"><span class=\"ds-badge ds-badge-success\" data-eid=\"e89\">In stock</span><span class=\"ds-badge ds-badge-quiet\" data-sample=\"Product#4.group\" data-eid=\"e90\">Grow your own</span></div>\n            <div class=\"pr-body\" data-eid=\"e91\">\n              <h2 class=\"pr-name\" data-sample=\"Product#4.name\" data-eid=\"e92\">Wildflower seed tin</h2>\n              <p class=\"pr-desc\" data-sample=\"Product#4.description\" data-eid=\"e93\">Twelve kinds of seed for a strip of lawn or a window box, with a small card on when to sow and what will come up.</p>\n              <div class=\"pr-foot\" data-eid=\"e94\">\n                <span class=\"pr-price\" data-sample=\"Product#4.price\" data-eid=\"e95\">£4.50</span>\n                <a class=\"ds-btn ds-btn-secondary ds-btn-sm\" data-goto=\"home\" data-eid=\"e96\">Sign up</a>\n              </div>\n            </div>\n          </article>\n\n          <article class=\"pr-card\" data-eid=\"e97\">\n            <div class=\"pr-photo\" data-eid=\"e98\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"m3 16 5-4 4 3 3-2 6 4\"></path><circle cx=\"9\" cy=\"9\" r=\"1.5\"></circle></svg></div>\n            <div class=\"pr-tagline\" data-eid=\"e99\"><span class=\"ds-badge ds-badge-success\" data-eid=\"e100\">In stock</span><span class=\"ds-badge ds-badge-quiet\" data-sample=\"Product#5.group\" data-eid=\"e101\">Balms</span></div>\n            <div class=\"pr-body\" data-eid=\"e102\">\n              <h2 class=\"pr-name\" data-sample=\"Product#5.name\" data-eid=\"e103\">Donkey lip salve</h2>\n              <p class=\"pr-desc\" data-sample=\"Product#5.description\" data-eid=\"e104\">A little tin of balm with a hint of honey. Sold in singles and in a pack of three for a few pence less.</p>\n              <div class=\"pr-foot\" data-eid=\"e105\">\n                <span class=\"pr-price\" data-sample=\"Product#5.price\" data-eid=\"e106\">£3.20</span>\n                <a class=\"ds-btn ds-btn-secondary ds-btn-sm\" data-goto=\"home\" data-eid=\"e107\">Sign up</a>\n              </div>\n            </div>\n          </article>\n\n          <article class=\"pr-card\" data-eid=\"e108\">\n            <div class=\"pr-photo\" data-eid=\"e109\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"m3 16 5-4 4 3 3-2 6 4\"></path><circle cx=\"9\" cy=\"9\" r=\"1.5\"></circle></svg></div>\n            <div class=\"pr-tagline\" data-eid=\"e110\"><span class=\"ds-badge ds-badge-quiet\" data-sample=\"Product#6.group\" data-eid=\"e111\">Oils</span></div>\n            <div class=\"pr-body\" data-eid=\"e112\">\n              <h2 class=\"pr-name\" data-sample=\"Product#6.name\" data-eid=\"e113\">Rosehip face oil, 30ml</h2>\n              <p class=\"pr-desc\" data-sample=\"Product#6.description\" data-eid=\"e114\">Pressed rosehip with a drop of vitamin E, in a dark glass bottle with a dropper. Three drops in the evening is plenty.</p>\n              <p class=\"pr-med\" data-eid=\"e115\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 3v18M5 8h14M5 16h14\"></path></svg><span data-sample=\"Product#6.medicineNote\" data-eid=\"e116\">Patch test first if your skin is sensitive.</span></p>\n              <div class=\"pr-foot\" data-eid=\"e117\">\n                <span class=\"pr-price\" data-sample=\"Product#6.price\" data-eid=\"e118\">£18.00</span>\n                <a class=\"ds-btn ds-btn-secondary ds-btn-sm\" data-goto=\"home\" data-eid=\"e119\">Sign up</a>\n              </div>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"ds-page\" data-eid=\"e120\">\n      <section class=\"pr-close\" data-eid=\"e121\">\n        <div data-eid=\"e122\">\n          <span class=\"ds-eyebrow\" data-eid=\"e123\">Ready to buy</span>\n          <h2 class=\"ds-h2\" data-eid=\"e124\">Take your pick into the shop.</h2>\n          <p data-eid=\"e125\">Signing up takes a minute. Then you can put things in a basket and pay at the checkout.</p>\n        </div>\n        <div class=\"pr-close-btn\" data-eid=\"e126\">\n          <a class=\"ds-btn ds-btn-lg\" data-goto=\"home\" data-eid=\"e127\">Sign up</a>\n          <a class=\"ds-btn ds-btn-ghost\" data-goto=\"how-it-works\" data-eid=\"e128\">How it works</a>\n        </div>\n      </section>\n    </div>\n  </div>\n\n  <div data-part=\"footer\" data-eid=\"e129\"></div>\n\n  <section data-state=\"empty\" hidden=\"\" data-replaces=\"content\" data-eid=\"e130\">\n    <div class=\"ds-page\" style=\"padding-top: calc(48px * var(--space-scale, 1)); padding-bottom: calc(64px * var(--space-scale, 1))\" data-eid=\"e131\">\n      <div class=\"ds-page-head pr-head\" style=\"grid-template-columns: 1fr\" data-eid=\"e132\">\n        <div data-eid=\"e133\">\n          <span class=\"ds-eyebrow\" data-eid=\"e134\">The shop</span>\n          <h1 class=\"ds-h1 ds-display\" data-eid=\"e135\">Everything we sell, priced plainly.</h1>\n          <p class=\"pr-lead\" data-eid=\"e136\">Every price is the full price in pounds, nothing added at the counter.</p>\n        </div>\n      </div>\n      <div class=\"ds-empty\" data-eid=\"e137\">\n        <div class=\"ds-empty-icon\" data-eid=\"e138\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"m3 16 5-4 4 3 3-2 6 4\"></path><circle cx=\"9\" cy=\"9\" r=\"1.5\"></circle></svg></div>\n        <h2 class=\"ds-h3\" data-eid=\"e139\">Our products are on their way. Check back soon.</h2>\n        <p class=\"ds-muted\" style=\"margin-top: calc(8px * var(--space-scale, 1))\" data-eid=\"e140\">In the meantime, sign up and we will let you know when the first things are ready.</p>\n        <a class=\"ds-btn\" style=\"margin-top: calc(24px * var(--space-scale, 1))\" data-goto=\"home\" data-eid=\"e141\">Sign up</a>\n      </div>\n    </div>\n  </section>\n</main>","changes":[{"fix":"main-text","what":"the rule for \".pr-close .ds-btn\": words in the main colour take --primary-text"}]}