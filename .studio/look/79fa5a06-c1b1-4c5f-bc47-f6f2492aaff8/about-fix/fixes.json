{"html":"<style>\n  /* ---------- About page: bold, warm, green ---------- */\n  .ab-page { padding-bottom: 0; }\n\n  /* Hero */\n  .ab-hero {\n    position: relative;\n    display: grid;\n    grid-template-columns: 1.15fr 0.85fr;\n    gap: calc(48px * var(--space-scale, 1));\n    align-items: center;\n    padding-top: calc(40px * var(--space-scale, 1));\n    padding-bottom: calc(56px * var(--space-scale, 1));\n  }\n  .ab-hero-copy { position: relative; }\n  .ab-hero-copy h1 {\n    font-family: var(--font-heading);\n    font-size: clamp(2.6rem, 6.4vw, 5rem);\n    line-height: 0.98;\n    letter-spacing: -0.04em;\n    font-weight: 700;\n    margin: calc(16px * var(--space-scale, 1)) 0 0;\n    color: hsl(var(--foreground));\n    max-width: 14ch;\n  }\n  .ab-hero-copy h1 em {\n    font-style: normal;\n    color: hsl(var(--primary-text));\n  }\n  .ab-hero-lead {\n    margin: calc(24px * var(--space-scale, 1)) 0 calc(32px * var(--space-scale, 1));\n    max-width: 34ch;\n    font-size: 18px;\n    line-height: 1.55;\n    color: hsl(var(--muted-foreground));\n  }\n\n  /* Photo frame: the owner's picture with an accent shape behind it */\n  .ab-frame {\n    position: relative;\n    aspect-ratio: 4 / 5;\n    border-radius: calc(var(--radius) * 1.6);\n    overflow: visible;\n  }\n  .ab-frame .ds-img {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    border-radius: calc(var(--radius) * 1.6);\n    box-shadow: var(--shadow);\n    border: 1px solid hsl(var(--border));\n  }\n  .ab-frame .ab-tag {\n    position: absolute;\n    left: calc(-16px * var(--space-scale, 1));\n    bottom: calc(24px * var(--space-scale, 1));\n    background: hsl(var(--background));\n    border-radius: 999px;\n    padding: calc(10px * var(--space-scale, 1)) calc(20px * var(--space-scale, 1));\n    box-shadow: var(--shadow);\n    display: flex;\n    align-items: center;\n    gap: calc(10px * var(--space-scale, 1));\n    font-size: 14px;\n    font-weight: 600;\n    color: hsl(var(--foreground));\n    max-width: calc(100% - 8px);\n  }\n  .ab-tag .ab-dot {\n    width: 10px; height: 10px; border-radius: 50%;\n    background: hsl(var(--primary));\n    flex: none;\n  }\n  .ab-frame .ab-tag span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n\n  /* What we sell band */\n  .ab-band { padding-top: calc(64px * var(--space-scale, 1)); padding-bottom: calc(64px * var(--space-scale, 1)); position: relative; }\n  .ab-band .ds-eyebrow { color: hsl(var(--band-foreground) / 0.85); }\n  .ab-band h2 {\n    color: hsl(var(--band-foreground));\n    margin: calc(8px * var(--space-scale, 1)) 0 0;\n    max-width: 20ch;\n  }\n  .ab-shelf {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: calc(16px * var(--space-scale, 1));\n    margin-top: calc(32px * var(--space-scale, 1));\n  }\n  .ab-item {\n    border-radius: var(--radius);\n    padding: calc(24px * var(--space-scale, 1));\n    background: hsl(var(--background));\n    box-shadow: var(--shadow);\n    display: flex;\n    flex-direction: column;\n    gap: calc(8px * var(--space-scale, 1));\n  }\n  .ab-item .ab-item-icon {\n    width: 44px; height: 44px;\n    border-radius: 14px;\n    display: grid; place-items: center;\n    background: hsl(var(--primary) / 0.12);\n    color: hsl(var(--primary-text));\n    margin-bottom: calc(4px * var(--space-scale, 1));\n  }\n  .ab-item h3 { margin: 0; font-family: var(--font-heading); font-size: 20px; letter-spacing: -0.01em; color: hsl(var(--foreground)); }\n  .ab-item p { margin: 0; font-size: 15px; line-height: 1.5; color: hsl(var(--muted-foreground)); }\n  .ab-item .ab-price {\n    margin-top: calc(8px * var(--space-scale, 1));\n    font-family: var(--font-heading);\n    font-size: 15px;\n    font-weight: 700;\n    color: hsl(var(--primary-text));\n    font-variant-numeric: tabular-nums;\n  }\n  .ab-more {\n    margin-top: calc(24px * var(--space-scale, 1));\n    display: inline-flex;\n    align-items: center;\n    gap: calc(8px * var(--space-scale, 1));\n    color: hsl(var(--band-foreground));\n    font-weight: 600;\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  /* Story + facts */\n  .ab-story {\n    display: grid;\n    grid-template-columns: 1.4fr 1fr;\n    gap: calc(48px * var(--space-scale, 1));\n    align-items: start;\n    padding-top: calc(64px * var(--space-scale, 1));\n    padding-bottom: calc(64px * var(--space-scale, 1));\n  }\n  .ab-story h2 { margin: calc(8px * var(--space-scale, 1)) 0 calc(16px * var(--space-scale, 1)); max-width: 18ch; }\n  .ab-story p { font-size: 16px; line-height: 1.65; color: hsl(var(--foreground)); margin: 0 0 calc(16px * var(--space-scale, 1)); max-width: 62ch; }\n  .ab-story p.ab-muted-line { color: hsl(var(--muted-foreground)); }\n  .ab-facts {\n    background: hsl(var(--primary) / 0.08);\n    border-radius: var(--radius);\n    padding: calc(24px * var(--space-scale, 1));\n    display: grid;\n    gap: calc(16px * var(--space-scale, 1));\n  }\n  .ab-fact { display: grid; gap: calc(2px * var(--space-scale, 1)); padding-bottom: calc(16px * var(--space-scale, 1)); border-bottom: 1px solid hsl(var(--border)); }\n  .ab-fact:last-child { border-bottom: 0; padding-bottom: 0; }\n  .ab-fact b { font-family: var(--font-heading); font-size: 24px; letter-spacing: -0.02em; color: hsl(var(--foreground)); font-variant-numeric: tabular-nums; }\n  .ab-fact span { font-size: 14px; color: hsl(var(--muted-foreground)); }\n\n  /* Closing call */\n  .ab-close {\n    position: relative;\n    border-radius: calc(var(--radius) * 1.4);\n    padding: calc(48px * var(--space-scale, 1));\n    background: hsl(var(--primary));\n    color: hsl(var(--primary-foreground));\n    overflow: hidden;\n    display: grid;\n    grid-template-columns: 1fr auto;\n    gap: calc(24px * var(--space-scale, 1));\n    align-items: center;\n    margin-top: calc(8px * var(--space-scale, 1));\n  }\n  .ab-close h2 {\n    color: hsl(var(--primary-foreground));\n    margin: calc(6px * var(--space-scale, 1)) 0 calc(8px * var(--space-scale, 1));\n    max-width: 18ch;\n  }\n  .ab-close p { margin: 0; color: hsl(var(--primary-foreground) / 0.9); font-size: 16px; max-width: 46ch; }\n  .ab-close .ds-eyebrow { color: hsl(var(--primary-foreground) / 0.8); }\n  .ab-close .ds-btn-secondary {\n    border: 2px solid hsl(var(--primary-foreground));\n    color: hsl(var(--primary-foreground));\n    background: transparent;\n    white-space: nowrap;\n  }\n  .ab-close .ds-btn-secondary:hover { background: hsl(var(--primary-foreground) / 0.12); }\n  .ab-rings { right: calc(-40px * var(--space-scale, 1)); top: calc(-40px * var(--space-scale, 1)); width: 240px; height: 240px; opacity: 0.3; color: hsl(var(--primary-foreground)); }\n\n  .ab-close-wrap { padding-top: calc(8px * var(--space-scale, 1)); padding-bottom: calc(64px * var(--space-scale, 1)); }\n\n  @media (max-width: 860px) {\n    .ab-hero { grid-template-columns: 1fr; gap: calc(32px * var(--space-scale, 1)); }\n    .ab-frame { aspect-ratio: 5 / 4; max-width: 460px; }\n    .ab-frame .ab-tag { left: calc(16px * var(--space-scale, 1)); }\n    .ab-shelf { grid-template-columns: 1fr; }\n    .ab-story { grid-template-columns: 1fr; gap: calc(32px * var(--space-scale, 1)); }\n    .ab-close { grid-template-columns: 1fr; }\n  }\n</style><main data-screen=\"about\" data-eid=\"e1\">\n\n  <section class=\"ds-band-bold ab-band\" data-eid=\"e2\">\n    <div class=\"ds-page ab-band-inner\" data-eid=\"e3\">\n      <div class=\"ds-page-head\" style=\"padding: 0\" data-eid=\"e4\">\n        <div data-eid=\"e5\">\n          <span class=\"ds-eyebrow\" data-sample=\"\" data-eid=\"e6\">About Donkey</span>\n          <h1 class=\"ds-display\" data-sample=\"PageWording.About.heading\" style=\"color: hsl(var(--band-foreground)); margin: calc(12px * var(--space-scale, 1)) 0 0\" data-eid=\"e7\">We sell the things that make a house feel lived in.</h1>\n          <p class=\"ab-hero-lead\" data-sample=\"PageWording.About.intro\" style=\"color: hsl(var(--band-foreground) / 0.9); max-width: 44ch\" data-eid=\"e8\">A small shop for kitchens, doorsteps and quiet corners. Every price is in pounds, and every item is picked by hand.</p>\n          <div class=\"ds-row\" style=\"margin-top: calc(32px * var(--space-scale, 1))\" data-eid=\"e9\">\n            <a class=\"ds-btn ds-btn-lg\" data-goto=\"editor-sign-in\" data-eid=\"e10\">Sign up</a>\n            <a class=\"ab-more\" data-goto=\"products\" style=\"margin: 0\" data-eid=\"e11\">See our products\n              <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg>\n            </a>\n          </div>\n        </div>\n        <div class=\"ds-deco ab-rings\" aria-hidden=\"true\" data-eid=\"e12\">\n          <svg viewBox=\"0 0 200 200\" width=\"100%\" height=\"100%\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"100\" cy=\"100\" r=\"90\"></circle><circle cx=\"100\" cy=\"100\" r=\"62\"></circle><circle cx=\"100\" cy=\"100\" r=\"34\"></circle></svg>\n        </div>\n      </div>\n\n      <div class=\"ab-frame\" style=\"margin-top: calc(40px * var(--space-scale, 1))\" data-eid=\"e13\">\n        <div class=\"ds-img\" data-sample=\"\" aria-label=\"A photo of the Donkey shop\" data-eid=\"e14\"></div>\n        <div class=\"ab-tag\" data-eid=\"e15\"><span class=\"ab-dot\" aria-hidden=\"true\" data-eid=\"e16\"></span><span data-sample=\"\" data-eid=\"e17\">Open since 2016, on Mill Lane</span></div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"ds-page ab-page\" data-eid=\"e18\">\n    <section class=\"ab-story\" data-eid=\"e19\">\n      <div data-eid=\"e20\">\n        <span class=\"ds-eyebrow\" data-eid=\"e21\">The short story</span>\n        <h2 class=\"ds-h1\" data-eid=\"e22\">Made to last, sold at an honest price.</h2>\n        <p data-sample=\"PageWording.About.intro\" data-eid=\"e23\">We started Donkey with one rule: only sell things we would keep in our own homes. That means everyday pieces that hold up, from people we know by name.</p>\n        <p class=\"ab-muted-line\" data-sample=\"\" data-eid=\"e24\">We look for small makers who care about how a thing wears in, not how fast it sells. When something runs out, we say so; we would rather be honest than busy.</p>\n        <p class=\"ab-muted-line\" data-sample=\"\" data-eid=\"e25\">Everything ships from our shop on Mill Lane, packed by the same people who chose it.</p>\n        <a class=\"ab-more\" data-goto=\"how-it-works\" style=\"color: hsl(var(--primary-text))\" data-eid=\"e26\">How buying from Donkey works\n          <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg>\n        </a>\n      </div>\n      <div class=\"ab-facts\" data-sample=\"\" data-eid=\"e27\">\n        <div class=\"ab-fact\" data-eid=\"e28\"><b>2016</b><span data-eid=\"e29\">Year we opened the doors</span></div>\n        <div class=\"ab-fact\" data-eid=\"e30\"><b>40+</b><span data-eid=\"e31\">Small makers we buy from</span></div>\n        <div class=\"ab-fact\" data-eid=\"e32\"><b>£12.50</b><span data-eid=\"e33\">Where most of our prices start</span></div>\n        <div class=\"ab-fact\" data-eid=\"e34\"><b>3 to 5 days</b><span data-eid=\"e35\">From our shop to your door</span></div>\n      </div>\n    </section>\n  </div>\n\n  <section class=\"ds-band ab-band\" data-eid=\"e36\">\n    <div class=\"ds-page\" data-eid=\"e37\">\n      <span class=\"ds-eyebrow\" data-eid=\"e38\">What we sell</span>\n      <h2 class=\"ds-h1\" style=\"color: hsl(var(--band-foreground)); max-width: 20ch\" data-eid=\"e39\">A few things you will find on the shelf.</h2>\n      <div class=\"ab-shelf\" data-eid=\"e40\">\n        <article class=\"ab-item\" data-sample=\"Product#1\" data-eid=\"e41\">\n          <div class=\"ab-item-icon\" aria-hidden=\"true\" data-eid=\"e42\">\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M6 8h12l-1.5 11h-9L6 8Z\"></path><path d=\"M9 8V6a3 3 0 0 1 6 0v2\"></path></svg>\n          </div>\n          <h3 data-sample=\"Product#1.name\" data-eid=\"e43\">Stoneware mug</h3>\n          <p data-sample=\"Product#1.description\" data-eid=\"e44\">Thrown by hand in a soft oatmeal glaze. Holds a generous cup of tea.</p>\n          <span class=\"ab-price\" data-sample=\"Product#1.pricePence\" data-eid=\"e45\">£14.00</span>\n        </article>\n        <article class=\"ab-item\" data-sample=\"Product#2\" data-eid=\"e46\">\n          <div class=\"ab-item-icon\" aria-hidden=\"true\" data-eid=\"e47\">\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"></rect><path d=\"M4 9h16M9 9v11\"></path></svg>\n          </div>\n          <h3 data-sample=\"Product#2.name\" data-eid=\"e48\">Linen tea towel</h3>\n          <p data-sample=\"Product#2.description\" data-eid=\"e49\">Woven in a mill we have worked with for years. Softens with every wash.</p>\n          <span class=\"ab-price\" data-sample=\"Product#2.pricePence\" data-eid=\"e50\">£12.50</span>\n        </article>\n        <article class=\"ab-item\" data-sample=\"Product#3\" data-eid=\"e51\">\n          <div class=\"ab-item-icon\" aria-hidden=\"true\" data-eid=\"e52\">\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M12 3c3 4 5 6 5 9a5 5 0 0 1-10 0c0-3 2-5 5-9Z\"></path></svg>\n          </div>\n          <h3 data-sample=\"Product#3.name\" data-eid=\"e53\">Beeswax candle</h3>\n          <p data-sample=\"Product#3.description\" data-eid=\"e54\">A soft honey scent, poured in small batches. Burns for about forty hours.</p>\n          <span class=\"ab-price\" data-sample=\"Product#3.pricePence\" data-eid=\"e55\">£18.00</span>\n        </article>\n      </div>\n      <a class=\"ab-more\" data-goto=\"products\" data-eid=\"e56\">See every product and price\n        <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg>\n      </a>\n    </div>\n  </section>\n\n  <div class=\"ds-page ab-close-wrap\" data-eid=\"e57\">\n    <div class=\"ab-close\" data-eid=\"e58\">\n      <div data-eid=\"e59\">\n        <span class=\"ds-eyebrow\" data-eid=\"e60\">Ready when you are</span>\n        <h2 class=\"ds-h1\" data-eid=\"e61\">Come and have a look around.</h2>\n        <p data-eid=\"e62\">Shoppers sign up to buy. It is free, and it takes a minute.</p>\n      </div>\n      <a class=\"ds-btn ds-btn-secondary ds-btn-lg\" data-goto=\"editor-sign-in\" data-eid=\"e63\">Sign up</a>\n      <div class=\"ds-deco ab-rings\" aria-hidden=\"true\" data-eid=\"e64\">\n        <svg viewBox=\"0 0 200 200\" width=\"100%\" height=\"100%\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"100\" cy=\"100\" r=\"90\"></circle><circle cx=\"100\" cy=\"100\" r=\"62\"></circle><circle cx=\"100\" cy=\"100\" r=\"34\"></circle></svg>\n      </div>\n    </div>\n  </div>\n\n  <div data-part=\"footer\" data-eid=\"e65\"></div>\n</main>","changes":[]}