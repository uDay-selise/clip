{"html":"<style>\n    .site-top { display: flex; align-items: center; gap: calc(24px * var(--space-scale, 1)); padding: calc(14px * var(--space-scale, 1)) 0; flex-wrap: nowrap; }\n    .site-top .ds-brand-link { flex-shrink: 0; }\n    .site-nav { display: flex; gap: calc(22px * var(--space-scale, 1)); font-size: 15px; margin-left: calc(12px * var(--space-scale, 1)); }\n    .site-nav a { color: hsl(var(--muted-foreground)); text-decoration: none; white-space: nowrap; padding: 4px 0; font-weight: 500; }\n    .site-nav a:hover { color: hsl(var(--foreground)); }\n    .site-top-actions { display: flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); flex-shrink: 0; }\n    .site-top .ds-brand-text { font-family: var(--font-heading); font-weight: 700; font-size: 22px; letter-spacing: -0.03em; color: hsl(var(--foreground)); }\n    .site-top .ds-brand-link { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); text-decoration: none; }\n    .site-top .ds-brand-link img.ds-brand { height: 32px; width: auto; }\n    .site-mark { width: 32px; height: 32px; border-radius: 10px; background: hsl(var(--brand)); display: inline-flex; align-items: center; justify-content: center; color: hsl(var(--brand-foreground)); font-family: var(--font-heading); font-weight: 700; font-size: 15px; letter-spacing: -0.02em; }\n  </style>\n  <header style=\"background: hsl(var(--background)); border-bottom: 1px solid hsl(var(--border));\" data-eid=\"e1\">\n    <div class=\"ds-bar site-top\" data-eid=\"e2\">\n      <a class=\"ds-brand-link\" data-goto=\"home\" data-eid=\"e3\"><span class=\"site-mark\" aria-hidden=\"true\" data-eid=\"e4\">D</span><span class=\"ds-brand-text\" data-eid=\"e5\">Donkey website</span></a>\n      <nav class=\"site-nav ds-only-wide\" aria-label=\"Pages\" data-eid=\"e6\">\n        <a data-goto=\"home\" data-eid=\"e7\">Home</a>\n        <a data-goto=\"how-it-works\" data-eid=\"e8\">How it works</a>\n        <a data-goto=\"about\" data-eid=\"e9\">About</a>\n        <a data-goto=\"contact\" data-eid=\"e10\">Contact</a>\n      </nav>\n      <span class=\"ds-spacer\" data-eid=\"e11\"></span>\n      <div class=\"site-top-actions\" data-eid=\"e12\">\n        <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e13\">\n          <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e14\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n          <button aria-label=\"Dark\" data-eid=\"e15\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n          <button aria-label=\"Auto\" data-eid=\"e16\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n        </div>\n        <a class=\"ds-btn ds-btn-secondary ds-btn-sm ds-only-wide\" data-goto=\"editor-sign-in\" data-eid=\"e17\">Sign in</a>\n        <a class=\"ds-btn ds-btn-sm ds-only-wide\" href=\"#\" aria-label=\"Sign up\" data-eid=\"e18\">Sign up</a>\n        <details class=\"ds-menu ds-only-narrow\">\n          <summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary>\n          <div class=\"ds-menu-list\" data-eid=\"e19\">\n            <a data-goto=\"home\" data-eid=\"e20\">Home</a>\n            <a data-goto=\"how-it-works\" data-eid=\"e21\">How it works</a>\n            <a data-goto=\"products\" data-eid=\"e22\">Products</a>\n            <a data-goto=\"about\" data-eid=\"e23\">About</a>\n            <a data-goto=\"contact\" data-eid=\"e24\">Contact</a>\n            <a data-goto=\"editor-sign-in\" data-eid=\"e25\">Sign in</a>\n            <a href=\"#\" aria-label=\"Sign up\" data-eid=\"e26\">Sign up</a>\n            <div style=\"padding: calc(8px * var(--space-scale, 1)) 0 0; border-top: 1px solid hsl(var(--border)); margin-top: calc(8px * var(--space-scale, 1));\" data-eid=\"e27\">\n              <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e28\">\n                <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e29\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n                <button aria-label=\"Dark\" data-eid=\"e30\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n                <button aria-label=\"Auto\" data-eid=\"e31\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n              </div>\n            </div>\n          </div>\n        </details>\n      </div>\n    </div>\n  </header>","changes":[]}