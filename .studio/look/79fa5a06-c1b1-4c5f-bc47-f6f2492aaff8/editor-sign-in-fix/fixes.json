{"html":"<style>\n  .esi-root { position: relative; min-height: 100vh; background: hsl(var(--background)); }\n  .esi-top { display: flex; align-items: center; gap: calc(16px * var(--space-scale, 1)); padding: calc(24px * var(--space-scale, 1)) 0; }\n  .esi-top .ds-spacer { flex: 1; }\n  .esi-brand { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 800; font-size: 20px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; }\n  .esi-mark { width: 34px; height: 34px; border-radius: calc(var(--radius) * 1.1); background: hsl(var(--primary)); display: inline-flex; align-items: center; justify-content: center; color: hsl(var(--primary-foreground)); flex: none; }\n  .esi-switches { display: flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); }\n\n  .esi-hero { position: relative; isolation: isolate; overflow: hidden; border-radius: calc(var(--radius) * 1.8); background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); padding: calc(48px * var(--space-scale, 1)) calc(32px * var(--space-scale, 1)); margin-bottom: calc(32px * var(--space-scale, 1)); }\n  .esi-hero-inner { position: relative; max-width: 640px; }\n  .esi-eyebrow { display: inline-block; font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: hsl(var(--primary-foreground) / 0.75); }\n  .esi-hero h1 { font-family: var(--font-heading); font-weight: 800; letter-spacing: -0.035em; line-height: 1.02; font-size: clamp(2.4rem, 6vw, 4.25rem); margin: calc(14px * var(--space-scale, 1)) 0 0; color: inherit; }\n  .esi-hero p { margin: calc(20px * var(--space-scale, 1)) 0 0; font-size: 17px; line-height: 1.55; max-width: 34em; color: hsl(var(--primary-foreground) / 0.9); }\n  .esi-hero-actions { margin-top: calc(32px * var(--space-scale, 1)); display: flex; flex-wrap: wrap; align-items: center; gap: calc(16px * var(--space-scale, 1)); }\n  .esi-hero .ds-btn { background: hsl(var(--primary-foreground)); color: hsl(var(--primary-text)); font-size: 17px; padding-left: calc(32px * var(--space-scale, 1)); padding-right: calc(32px * var(--space-scale, 1)); }\n  .esi-hero .ds-btn-secondary { background: transparent; color: hsl(var(--primary-foreground)); border: 1.5px solid hsl(var(--primary-foreground) / 0.6); }\n  .esi-hero .ds-btn-secondary:hover { border-color: hsl(var(--primary-foreground)); }\n  .esi-help { font-size: 14px; color: hsl(var(--primary-foreground) / 0.75); }\n\n  .esi-ring { width: 300px; height: 300px; top: -70px; right: -70px; border-radius: 999px; border: 34px solid hsl(var(--primary-foreground) / 0.12); }\n  .esi-ring-2 { width: 180px; height: 180px; bottom: -60px; right: 90px; border-radius: 999px; border: 20px solid hsl(var(--primary-foreground) / 0.1); }\n  .esi-dot { width: 120px; height: 120px; top: 22px; right: 190px; border-radius: 999px; background: hsl(var(--primary-foreground) / 0.08); }\n\n  .esi-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(16px * var(--space-scale, 1)); }\n  .esi-card { background: hsl(var(--muted)); border-radius: calc(var(--radius) * 1.2); padding: calc(24px * var(--space-scale, 1)); display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1)); }\n  .esi-card .ds-label-caps { color: hsl(var(--muted-foreground)); }\n  .esi-card h3 { font-family: var(--font-heading); font-weight: 700; font-size: 18px; letter-spacing: -0.02em; margin: 0; color: hsl(var(--foreground)); }\n  .esi-card p { margin: 0; font-size: 14px; line-height: 1.5; color: hsl(var(--muted-foreground)); }\n  .esi-card .ds-num { font-family: var(--font-heading); font-variant-numeric: tabular-nums; }\n\n  .esi-footrow { margin-top: calc(32px * var(--space-scale, 1)); padding-top: calc(20px * var(--space-scale, 1)); border-top: 1px solid hsl(var(--border)); display: flex; flex-wrap: wrap; gap: calc(8px * var(--space-scale, 1)) calc(24px * var(--space-scale, 1)); align-items: baseline; font-size: 14px; color: hsl(var(--muted-foreground)); }\n  .esi-footrow a { color: hsl(var(--primary-text)); text-decoration: none; font-weight: 600; }\n\n  .esi-notice { margin-bottom: calc(24px * var(--space-scale, 1)); }\n\n  @media (max-width: 820px) {\n    .esi-cards { grid-template-columns: 1fr; }\n    .esi-hero { padding: calc(32px * var(--space-scale, 1)) calc(24px * var(--space-scale, 1)); }\n  }\n</style><main data-screen=\"editor-sign-in\" class=\"esi-root\" data-eid=\"e1\">\n  <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: calc(48px * var(--space-scale, 1))\" data-eid=\"e2\">\n\n    <div class=\"esi-top\" data-eid=\"e3\">\n      <a class=\"esi-brand\" data-goto=\"home\" data-eid=\"e4\">\n        <span class=\"esi-mark\" aria-hidden=\"true\" data-eid=\"e5\">\n          <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M5 9h14M5 9v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M5 9l2-4M19 9l-2-4M9 13h6\"></path></svg>\n        </span>\n        Donkey\n      </a>\n      <span class=\"ds-spacer\" data-eid=\"e6\"></span>\n      <div class=\"esi-switches\" data-eid=\"e7\">\n        <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e8\">\n          <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e9\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n          <button aria-label=\"Dark\" data-eid=\"e10\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n          <button aria-label=\"Auto\" data-eid=\"e11\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n        </div>\n        <a class=\"ds-btn ds-btn-ghost ds-btn-sm\" data-goto=\"home\" data-eid=\"e12\">Back to the shop</a>\n      </div>\n    </div>\n\n    <section class=\"esi-hero\" data-eid=\"e13\">\n      <span class=\"ds-deco esi-ring\" aria-hidden=\"true\" data-eid=\"e14\"></span>\n      <span class=\"ds-deco esi-ring-2\" aria-hidden=\"true\" data-eid=\"e15\"></span>\n      <span class=\"ds-deco esi-dot\" aria-hidden=\"true\" data-eid=\"e16\"></span>\n      <div class=\"esi-hero-inner\" data-eid=\"e17\">\n        <span class=\"esi-eyebrow\" data-sample=\"editorSignIn.pageKicker\" data-eid=\"e18\">Editors' area</span>\n        <h1 data-sample=\"home.heading\" data-eid=\"e19\">Keep the shop looking sharp.</h1>\n        <p data-sample=\"editorSignIn.intro\" data-eid=\"e20\">This is where the Donkey team updates the words on the site, the delivery and returns details, and every product with its price and photo. Shoppers never see this page.</p>\n        <div class=\"esi-hero-actions\" data-eid=\"e21\">\n          <a class=\"ds-btn ds-btn-lg\" data-goto=\"editor\" data-eid=\"e22\">Sign in</a>\n          <span class=\"esi-help\" data-eid=\"e23\">For invited editors only.</span>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"esi-cards\" data-eid=\"e24\">\n      <div class=\"esi-card\" data-eid=\"e25\">\n        <span class=\"ds-label-caps\" data-eid=\"e26\">What you can change</span>\n        <h3 data-eid=\"e27\">Every page's wording</h3>\n        <p data-eid=\"e28\">The headline and intro on Home, How it works and Contact, kept warm and plain.</p>\n      </div>\n      <div class=\"esi-card\" data-eid=\"e29\">\n        <span class=\"ds-label-caps\" data-eid=\"e30\">Products</span>\n        <h3 data-eid=\"e31\">Prices and photos</h3>\n        <p class=\"ds-num\" data-eid=\"e32\"><span data-sample=\"\" data-eid=\"e33\">14</span> products on the site, <span data-sample=\"\" data-eid=\"e34\">9</span> of them visible to shoppers.</p>\n      </div>\n      <div class=\"esi-card\" data-eid=\"e35\">\n        <span class=\"ds-label-caps\" data-eid=\"e36\">Delivery and returns</span>\n        <h3 data-eid=\"e37\">The details shoppers read first</h3>\n        <p data-eid=\"e38\">One delivery text and one returns text, shown as you write them.</p>\n      </div>\n    </div>\n\n    <div class=\"esi-footrow\" data-eid=\"e39\">\n      <span data-sample=\"editorSignIn.help\" data-eid=\"e40\">Lost your invite email, or need a new one? Ask the shop owner to send it again.</span>\n      <span class=\"ds-spacer\" data-eid=\"e41\"></span>\n      <a data-goto=\"home\" data-eid=\"e42\">Home</a>\n      <a data-goto=\"how-it-works\" data-eid=\"e43\">How it works</a>\n      <a data-goto=\"products\" data-eid=\"e44\">Products</a>\n      <a data-goto=\"contact\" data-eid=\"e45\">Contact</a>\n    </div>\n\n    <div data-part=\"footer\" data-eid=\"e46\"></div>\n  </div>\n\n  <section data-state=\"not-allowed\" hidden=\"\" data-eid=\"e47\">\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: calc(48px * var(--space-scale, 1))\" data-eid=\"e48\">\n      <div class=\"esi-top\" data-eid=\"e49\">\n        <a class=\"esi-brand\" data-goto=\"home\" data-eid=\"e50\">\n          <span class=\"esi-mark\" aria-hidden=\"true\" data-eid=\"e51\">\n            <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M5 9h14M5 9v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M5 9l2-4M19 9l-2-4M9 13h6\"></path></svg>\n          </span>\n          Donkey\n        </a>\n        <span class=\"ds-spacer\" data-eid=\"e52\"></span>\n        <div class=\"esi-switches\" data-eid=\"e53\">\n          <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e54\">\n            <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e55\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n            <button aria-label=\"Dark\" data-eid=\"e56\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n            <button aria-label=\"Auto\" data-eid=\"e57\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n          </div>\n          <a class=\"ds-btn ds-btn-ghost ds-btn-sm\" data-goto=\"home\" data-eid=\"e58\">Back to the shop</a>\n        </div>\n      </div>\n\n      <div class=\"ds-page-narrow\" style=\"padding-top: calc(64px * var(--space-scale, 1)); padding-bottom: calc(64px * var(--space-scale, 1))\" data-eid=\"e59\">\n        <div class=\"ds-empty\" data-eid=\"e60\">\n          <div class=\"ds-empty-icon\" data-eid=\"e61\">\n            <svg viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"10\" rx=\"2\"></rect><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"></path></svg>\n          </div>\n          <h2 class=\"ds-h2\" style=\"margin-top: calc(16px * var(--space-scale, 1))\" data-eid=\"e62\">Editors only.</h2>\n          <p class=\"ds-muted\" style=\"max-width: 32em; margin: calc(8px * var(--space-scale, 1)) auto 0\" data-eid=\"e63\">This area is for people invited to look after the shop. If you think you should be here, ask the shop owner to send you an invite.</p>\n          <div class=\"ds-row\" style=\"justify-content: center; margin-top: calc(24px * var(--space-scale, 1))\" data-eid=\"e64\">\n            <a class=\"ds-btn\" data-goto=\"home\" data-eid=\"e65\">Back to the shop</a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>","changes":[{"fix":"main-text","what":"the rule for \".esi-hero .ds-btn\": words in the main colour take --primary-text"}]}