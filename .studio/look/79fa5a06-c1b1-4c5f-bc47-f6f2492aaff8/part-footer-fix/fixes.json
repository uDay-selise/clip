{"html":"<style>\n    .site-foot { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: calc(32px * var(--space-scale, 1)); padding: calc(40px * var(--space-scale, 1)) 0 calc(32px * var(--space-scale, 1)); }\n    .site-foot-brand { display: flex; flex-direction: column; gap: calc(10px * var(--space-scale, 1)); }\n    .site-foot-brand .ds-brand-link { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); text-decoration: none; }\n    .site-foot-brand .ds-brand-text { font-family: var(--font-heading); font-weight: 700; font-size: 20px; letter-spacing: -0.02em; color: hsl(var(--band-foreground)); }\n    .site-foot-brand .ds-brand-link img.ds-brand { height: 30px; width: auto; }\n    .site-foot-mark { width: 30px; height: 30px; border-radius: 9px; background: hsl(var(--band-foreground)); display: inline-flex; align-items: center; justify-content: center; color: hsl(var(--band)); font-family: var(--font-heading); font-weight: 700; font-size: 14px; }\n    .site-foot-line { font-size: 14px; color: inherit; opacity: 0.72; max-width: 26em; }\n    .site-foot h3 { margin-bottom: calc(10px * var(--space-scale, 1)); }\n    .site-foot-links { display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1)); font-size: 14px; }\n    .site-foot-links a { color: inherit; opacity: 0.86; text-decoration: none; }\n    .site-foot-links a:hover { opacity: 1; text-decoration: underline; }\n    .site-foot-contact { display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1)); font-size: 14px; }\n    .site-foot-contact a { color: inherit; text-decoration: none; opacity: 0.86; }\n    .site-foot-contact a:hover { opacity: 1; text-decoration: underline; }\n    .site-foot-base { display: flex; align-items: center; justify-content: space-between; gap: calc(16px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) 0; font-size: 13px; flex-wrap: wrap; }\n    @media (max-width: 860px) { .site-foot { grid-template-columns: 1fr; gap: calc(28px * var(--space-scale, 1)); } }\n  </style>\n  <footer style=\"background: hsl(var(--band)); color: hsl(var(--band-foreground)); border-top: 1px solid hsl(var(--border));\" data-eid=\"e1\">\n    <div class=\"ds-bar\" style=\"flex-direction: column; gap: 0;\" data-eid=\"e2\">\n      <div class=\"site-foot\" data-eid=\"e3\">\n        <div class=\"site-foot-brand\" data-eid=\"e4\">\n          <a class=\"ds-brand-link\" data-goto=\"home\" data-eid=\"e5\"><span class=\"site-foot-mark\" aria-hidden=\"true\" data-eid=\"e6\">D</span><span class=\"ds-brand-text\" data-eid=\"e7\">Donkey website</span></a>\n          <p class=\"site-foot-line\" data-eid=\"e8\">Everyday goods and small prices from Donkey.</p>\n        </div>\n        <div data-eid=\"e9\">\n          <span class=\"ds-label-caps\" style=\"color: inherit; opacity: 0.7\" data-eid=\"e10\">The pages</span>\n          <div class=\"site-foot-links\" style=\"margin-top: calc(12px * var(--space-scale, 1));\" data-eid=\"e11\">\n            <a data-goto=\"home\" data-eid=\"e12\">Home</a>\n            <a data-goto=\"how-it-works\" data-eid=\"e13\">How it works</a>\n            <a data-goto=\"about\" data-eid=\"e14\">About</a>\n            <a data-goto=\"contact\" data-eid=\"e15\">Contact</a>\n          </div>\n        </div>\n        <div data-eid=\"e16\">\n          <span class=\"ds-label-caps\" style=\"color: inherit; opacity: 0.7\" data-eid=\"e17\">Reach Donkey</span>\n          <div class=\"site-foot-contact\" style=\"margin-top: calc(12px * var(--space-scale, 1));\" data-eid=\"e18\">\n            <a href=\"#\" data-sample=\"PageWording#contact.email\" data-eid=\"e19\">hello@donkey.shop</a>\n            <a href=\"#\" data-sample=\"PageWording#contact.phone\" data-eid=\"e20\">01632 960 412</a>\n            <span style=\"opacity: 0.7\" data-sample=\"PageWording#contact.address\" data-eid=\"e21\">12 Larkfield Road, Nottingham NG7 4DQ</span>\n          </div>\n        </div>\n      </div>\n      <div class=\"site-foot-base\" data-eid=\"e22\">\n        <span style=\"opacity: 0.7\" data-eid=\"e23\">Donkey shop. Prices in pounds.</span>\n      </div>\n    </div>\n  </footer>","changes":[]}