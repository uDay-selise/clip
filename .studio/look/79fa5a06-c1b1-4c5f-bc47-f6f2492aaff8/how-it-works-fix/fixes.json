{"html":"<style>\n  .hi-top { display: flex; align-items: center; gap: calc(24px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) 0; }\n  .hi-brand { display: inline-flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); font-family: var(--font-heading); font-weight: 700; font-size: 20px; letter-spacing: -0.03em; color: hsl(var(--foreground)); text-decoration: none; }\n  .hi-mark { width: 32px; height: 32px; border-radius: var(--radius); background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); display: inline-grid; place-items: center; box-shadow: var(--shadow); }\n  .hi-mark svg { width: 18px; height: 18px; }\n  .hi-links { display: flex; gap: calc(24px * var(--space-scale, 1)); font-size: 15px; }\n  .hi-links a { color: hsl(var(--muted-foreground)); text-decoration: none; padding: 8px 0; }\n  .hi-links a[aria-current] { color: hsl(var(--foreground)); font-weight: 600; }\n  .hi-actions { display: flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); }\n\n  .hi-hero { position: relative; padding-top: calc(32px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1)); }\n  .hi-hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: calc(48px * var(--space-scale, 1)); align-items: end; }\n  .hi-display { font-family: var(--font-heading); font-size: clamp(40px, 7.2vw, 76px); line-height: 0.98; letter-spacing: -0.045em; margin: 12px 0 0; }\n  .hi-lead { margin: calc(20px * var(--space-scale, 1)) 0 0; max-width: 30em; font-size: 18px; line-height: 1.6; color: hsl(var(--muted-foreground)); }\n  .hi-hero-note { display: grid; gap: calc(12px * var(--space-scale, 1)); padding: calc(24px * var(--space-scale, 1)); border-radius: calc(var(--radius) + 8px); background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); box-shadow: var(--shadow); }\n  .hi-hero-note b { font-family: var(--font-heading); font-size: 22px; letter-spacing: -0.02em; line-height: 1.2; display: block; }\n  .hi-hero-note .hi-note-row { display: flex; align-items: center; gap: 10px; font-size: 14px; }\n  .hi-hero-note svg { width: 18px; height: 18px; flex: none; }\n\n  .hi-steps { counter-reset: step; display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(32px * var(--space-scale, 1)); padding: calc(48px * var(--space-scale, 1)) 0 calc(64px * var(--space-scale, 1)); }\n  .hi-step { border-top: 2px solid hsl(var(--foreground)); padding-top: calc(16px * var(--space-scale, 1)); }\n  .hi-step-num { display: block; font-family: var(--font-heading); font-size: 48px; line-height: 1; letter-spacing: -0.04em; color: hsl(var(--primary-text)); margin-bottom: 10px; font-variant-numeric: tabular-nums; }\n  .hi-step p { margin: 8px 0 0; color: hsl(var(--muted-foreground)); font-size: 15px; line-height: 1.6; }\n\n  .hi-info { padding-top: calc(64px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1)); }\n  .hi-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: calc(24px * var(--space-scale, 1)); margin-top: calc(32px * var(--space-scale, 1)); }\n  .hi-panel { background: hsl(var(--card)); border-radius: calc(var(--radius) + 8px); padding: calc(32px * var(--space-scale, 1)); box-shadow: var(--shadow); border: 1px solid hsl(var(--border)); display: flex; flex-direction: column; }\n  .hi-panel-head { display: flex; align-items: center; gap: 12px; }\n  .hi-icon { width: 44px; height: 44px; border-radius: var(--radius); background: hsl(var(--primary) / 0.12); color: hsl(var(--primary-text)); display: grid; place-items: center; flex: none; }\n  .hi-icon svg { width: 20px; height: 20px; }\n  .hi-panel-body { margin: calc(16px * var(--space-scale, 1)) 0 0; font-size: 16px; line-height: 1.7; color: hsl(var(--foreground)); }\n  .hi-panel-empty { margin: calc(16px * var(--space-scale, 1)) 0 0; font-size: 16px; line-height: 1.7; color: hsl(var(--muted-foreground)); font-style: italic; }\n\n  .hi-cta-band { padding-top: calc(64px * var(--space-scale, 1)); padding-bottom: calc(64px * var(--space-scale, 1)); }\n  .hi-cta { display: grid; grid-template-columns: 1fr auto; gap: calc(32px * var(--space-scale, 1)); align-items: center; }\n  .hi-cta h2 { font-family: var(--font-heading); font-size: clamp(28px, 4vw, 44px); line-height: 1.02; letter-spacing: -0.035em; margin: 8px 0 0; }\n  .hi-cta p { margin: 14px 0 0; font-size: 16px; line-height: 1.6; opacity: 0.88; max-width: 32em; }\n\n  .hi-signin { padding-top: calc(64px * var(--space-scale, 1)); padding-bottom: calc(64px * var(--space-scale, 1)); display: grid; justify-items: center; text-align: center; }\n  .hi-signin-inner { max-width: 26em; display: grid; gap: calc(16px * var(--space-scale, 1)); justify-items: center; }\n\n  @media (max-width: 860px) {\n    .hi-hero-grid { grid-template-columns: 1fr; gap: calc(24px * var(--space-scale, 1)); }\n    .hi-steps { grid-template-columns: 1fr; gap: calc(24px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1)); }\n    .hi-info-grid { grid-template-columns: 1fr; }\n    .hi-cta { grid-template-columns: 1fr; }\n    .hi-links { display: none; }\n  }\n</style><main data-screen=\"how-it-works\" data-eid=\"e1\">\n  <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e2\">\n    <div class=\"hi-top\" data-eid=\"e3\">\n      <a class=\"hi-brand\" data-goto=\"home\" data-eid=\"e4\">\n        <span class=\"hi-mark\" aria-hidden=\"true\" data-eid=\"e5\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"9\" cy=\"7\" r=\"3\"></circle><circle cx=\"17\" cy=\"8\" r=\"2.4\"></circle><path d=\"M3.5 20c0-3.6 2.6-6 5.9-6s5.9 2.4 5.9 6\"></path><path d=\"M17 14.4c2.2.3 3.6 2.1 3.6 4.6\"></path></svg></span>\n        Donkey\n      </a>\n      <nav class=\"hi-links ds-only-wide\" aria-label=\"Site pages\" data-eid=\"e6\">\n        <a data-goto=\"home\" data-eid=\"e7\">Home</a>\n        <a data-goto=\"how-it-works\" aria-current=\"page\" data-eid=\"e8\">How it works</a>\n        <a data-goto=\"about\" data-eid=\"e9\">About</a>\n        <a data-goto=\"contact\" data-eid=\"e10\">Contact</a>\n        <a data-goto=\"products\" data-eid=\"e11\">Products</a>\n      </nav>\n      <span class=\"ds-spacer\" data-eid=\"e12\"></span>\n      <div class=\"hi-actions\" data-eid=\"e13\">\n        <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e14\">\n          <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e15\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n          <button aria-label=\"Dark\" data-eid=\"e16\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n          <button aria-label=\"Auto\" data-eid=\"e17\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n        </div>\n        <a class=\"ds-btn ds-btn-ghost ds-only-wide\" data-goto=\"editor-sign-in\" data-eid=\"e18\">Sign in</a>\n        <a class=\"ds-btn ds-btn-sm\" data-goto=\"editor-sign-in\" data-eid=\"e19\">Sign up</a>\n        <details class=\"ds-menu ds-only-narrow\">\n          <summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary>\n          <div class=\"ds-menu-list\" data-eid=\"e20\">\n            <a data-goto=\"home\" data-eid=\"e21\">Home</a>\n            <a data-goto=\"how-it-works\" data-eid=\"e22\">How it works</a>\n            <a data-goto=\"about\" data-eid=\"e23\">About</a>\n            <a data-goto=\"contact\" data-eid=\"e24\">Contact</a>\n            <a data-goto=\"products\" data-eid=\"e25\">Products</a>\n            <a data-goto=\"editor-sign-in\" data-eid=\"e26\">Sign in</a>\n            <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e27\">\n              <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e28\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"></path></svg></button>\n              <button aria-label=\"Dark\" data-eid=\"e29\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n              <button aria-label=\"Auto\" data-eid=\"e30\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4v16\"></path><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n            </div>\n          </div>\n        </details>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ds-page hi-hero\" data-eid=\"e31\">\n    <div class=\"hi-hero-grid\" data-eid=\"e32\">\n      <div data-eid=\"e33\">\n        <span class=\"ds-eyebrow\" data-sample=\"PageWording#how-it-works.\" data-eid=\"e34\">How it works</span>\n        <h1 class=\"ds-h1 hi-display\" data-sample=\"PageWording#how-it-works.heading\" data-eid=\"e35\">From the shop to your door, in three steps.</h1>\n        <p class=\"hi-lead\" data-sample=\"PageWording#how-it-works.intro\" data-eid=\"e36\">Pick what you want, pay at the checkout, and we'll get it to you. Here's what happens along the way.</p>\n      </div>\n      <div class=\"hi-hero-note\" data-eid=\"e37\">\n        <b>Delivery and returns, in plain words.</b>\n        <div class=\"hi-note-row\" data-eid=\"e38\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 7h11v10H3z\"></path><path d=\"M14 10h4l3 3v4h-7z\"></path><circle cx=\"7\" cy=\"18\" r=\"1.6\"></circle><circle cx=\"17\" cy=\"18\" r=\"1.6\"></circle></svg>\n          <span data-eid=\"e39\">Everything you need to know is below.</span>\n        </div>\n        <div class=\"hi-note-row\" data-eid=\"e40\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 12a8 8 0 1 0 16 0 8 8 0 0 0-16 0Z\"></path><path d=\"M9 12h6\"></path></svg>\n          <span data-eid=\"e41\">Questions? Contact us any time.</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e42\">\n    <ol class=\"hi-steps\" data-eid=\"e43\">\n      <li class=\"hi-step\" data-eid=\"e44\">\n        <span class=\"hi-step-num\" aria-hidden=\"true\" data-eid=\"e45\">01</span>\n        <h2 class=\"ds-h3\" data-eid=\"e46\">Pick what you want</h2>\n        <p data-eid=\"e47\">Browse the products page and choose the things you'd like. Prices are in pounds and shown plainly.</p>\n      </li>\n      <li class=\"hi-step\" data-eid=\"e48\">\n        <span class=\"hi-step-num\" aria-hidden=\"true\" data-eid=\"e49\">02</span>\n        <h2 class=\"ds-h3\" data-eid=\"e50\">Pay at the checkout</h2>\n        <p data-eid=\"e51\">Sign up to open the shop, add your items to the basket, and pay once at the end.</p>\n      </li>\n      <li class=\"hi-step\" data-eid=\"e52\">\n        <span class=\"hi-step-num\" aria-hidden=\"true\" data-eid=\"e53\">03</span>\n        <h2 class=\"ds-h3\" data-eid=\"e54\">Get it delivered</h2>\n        <p data-eid=\"e55\">We pack your order and send it out. The delivery section below tells you how long it takes.</p>\n      </li>\n    </ol>\n  </div>\n\n  <div class=\"ds-page hi-info\" data-eid=\"e56\">\n    <span class=\"ds-label-caps\" data-eid=\"e57\">The details</span>\n    <h2 class=\"ds-h2\" style=\"margin-top: 10px; letter-spacing: -0.03em; max-width: 20em\" data-eid=\"e58\">Delivery and returns, kept up to date by our team.</h2>\n    <div class=\"hi-info-grid\" data-eid=\"e59\">\n      <section class=\"hi-panel\" aria-labelledby=\"delivery-title\" data-eid=\"e60\">\n        <div class=\"hi-panel-head\" data-eid=\"e61\">\n          <span class=\"hi-icon\" aria-hidden=\"true\" data-eid=\"e62\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 7h11v10H3z\"></path><path d=\"M14 10h4l3 3v4h-7z\"></path><circle cx=\"7\" cy=\"18\" r=\"1.6\"></circle><circle cx=\"17\" cy=\"18\" r=\"1.6\"></circle></svg></span>\n          <h3 class=\"ds-h3\" id=\"delivery-title\" data-eid=\"e63\">Delivery</h3>\n        </div>\n        <p class=\"hi-panel-body\" data-sample=\"PageWording#how-it-works.deliveryText\" data-eid=\"e64\">Orders arrive in 3 to 5 days. We post everything with a tracked service, Monday to Friday, and you'll get a note when your parcel is on its way. Postage is added at the checkout.</p>\n      </section>\n      <section class=\"hi-panel\" aria-labelledby=\"returns-title\" data-eid=\"e65\">\n        <div class=\"hi-panel-head\" data-eid=\"e66\">\n          <span class=\"hi-icon\" aria-hidden=\"true\" data-eid=\"e67\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 12a8 8 0 1 0 2.4-5.7\"></path><path d=\"M4 4v4h4\"></path></svg></span>\n          <h3 class=\"ds-h3\" id=\"returns-title\" data-eid=\"e68\">Returns</h3>\n        </div>\n        <p class=\"hi-panel-body\" data-sample=\"PageWording#how-it-works.returnsText\" data-eid=\"e69\">Changed your mind? Send anything back within 30 days of it arriving, unused and in its original packaging. Email us with your order number and we'll sort out a refund.</p>\n      </section>\n    </div>\n  </div>\n\n  <section class=\"ds-band-bold hi-cta-band\" data-eid=\"e70\">\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e71\">\n      <div class=\"hi-cta\" data-eid=\"e72\">\n        <div data-eid=\"e73\">\n          <span class=\"ds-label-caps\" style=\"color: inherit; opacity: 0.8\" data-eid=\"e74\">Ready when you are</span>\n          <h2 data-eid=\"e75\">Browse the products, then head into the shop.</h2>\n          <p data-eid=\"e76\">Sign up to open the Donkey shop and place your first order. It only takes a moment.</p>\n        </div>\n        <a class=\"ds-btn ds-btn-lg ds-btn-secondary\" data-goto=\"editor-sign-in\" data-eid=\"e77\">Sign up</a>\n      </div>\n    </div>\n  </section>\n\n  <div data-part=\"footer\" data-eid=\"e78\"></div>\n</main>","changes":[]}