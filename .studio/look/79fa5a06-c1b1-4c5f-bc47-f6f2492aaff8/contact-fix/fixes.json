{"html":"<style>\n  .ct-hero { position: relative; padding-top: calc(32px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1)); }\n  .ct-kicker { display: inline-flex; align-items: center; gap: 8px; }\n  .ct-title { margin: calc(12px * var(--space-scale, 1)) 0 0; font-family: var(--font-heading); font-size: clamp(40px, 7vw, 76px); line-height: 0.95; letter-spacing: -0.04em; font-weight: 700; color: hsl(var(--foreground)); max-width: 14em; }\n  .ct-lead { margin: calc(20px * var(--space-scale, 1)) 0 0; font-size: 18px; line-height: 1.6; color: hsl(var(--muted-foreground)); max-width: 34em; }\n\n  .ct-band { padding-top: calc(48px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1)); }\n  .ct-band .ct-panel { position: relative; }\n  .ct-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(16px * var(--space-scale, 1)); }\n  .ct-card { position: relative; display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1)); padding: calc(24px * var(--space-scale, 1)); border-radius: calc(var(--radius) + 8px); background: hsl(var(--card)); box-shadow: var(--shadow); border: 1px solid hsl(var(--border) / 0.6); text-decoration: none; color: hsl(var(--foreground)); min-height: 100%; }\n  .ct-card:hover { border-color: hsl(var(--primary) / 0.5); }\n  .ct-card-label { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; color: hsl(var(--primary-text)); }\n  .ct-card-value { font-family: var(--font-heading); font-size: clamp(22px, 3vw, 30px); letter-spacing: -0.02em; font-weight: 700; line-height: 1.15; overflow-wrap: anywhere; }\n  .ct-card-note { font-size: 14px; color: hsl(var(--muted-foreground)); }\n  .ct-card-go { margin-top: calc(8px * var(--space-scale, 1)); display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: hsl(var(--primary-text)); min-height: 32px; }\n  .ct-icon { width: 20px; height: 20px; flex: none; }\n  .ct-address { margin-top: calc(16px * var(--space-scale, 1)); padding: calc(24px * var(--space-scale, 1)); border-radius: calc(var(--radius) + 8px); background: hsl(var(--muted)); border: 1px solid hsl(var(--border) / 0.6); }\n  .ct-address p { margin: calc(8px * var(--space-scale, 1)) 0 0; font-size: 16px; line-height: 1.6; }\n  .ct-hint { margin: calc(12px * var(--space-scale, 1)) 0 0; font-size: 15px; color: hsl(var(--muted-foreground)); }\n\n  .ct-help { display: grid; grid-template-columns: 1fr 1fr; gap: calc(32px * var(--space-scale, 1)); padding-top: calc(48px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1)); }\n  .ct-help h2 { margin: 0 0 calc(12px * var(--space-scale, 1)); }\n  .ct-help p { margin: 0 0 calc(12px * var(--space-scale, 1)); font-size: 16px; line-height: 1.65; color: hsl(var(--muted-foreground)); }\n  .ct-help a.ct-inline { color: hsl(var(--primary-text)); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; display: inline-flex; align-items: center; min-height: 40px; }\n\n  .ct-cta { display: grid; grid-template-columns: 1.2fr 1fr; gap: calc(32px * var(--space-scale, 1)); align-items: center; padding-top: calc(48px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1)); position: relative; }\n  .ct-cta h2 { margin: calc(10px * var(--space-scale, 1)) 0 0; color: hsl(var(--band-foreground)); max-width: 16em; }\n  .ct-cta .ct-cta-lead { margin: calc(14px * var(--space-scale, 1)) 0 0; font-size: 16px; line-height: 1.6; color: hsl(var(--band-foreground) / 0.82); }\n  .ct-cta-actions { display: flex; flex-wrap: wrap; gap: calc(12px * var(--space-scale, 1)); align-items: center; }\n  .ct-cta .ds-btn-secondary { color: hsl(var(--band-foreground)); border-color: hsl(var(--band-foreground) / 0.7); }\n  .ct-cta .ds-btn-secondary:hover { background: hsl(var(--band-foreground) / 0.12); }\n\n  @media (max-width: 860px) {\n    .ct-cards { grid-template-columns: 1fr; }\n    .ct-help { grid-template-columns: 1fr; gap: calc(24px * var(--space-scale, 1)); }\n    .ct-cta { grid-template-columns: 1fr; }\n  }\n</style><main data-screen=\"contact\" data-eid=\"e1\">\n  <div data-part=\"header\" data-eid=\"e2\"></div>\n\n  <div class=\"ds-page ct-hero\" data-eid=\"e3\">\n    <span class=\"ds-eyebrow ct-kicker\" data-eid=\"e4\">Contact</span>\n    <h1 class=\"ct-title\" data-eid=\"e5\">Talk to Donkey. We answer.</h1>\n    <p class=\"ct-lead\" data-eid=\"e6\">A question about a product, an order on its way, or sending something back? Reach us by email or phone and a real person replies.</p>\n  </div>\n\n  <section class=\"ds-band ds-band-bold ct-band\" data-eid=\"e7\">\n    <div class=\"ds-page\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e8\">\n      <div class=\"ct-panel\" data-eid=\"e9\">\n        <div class=\"ct-cards\" data-eid=\"e10\">\n          <a class=\"ct-card\" href=\"#\" data-eid=\"email-card\">\n            <span class=\"ct-card-label\" data-eid=\"e11\">Email us</span>\n            <span class=\"ct-card-value\" data-sample=\"PageWording#contact.email\" data-eid=\"e12\">hello@donkey.example</span>\n            <span class=\"ct-card-note\" data-eid=\"e13\">Best for orders, returns and anything with a photo.</span>\n            <span class=\"ct-card-go\" data-eid=\"e14\">\n              <svg class=\"ct-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"></rect><path d=\"m3 7 9 6 9-6\"></path></svg>\n              Write to us\n            </span>\n          </a>\n          <a class=\"ct-card\" href=\"#\" data-eid=\"phone-card\">\n            <span class=\"ct-card-label\" data-eid=\"e15\">Call us</span>\n            <span class=\"ct-card-value\" data-sample=\"PageWording#contact.phone\" data-eid=\"e16\">01234 567890</span>\n            <span class=\"ct-card-note\" data-eid=\"e17\">Monday to Friday, 9am to 5pm.</span>\n            <span class=\"ct-card-go\" data-eid=\"e18\">\n              <svg class=\"ct-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z\"></path></svg>\n              Call us\n            </span>\n          </a>\n        </div>\n\n        <div class=\"ct-address\" data-eid=\"address-block\">\n          <span class=\"ct-card-label\" data-eid=\"e19\">Find us</span>\n          <p data-sample=\"PageWording#contact.address\" data-eid=\"e20\">Donkey, 14 Mill Lane, Bristol BS1 4TR</p>\n        </div>\n\n        <p class=\"ct-hint\" data-eid=\"e21\">Shoppers order through Donkey app. Use Sign up in the top bar to get in and start.</p>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"ds-page ct-help\" data-eid=\"e22\">\n    <div data-eid=\"e23\">\n      <h2 class=\"ds-h2\" data-eid=\"e24\">Before you write</h2>\n      <p data-eid=\"e25\">Most answers are already here. How buying works covers delivery times and what to do if something isn't right.</p>\n      <a class=\"ct-inline\" data-goto=\"how-it-works\" data-eid=\"e26\">Read How it works\n        <svg class=\"ct-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg>\n      </a>\n    </div>\n    <div data-eid=\"e27\">\n      <h2 class=\"ds-h2\" data-eid=\"e28\">Something from the shop</h2>\n      <p data-eid=\"e29\">Have your order in front of you when you call. We can find it faster with the name on it and the date it came.</p>\n      <a class=\"ct-inline\" data-goto=\"products\" data-eid=\"e30\">Browse Products\n        <svg class=\"ct-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg>\n      </a>\n    </div>\n  </div>\n\n  <section class=\"ds-band ds-band-bold ct-band\" data-eid=\"e31\">\n    <div class=\"ds-page ct-cta\" style=\"padding-top: 0; padding-bottom: 0\" data-eid=\"e32\">\n      <div data-eid=\"e33\">\n        <span class=\"ds-eyebrow\" style=\"color: hsl(var(--band-foreground) / 0.8)\" data-eid=\"e34\">Ready when you are</span>\n        <h2 class=\"ds-h1\" data-eid=\"e35\">Have a look at the shop.</h2>\n        <p class=\"ct-cta-lead\" data-eid=\"e36\">Everything Donkey sells, with prices in pounds. No account needed to browse.</p>\n      </div>\n      <div class=\"ct-cta-actions\" data-eid=\"e37\">\n        <a class=\"ds-btn ds-btn-lg\" data-goto=\"products\" data-eid=\"e38\">See the products</a>\n        <a class=\"ds-btn ds-btn-secondary ds-btn-lg\" data-goto=\"how-it-works\" data-eid=\"e39\">How buying works</a>\n      </div>\n    </div>\n  </section>\n\n  <div data-part=\"footer\" data-eid=\"e40\"></div>\n\n  <section data-state=\"empty\" hidden=\"\" data-replaces=\"content\" data-eid=\"e41\">\n    <div class=\"ds-page ct-hero\" data-eid=\"e42\">\n      <span class=\"ds-eyebrow\" data-eid=\"e43\">Contact</span>\n      <h1 class=\"ct-title\" data-eid=\"e44\">Talk to Donkey. We answer.</h1>\n      <p class=\"ct-lead\" data-eid=\"e45\">A question about a product, an order on its way, or sending something back?</p>\n    </div>\n    <div class=\"ds-page\" style=\"padding-bottom: calc(64px * var(--space-scale, 1))\" data-eid=\"e46\">\n      <div class=\"ds-empty\" data-eid=\"e47\">\n        <div class=\"ds-empty-icon\" data-eid=\"e48\">\n          <svg class=\"ct-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"></rect><path d=\"m3 7 9 6 9-6\"></path></svg>\n        </div>\n        <p class=\"ds-text\" data-eid=\"e49\">Contact details are on their way. Check back soon.</p>\n        <div class=\"ds-row\" style=\"justify-content: center\" data-eid=\"e50\">\n          <a class=\"ds-btn ds-btn-secondary\" data-goto=\"home\" data-eid=\"e51\">Go to the home page</a>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>","changes":[]}